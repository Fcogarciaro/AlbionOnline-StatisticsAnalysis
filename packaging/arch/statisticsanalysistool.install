# File capabilities live on the inode, so every upgrade (new file) needs them again.
_grant_capture_capability() {
  if command -v setcap >/dev/null 2>&1; then
    setcap cap_net_raw,cap_net_admin=eip /opt/statisticsanalysistool/StatisticsAnalysisTool \
      || echo "warning: setcap failed; run: sudo setcap cap_net_raw,cap_net_admin=eip /opt/statisticsanalysistool/StatisticsAnalysisTool"
  else
    echo "warning: setcap not found (install libcap); packet capture needs: sudo setcap cap_net_raw,cap_net_admin=eip /opt/statisticsanalysistool/StatisticsAnalysisTool"
  fi
}

post_install() {
  _grant_capture_capability
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q 2>/dev/null || true
}

post_upgrade() {
  post_install
}

post_remove() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q 2>/dev/null || true
}
