# Maintainer: Fcogarciaro
# Builds the Linux (Avalonia) port from the source tag `linux-v$pkgver` of the fork.
pkgname=statisticsanalysistool
pkgver=0.1.0
pkgrel=1
pkgdesc='Albion Online Statistics Analysis Tool (Linux port): damage meter, loot, market and dungeon tracking from network traffic'
arch=('x86_64')
url='https://github.com/Fcogarciaro/AlbionOnline-StatisticsAnalysis'
license=('GPL-3.0-only')
depends=('libpcap' 'fontconfig' 'libx11' 'libice' 'libsm')
makedepends=('dotnet-sdk')
optdepends=(
  'pipewire: alert sounds through pw-play'
  'libpulse: alert sounds through paplay'
  'libnotify: desktop notifications through notify-send'
  'xdg-utils: open links and folders from the tool'
  'wmctrl: ask the window manager for attention on X11 when an alert fires'
)
install="$pkgname.install"
# The self-contained .NET output must not be stripped, and it carries no useful debug symbols for makepkg.
options=('!strip' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/linux-v$pkgver.tar.gz")
# Replace with the real checksum once the tag exists (`updpkgsums`); SKIP is only acceptable for local testing.
sha256sums=('SKIP')

build() {
  cd "AlbionOnline-StatisticsAnalysis-linux-v$pkgver"
  export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
  # NuGet restore needs network access during build().
  dotnet publish src/StatisticsAnalysisTool.Avalonia/StatisticsAnalysisTool.Avalonia.csproj \
    -c Release -r linux-x64 --self-contained true \
    -p:Version="$pkgver" -p:DebugType=none -p:DebugSymbols=false \
    -o "$srcdir/publish" --nologo
}

package() {
  cd "AlbionOnline-StatisticsAnalysis-linux-v$pkgver"

  install -d "$pkgdir/opt/$pkgname" "$pkgdir/usr/bin"
  cp -a "$srcdir/publish/." "$pkgdir/opt/$pkgname/"
  ln -s "/opt/$pkgname/StatisticsAnalysisTool" "$pkgdir/usr/bin/$pkgname"

  install -Dm644 packaging/linux/statisticsanalysistool.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"
  for size in 256x256 128x128 64x64; do
    install -Dm644 "packaging/linux/icons/hicolor/$size/apps/$pkgname.png" "$pkgdir/usr/share/icons/hicolor/$size/apps/$pkgname.png"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/StatisticsAnalysisTool.Avalonia/Assets/Fonts/FontAwesome-LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/FontAwesome-LICENSE.txt"
  install -Dm644 src/StatisticsAnalysisTool.Avalonia/Assets/GameIcons-NOTICE.txt "$pkgdir/usr/share/licenses/$pkgname/GameIcons-NOTICE.txt"
  install -Dm644 README-linux.md "$pkgdir/usr/share/doc/$pkgname/README-linux.md"
}
