    <DataTemplate x:Key="LocationFilterObjectTemplate" DataType="models:MainTabLocationFilterObject">
      <StackPanel Orientation="Horizontal">
        <CheckBox IsChecked="{Binding IsChecked}" Width="20" VerticalAlignment="Top" />
        <TextBlock Text="{Binding Name}" Width="100" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
    <ControlTheme x:Key="ItemDetails.Information.Card" TargetType="Border">
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Background.3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Background.4}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </ControlTheme>
    <ControlTheme x:Key="ItemDetails.Information.CardHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Text.1}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </ControlTheme>
    <ControlTheme x:Key="ItemDetails.Information.GroupHeader" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,9,0,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Text.2}" />
    </ControlTheme>
    <ControlTheme x:Key="ItemDetails.Information.StatBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Accent.Green.4}" />
      <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Background.4}" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <DataTemplate x:Key="ItemDetails.Information.StatTemplate" DataType="itemDetailsModels:ItemStat">
      <Border Height="38" BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" MinWidth="90" />
          </Grid.ColumnDefinitions>
          <fa:FontAwesomeImage Icon="{Binding Icon}"
                               Width="15"
                               Height="15"
                               Foreground="{DynamicResource SolidColorBrush.Text.3}"
                               VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{Binding Name}"
                     Foreground="{DynamicResource SolidColorBrush.Text.2}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2"
                     Margin="8,0,12,0"
                     Text="{Binding ValueText}"
                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                     TextAlignment="Right"
                     VerticalAlignment="Center" />
          <ProgressBar Grid.Column="3"
                       Maximum="{Binding Maximum, Mode=OneWay}"
                       Value="{Binding Value, Mode=OneWay}"
                       Theme="{StaticResource ItemDetails.Information.StatBar}"
                       VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ItemDetails.Information.SpellTemplate" DataType="itemDetailsModels:ItemSpellInformation">
      <Border Width="154"
              MinHeight="112"
              Margin="0,0,8,8"
              Padding="8"
              Background="{DynamicResource SolidColorBrush.Background.2}"
              BorderBrush="{DynamicResource SolidColorBrush.Background.4}"
              BorderThickness="1"
              CornerRadius="4">
        <ToolTip.Tip>
          <ContentControl Content="{Binding}"
                          ContentTemplate="{StaticResource Spell.ToolTipContentTemplate}"
                          DataContext="{Binding PlacementTarget?.DataContext, RelativeSource={RelativeSource Self}}" />
        </ToolTip.Tip>
        <StackPanel>
          <Image Source="{Binding Icon}" Width="64" Height="64" HorizontalAlignment="Center" />
          <TextBlock Margin="2,4,2,0"
                     Text="{Binding Name}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Styles.Resources>
</Styles>
