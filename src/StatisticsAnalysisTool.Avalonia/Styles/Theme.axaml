<!-- Entry point of the shared theme: merged once in App.axaml (and in the headless TestApp). Feature dictionaries
     (Dungeon, Trade, Dashboard, ...) are NOT here; each is added with the views that use it. See PORTING.md. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://StatisticsAnalysisTool/Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <StyleInclude Source="avares://StatisticsAnalysisTool/Styles/MainStyles.axaml" />
  <StyleInclude Source="avares://StatisticsAnalysisTool/Styles/HintBarStyles.axaml" />
  <StyleInclude Source="avares://StatisticsAnalysisTool/Styles/InfoWindowStyles.axaml" />
  <StyleInclude Source="avares://StatisticsAnalysisTool/Styles/SpellStyles.axaml" />
  <StyleInclude Source="avares://StatisticsAnalysisTool/Styles/FontAwesomeStyles.axaml" />
</Styles>
