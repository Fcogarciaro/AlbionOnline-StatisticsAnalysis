          <ProgressBar common:ProgressBarSmoother.SmoothValue="{Binding HealInPercent}"
                       Minimum="0"
                       Maximum="100"
                       Height="2"
                       Margin="3,0,2,2"
                       VerticalAlignment="Bottom"
                       Background="{DynamicResource SolidColorBrush.Transparent}"
