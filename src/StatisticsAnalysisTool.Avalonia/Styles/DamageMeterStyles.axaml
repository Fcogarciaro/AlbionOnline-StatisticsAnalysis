            <TextBlock Foreground="{DynamicResource SolidColorBrush.Weapon.Text}"
                       VerticalAlignment="Top"
                       MinWidth="75"
                       MaxWidth="100"
                       FontWeight="Bold"
                       Margin="10,10,50,0">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0:00}:{1:00}:{2:00}">
                  <Binding Path="CombatTime.Hours" />
                  <Binding Path="CombatTime.Minutes" />
                  <Binding Path="CombatTime.Seconds" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
        </Grid>
        <Grid MinHeight="42"
              IsVisible="{Binding DamageMeterStyleFragmentType, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Heal=True|*=False'}">
          <ProgressBar common:ProgressBarSmoother.SmoothValue="{Binding HealInPercent}"
                       Minimum="0"
                       Maximum="100"
                       Height="40"
                       Margin="3,1,2,1"
                       VerticalAlignment="Top"
                       Background="{DynamicResource SolidColorBrush.Transparent}"
                       BorderThickness="0"
                       Theme="{StaticResource DamageMeter.ProgressBar.Colors}" />
          <StackPanel Orientation="Horizontal">
            <Grid Margin="10,0, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Top">
              <Image Source="{Binding CauserMainHand?.Icon}" Theme="{StaticResource DamageMeter.Icon}" />
            </Grid>
            <StackPanel Orientation="Vertical" Margin="10,0" MinWidth="55" VerticalAlignment="Top" Height="40">
              <Label Foreground="{DynamicResource SolidColorBrush.Weapon.Text}"
                     Content="{Binding HealPercentage, StringFormat={}{0:N2}%}"
                     Margin="0,5,0,0"
                     Padding="0"
                     HorizontalContentAlignment="Right"
                     VerticalAlignment="Top" />
              <Label Foreground="{DynamicResource SolidColorBrush.Weapon.Text}"
                     Opacity="0.50"
                     Content="{Binding OverhealedPercentageOfTotalHealing, StringFormat={}{0:N2}%}"
                     Margin="0,-15,0,0"
                     Padding="0,0"
                     HorizontalContentAlignment="Right"
                     VerticalAlignment="Top"
                     VerticalContentAlignment="Top" />
            </StackPanel>
            <Label Content="{Binding Name}" MinWidth="125" MaxWidth="125" Margin="10,5, 0, 0" VerticalAlignment="Top" />
            <Label Foreground="{DynamicResource SolidColorBrush.Weapon.Text}"
                   Content="{Binding HealShortString}"
                   MinWidth="100"
                   MaxWidth="100"
                   FontWeight="Bold"
                   Margin="10,5, 5, 0"
                   VerticalAlignment="Top" />
            <Label Foreground="{DynamicResource SolidColorBrush.Weapon.Text}"
                   Content="{Binding HpsString, StringFormat={}{0:N0}/hps}"
                   MinWidth="75"
                   MaxWidth="75"
                   FontWeight="Bold"
                   Margin="10,5, 50, 0"
                   VerticalAlignment="Top" />
            <Grid Width="16"
                  Height="16"
                  Margin="0,10"
                  VerticalAlignment="Top"
                  ToolTip.Tip="{Binding TranslationCombatTime, FallbackValue='COMBAT_TIME'}">
              <fa:FontAwesomeImage Icon="RegularClock" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
            </Grid>
            <TextBlock Foreground="{DynamicResource SolidColorBrush.Weapon.Text}" MinWidth="75" MaxWidth="100" FontWeight="Bold" Margin="10,13,50,0">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0:00}:{1:00}:{2:00}">
                  <Binding Path="CombatTime.Hours" />
                  <Binding Path="CombatTime.Minutes" />
                  <Binding Path="CombatTime.Seconds" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
        </Grid>
        <Grid Margin="10,41,0,3"
              VerticalAlignment="Top"
              HorizontalAlignment="Stretch"
              IsVisible="{Binding SpellsContainerVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
          <StackPanel Orientation="Horizontal"
                      Height="24"
                      HorizontalAlignment="Stretch"
                      Margin="2,0,2,0"
                      VerticalAlignment="Top"
                      Background="{DynamicResource SolidColorBrush.Accent.Blue.Transparent.5}">
            <Label Content="" Width="96" />
            <Label Content="{Binding TranslationName}" FontWeight="Bold" Width="244" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
            <Label Content="{Binding TranslationDmgPercent}" FontWeight="Bold" Width="64" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
            <Label Content="{Binding TranslationDamageHeal}" FontWeight="Bold" Width="84" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
            <Label Content="{Binding TranslationTicks}" FontWeight="Bold" Width="70" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Margin="0,25,0,0">
            <ItemsControl ItemsSource="{Binding Spells}" ItemTemplate="{StaticResource SpellBarTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </DataTemplate>
  </Styles.Resources>
</Styles>
