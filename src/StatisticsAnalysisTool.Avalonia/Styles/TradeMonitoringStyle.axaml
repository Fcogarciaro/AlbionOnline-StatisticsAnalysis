                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding TranslationCostPerItem}" Width="160" Foreground="{DynamicResource SolidColorBrush.Text.4}" />
                  <TextBlock Text="{Binding TranslationTotalRevenue, FallbackValue=TOTAL_REVENUE}"
                             Width="160"
                             Foreground="{DynamicResource SolidColorBrush.Text.4}" />
                  <TextBlock Width="110" Foreground="{DynamicResource SolidColorBrush.Text.4}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} ({1}%)">
                        <Binding Path="TranslationTax" />
                        <Binding Path="InstantBuySellContent.TaxRate" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
                <TextBlock Theme="{StaticResource Trade.City.Text}" />
              </DockPanel>
