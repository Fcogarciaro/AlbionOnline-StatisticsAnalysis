    <DataTemplate x:Key="PlayerTradeTemplate" DataType="trade:Trade">
      <Grid Height="50">
        <Grid Theme="{StaticResource PlayerTrade.Type.Colors}" />
        <Border Theme="{StaticResource Container.Border}">
          <DockPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="5,0,10,0">
            <Grid Margin="0,0, 5, 0" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Source="{Binding Item?.Icon, Mode=OneWay}"
                     Theme="{StaticResource Trade.Icon}"
                     IsVisible="{Binding PlayerTradeContent?.ItemIconVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}" />
              <Image Source="avares://StatisticsAnalysisTool/Resources/silver.png"
                     Theme="{StaticResource Trade.Icon}"
                     IsVisible="{Binding PlayerTradeContent?.SilverIconVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}" />
            </Grid>
            <StackPanel Orientation="Vertical">
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding PlayerTradeContent?.DirectionText, StringFormat='{}{0}: ', FallbackValue=TRADE}"
                             Theme="{StaticResource PlayerTrade.Text.Color}" />
                  <StackPanel Orientation="Horizontal"
                              IsVisible="{Binding PlayerTradeContent?.ItemIconVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                    <TextBlock Text="{Binding PlayerTradeContent?.QuantityText}"
                               FontWeight="Bold"
                               Margin="0,0,3,0"
                               Theme="{StaticResource PlayerTrade.Text.Color}" />
                    <TextBlock Theme="{StaticResource Trade.Text.Tier}" />
                    <TextBlock Text="{Binding Item?.LocalizedName}" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                  </StackPanel>
                  <TextBlock Text="{Binding TranslationSilver}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             IsVisible="{Binding PlayerTradeContent?.SilverIconVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}" />
                </StackPanel>
                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0}'}"
                           TextAlignment="Right"
                           Foreground="{DynamicResource SolidColorBrush.Text.1}" />
              </DockPanel>
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding PlayerTradeContent?.PartnerDirectionText, StringFormat='{}{0} ', FallbackValue=FROM}"
                             Foreground="{DynamicResource SolidColorBrush.Text.4}" />
                  <TextBlock Text="{Binding PlayerTradeContent?.PartnerName}" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
                </StackPanel>
                <TextBlock Theme="{StaticResource Trade.City.Text}" />
              </DockPanel>
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <StackPanel Orientation="Horizontal"
                              IsVisible="{Binding PlayerTradeContent?.SilverIconVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding PlayerTradeContent?.SilverText}" Theme="{StaticResource PlayerTrade.Text.Color}" />
                  </StackPanel>
                </StackPanel>
                <Grid Margin="0 -2 0 0" Height="18" Width="18" HorizontalAlignment="Right">
                  <CheckBox IsChecked="{Binding IsSelectedForDeletion, FallbackValue=false}" ToolTip.Tip="{Binding TranslationSelectToDelete}" />
                </Grid>
              </DockPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </DataTemplate>
