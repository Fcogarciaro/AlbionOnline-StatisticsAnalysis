                      <ToolTip.Tip>
                        <TextBlock>
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}: {1:N0}">
                              <Binding Path="TranslationTotalPriceWithDeductedTaxes" />
                              <Binding Path="MailContent.TotalPrice.DoubleValue" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </ToolTip.Tip>
                    </TextBlock>
                  </Grid>
                </StackPanel>
                <Grid Margin="0 -2 0 0" Height="18" Width="18" HorizontalAlignment="Right">
                  <CheckBox IsChecked="{Binding IsSelectedForDeletion, FallbackValue=false}" ToolTip.Tip="{Binding TranslationSelectToDelete}" />
                </Grid>
              </DockPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
