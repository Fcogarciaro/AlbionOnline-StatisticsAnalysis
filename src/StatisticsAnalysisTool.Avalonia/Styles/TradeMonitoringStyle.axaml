<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:StatisticsAnalysisTool.Common"
        xmlns:models="clr-namespace:StatisticsAnalysisTool.Models"
        xmlns:trade="clr-namespace:StatisticsAnalysisTool.Trade"
        xmlns:gl="clr-namespace:System.Globalization;assembly=System.Runtime"
        xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
        xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
        x:CompileBindings="False">
  <Styles.Resources>
    <ControlTheme x:Key="Trade.Icon" TargetType="Image">
      <Setter Property="Height" Value="50" />
      <Setter Property="Width" Value="50" />
    </ControlTheme>
    <ControlTheme x:Key="Trade.City.Text" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Text" Value="{Binding LocationName}" />
      <Setter Property="Foreground"
              Value="{Binding Location, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='CaerleonMarket=@SolidColorBrush.City.Caerleon|ThetfordMarket=@SolidColorBrush.City.Thetford|ThetfordPortal=@SolidColorBrush.City.Thetford|BridgewatchMarket=@SolidColorBrush.City.Bridgewatch|BridgewatchPortal=@SolidColorBrush.City.Bridgewatch|MartlockMarket=@SolidColorBrush.City.Martlock|MartlockPortal=@SolidColorBrush.City.Martlock|LymhurstMarket=@SolidColorBrush.City.Lymhurst|LymhurstPortal=@SolidColorBrush.City.Lymhurst|FortSterlingMarket=@SolidColorBrush.City.FortSterling|FortSterlingPortal=@SolidColorBrush.City.FortSterling|BrecilienMarket=@SolidColorBrush.City.Brecilien|ArthursRest=@SolidColorBrush.City.ArthursRest|MerlynsRest=@SolidColorBrush.City.MerlynsRest|MorganasRest=@SolidColorBrush.City.MorganasRest|BlackMarket=@SolidColorBrush.City.BlackMarket|SmugglersDen=@SolidColorBrush.City.SmugglersDen|*=@SolidColorBrush.City.Default'}" />
    </ControlTheme>
    <ControlTheme x:Key="Mail.Type.Colors" TargetType="Grid">
      <Setter Property="Width" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background"
              Value="{Binding MailType, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='MarketplaceSellOrderFinished=@SolidColorBrush.Accent.Green.3|MarketplaceBuyOrderFinished=@SolidColorBrush.Accent.Red.3|MarketplaceSellOrderExpired=@SolidColorBrush.Accent.Green.6|MarketplaceBuyOrderExpired=@SolidColorBrush.Accent.Red.6|*=@SolidColorBrush.Text.4'}" />
    </ControlTheme>
    <ControlTheme x:Key="Mail.Text.Colors" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground"
              Value="{Binding MailType, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='MarketplaceSellOrderFinished=@SolidColorBrush.Accent.Green.3|MarketplaceBuyOrderFinished=@SolidColorBrush.Accent.Red.3|MarketplaceSellOrderExpired=@SolidColorBrush.Accent.Green.6|MarketplaceBuyOrderExpired=@SolidColorBrush.Accent.Red.6|*=@SolidColorBrush.Text.4'}" />
    </ControlTheme>
    <ControlTheme x:Key="InstantSell.Type.Colors" TargetType="Grid">
      <Setter Property="Width" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Accent.Green.3}" />
    </ControlTheme>
    <ControlTheme x:Key="InstantBuy.Type.Colors" TargetType="Grid">
      <Setter Property="Width" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Accent.Red.3}" />
    </ControlTheme>
    <ControlTheme x:Key="Instant.Text.Color.Green" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Accent.Green.3}" />
    </ControlTheme>
    <ControlTheme x:Key="Instant.Text.Color.Red" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Accent.Red.3}" />
    </ControlTheme>
    <ControlTheme x:Key="Trade.Text.Tier" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Text.1}" />
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="Text" Value="{Binding DisplayItemTier, StringFormat='{}{0}', FallbackValue='T?'}" />
    </ControlTheme>
    <ControlTheme x:Key="Crafting.Type.Colors" TargetType="Grid">
      <Setter Property="Width" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Accent.Orange.3}" />
    </ControlTheme>
    <ControlTheme x:Key="Crafting.Text.Color.Orange" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Accent.Orange.3}" />
    </ControlTheme>
    <ControlTheme x:Key="PlayerTrade.Type.Colors" TargetType="Grid">
      <Setter Property="Width" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background"
              Value="{Binding Type, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='PlayerTradeOutgoing=@SolidColorBrush.Accent.Red.3|*=@SolidColorBrush.Accent.Green.3'}" />
    </ControlTheme>
    <ControlTheme x:Key="PlayerTrade.Text.Color" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground"
              Value="{Binding Type, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='PlayerTradeOutgoing=@SolidColorBrush.Accent.Red.3|*=@SolidColorBrush.Accent.Green.3'}" />
    </ControlTheme>
    <ControlTheme x:Key="Trade.Silver.Image.Style" TargetType="Image">
      <Setter Property="Source" Value="avares://StatisticsAnalysisTool/Resources/silver.png" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="5,0,5,0" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </ControlTheme>
    <ControlTheme x:Key="Trade.Statistics.SummaryCard" TargetType="Border" BasedOn="{StaticResource Dashboard.Card}">
      <Setter Property="Height" Value="90" />
      <Setter Property="Margin" Value="6,0,6,0" />
      <Setter Property="Padding" Value="8,8" />
    </ControlTheme>
    <ControlTheme x:Key="Trade.Statistics.SummaryValue" TargetType="TextBlock" BasedOn="{StaticResource Dashboard.SummaryValue}">
      <Setter Property="FontSize" Value="23" />
      <Setter Property="Margin" Value="0,1,0,2" />
    </ControlTheme>
    <ControlTheme x:Key="Trade.Statistics.DeltaText" TargetType="TextBlock" BasedOn="{StaticResource Dashboard.SummaryDeltaText}">
      <Setter Property="ToolTip.Tip" Value="{x:Null}" />
      <Setter Property="FontSize" Value="11" />
    </ControlTheme>
    <ControlTheme x:Key="Trade.Statistics.ColumnHeader" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Text.2}" />
    </ControlTheme>
    <ControlTheme x:Key="Trade.Statistics.RowLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{Binding IsTotal, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=14'}" />
      <Setter Property="FontWeight"
              Value="{Binding IsTotal, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=SemiBold'}" />
      <Setter Property="Foreground"
              Value="{Binding IsTotal, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=@SolidColorBrush.Text.1|*=@SolidColorBrush.Text.2'}" />
    </ControlTheme>
    <ControlTheme x:Key="Trade.Statistics.RowValue" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{Binding IsTotal, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=14|*=12'}" />
      <Setter Property="FontWeight"
              Value="{Binding IsTotal, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=SemiBold'}" />
    </ControlTheme>
    <DataTemplate x:Key="Trade.Statistics.SummaryMetricTemplate" DataType="models:DashboardSummaryMetric">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                     Text="{Binding Value, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=0}"
                     Theme="{StaticResource Trade.Statistics.SummaryValue}" />
          <Image Width="17" Height="17" Margin="6,1,0,0" VerticalAlignment="Center" Source="avares://StatisticsAnalysisTool/Resources/silver.png" />
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    ToolTip.Tip="{Binding DataContext?.TranslationPreviousPeriod, RelativeSource={RelativeSource AncestorType=ContentControl}, FallbackValue=VS_PREVIOUS_PERIOD}">
          <TextBlock Text="{Binding ChangeIndicator}" Theme="{StaticResource Trade.Statistics.DeltaText}" />
          <TextBlock Margin="4,0,0,0" Text="{Binding ChangePercentageText}" Theme="{StaticResource Trade.Statistics.DeltaText}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="MailStatsObjectTemplate" DataType="trade:TradeStatsObject">
      <StackPanel>
        <UniformGrid Columns="4">
          <Border Theme="{StaticResource Trade.Statistics.SummaryCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="48" Height="48" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource SolidColorBrush.Accent.Green.3}"
                         Opacity="0.08"
                         Stroke="{DynamicResource SolidColorBrush.Accent.Green.3}"
                         StrokeThickness="1" />
                <fa:FontAwesomeImage Width="21"
                                     Height="21"
                                     Icon="SolidHandHoldingDollar"
                                     Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}" />
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding TranslationTotalSales, FallbackValue=TOTAL_SALES}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                <ContentControl Content="{Binding TotalSalesSummary}"
                                ContentTemplate="{StaticResource Trade.Statistics.SummaryMetricTemplate}"
                                Foreground="{DynamicResource SolidColorBrush.Accent.Green.1}"
                                HorizontalContentAlignment="Stretch" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Theme="{StaticResource Trade.Statistics.SummaryCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="48" Height="48" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource SolidColorBrush.Accent.Red.3}"
                         Opacity="0.08"
                         Stroke="{DynamicResource SolidColorBrush.Accent.Red.3}"
                         StrokeThickness="1" />
                <fa:FontAwesomeImage Width="21" Height="21" Icon="SolidCartShopping" Foreground="{DynamicResource SolidColorBrush.Accent.Red.3}" />
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding TranslationTotalPurchases, FallbackValue=TOTAL_PURCHASES}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                <ContentControl Content="{Binding TotalPurchasesSummary}"
                                ContentTemplate="{StaticResource Trade.Statistics.SummaryMetricTemplate}"
                                Foreground="{DynamicResource SolidColorBrush.Accent.Red.1}"
                                HorizontalContentAlignment="Stretch" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Theme="{StaticResource Trade.Statistics.SummaryCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="48" Height="48" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource SolidColorBrush.Accent.Blue.3}"
                         Opacity="0.08"
                         Stroke="{DynamicResource SolidColorBrush.Accent.Blue.3}"
                         StrokeThickness="1" />
                <fa:FontAwesomeImage Width="21" Height="21" Icon="SolidRightLeft" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding TranslationTradeVolume, FallbackValue=TRADE_VOLUME}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                <ContentControl Content="{Binding TradeVolumeSummary}"
                                ContentTemplate="{StaticResource Trade.Statistics.SummaryMetricTemplate}"
                                Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}"
                                HorizontalContentAlignment="Stretch" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Margin="0" Theme="{StaticResource Trade.Statistics.SummaryCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="48" Height="48" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource SolidColorBrush.Accent.Green.3}"
                         Opacity="0.08"
                         Stroke="{DynamicResource SolidColorBrush.Accent.Green.3}"
                         StrokeThickness="1" />
                <fa:FontAwesomeImage Width="21" Height="21" Icon="SolidChartLine" Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}" />
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding TranslationProfit, FallbackValue=PROFIT}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                <ContentControl Content="{Binding ProfitSummary}"
                                ContentTemplate="{StaticResource Trade.Statistics.SummaryMetricTemplate}"
                                HorizontalContentAlignment="Stretch"
                                Foreground="{Binding ProfitSummary?.IsValueNegative, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=@SolidColorBrush.Accent.Red.1|*=@SolidColorBrush.Accent.Green.1'}" />
              </StackPanel>
            </Grid>
          </Border>
        </UniformGrid>
        <Border Margin="0,8,0,0" Theme="{StaticResource Dashboard.Section}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="44" />
              <RowDefinition Height="36" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Border Padding="14,0" BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,0,0,1">
              <TextBlock Text="{Binding TranslationTradeStatistics, FallbackValue=TRADE_STATISTICS}" Theme="{StaticResource Dashboard.SectionTitle}" />
            </Border>
            <Border Grid.Row="1"
                    Padding="14,0"
                    Background="{DynamicResource SolidColorBrush.Background.3}"
                    BorderBrush="{DynamicResource SolidColorBrush.Background.4}"
                    BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="185" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock />
                <StackPanel Grid.Column="1" Margin="0,0,18,0" HorizontalAlignment="Right" Orientation="Horizontal">
                  <TextBlock Text="{Binding TranslationSold, FallbackValue=SOLD}" Theme="{StaticResource Trade.Statistics.ColumnHeader}" />
                  <Image Width="14" Height="14" Margin="5,0,0,0" Source="avares://StatisticsAnalysisTool/Resources/silver.png" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,18,0" HorizontalAlignment="Right" Orientation="Horizontal">
                  <TextBlock Text="{Binding TranslationBought, FallbackValue=BOUGHT}" Theme="{StaticResource Trade.Statistics.ColumnHeader}" />
                  <Image Width="14" Height="14" Margin="5,0,0,0" Source="avares://StatisticsAnalysisTool/Resources/silver.png" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,18,0" HorizontalAlignment="Right" Orientation="Horizontal">
                  <TextBlock Text="{Binding TranslationTax, FallbackValue=TAX}" Theme="{StaticResource Trade.Statistics.ColumnHeader}" />
                  <Image Width="14" Height="14" Margin="5,0,0,0" Source="avares://StatisticsAnalysisTool/Resources/silver.png" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,18,0" HorizontalAlignment="Right" Orientation="Horizontal">
                  <TextBlock Text="{Binding TranslationNetProfit, FallbackValue=NET_PROFIT}" Theme="{StaticResource Trade.Statistics.ColumnHeader}" />
                  <Image Width="14" Height="14" Margin="5,0,0,0" Source="avares://StatisticsAnalysisTool/Resources/silver.png" />
                </StackPanel>
              </Grid>
            </Border>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding PeriodStatistics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="trade:TradePeriodStatisticsEntry">
                  <Border Padding="14,0"
                          BorderBrush="{DynamicResource SolidColorBrush.Background.4}"
                          BorderThickness="0,0,0,1"
                          Height="{Binding IsTotal, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=39|*=34'}"
                          Background="{Binding IsTotal, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=@SolidColorBrush.Background.3'}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="185" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Theme="{StaticResource Trade.Statistics.RowLabel}" />
                      <TextBlock Grid.Column="1"
                                 Margin="0,0,18,0"
                                 Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}"
                                 Text="{Binding Sold, StringFormat='{}{0:N0}', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                 Theme="{StaticResource Trade.Statistics.RowValue}" />
                      <TextBlock Grid.Column="2"
                                 Margin="0,0,18,0"
                                 Foreground="{DynamicResource SolidColorBrush.Accent.Red.3}"
                                 Text="{Binding Bought, StringFormat='{}{0:N0}', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                 Theme="{StaticResource Trade.Statistics.RowValue}" />
                      <TextBlock Grid.Column="3"
                                 Margin="0,0,18,0"
                                 Foreground="{DynamicResource SolidColorBrush.Accent.Red.3}"
                                 Text="{Binding Tax, StringFormat='{}{0:N0}', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                 Theme="{StaticResource Trade.Statistics.RowValue}" />
                      <TextBlock Grid.Column="4"
                                 Margin="0,0,18,0"
                                 Text="{Binding NetProfit, StringFormat='{}{0:N0}', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                 Theme="{StaticResource Trade.Statistics.RowValue}"
                                 Foreground="{Binding IsNetProfitNegative, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=@SolidColorBrush.Accent.Red.3|*=@SolidColorBrush.Accent.Green.3'}"
                                 FontSize="{Binding IsTotal, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=14'}"
                                 FontWeight="{Binding IsTotal, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=SemiBold'}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border MinHeight="112"
                  Margin="0,0,4,0"
                  BorderBrush="{DynamicResource SolidColorBrush.Accent.Green.3}"
                  Theme="{StaticResource Dashboard.Card}">
            <Grid>
              <Border CornerRadius="3" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" Opacity="0.12">
                    <GradientStop Offset="0" Color="{DynamicResource Color.Accent.Green.3}" />
                    <GradientStop Offset="1" Color="Transparent" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Grid Margin="14,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="76" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="64" Height="64" VerticalAlignment="Center" Source="{Binding MostExpensiveSaleItem?.DisplayItemIcon, Mode=OneWay}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}"
                             Text="{Binding TranslationMostExpensiveSale, FallbackValue=MOST_EXPENSIVE_SALE}" />
                  <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock Margin="0,0,4,0"
                               FontSize="14"
                               Foreground="{DynamicResource SolidColorBrush.Text.1}"
                               Text="{Binding MostExpensiveSaleItem?.DisplayItemTier, FallbackValue='T?'}" />
                    <TextBlock FontSize="14"
                               Foreground="{DynamicResource SolidColorBrush.Text.1}"
                               Text="{Binding MostExpensiveSaleItem?.DisplayItemName}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                    <Image Width="18" Height="18" Margin="0,0,7,0" Source="avares://StatisticsAnalysisTool/Resources/silver.png" />
                    <Panel>
                    <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}"
                               Text="{Binding MostExpensiveSaleItem?.MailContent?.TotalPrice?.IntegerValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               IsVisible="{Binding MostExpensiveSaleItem?.Type, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Mail=True|*=False'}" />
                    <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}"
                               Text="{Binding MostExpensiveSaleItem?.InstantBuySellContent?.TotalPrice?.IntegerValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               IsVisible="{Binding MostExpensiveSaleItem?.Type, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='InstantSell=True|*=False'}" />
                  </Panel>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="1"
                  MinHeight="112"
                  Margin="4,0,0,0"
                  BorderBrush="{DynamicResource SolidColorBrush.Accent.Red.3}"
                  Theme="{StaticResource Dashboard.Card}">
            <Grid>
              <Border CornerRadius="3" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" Opacity="0.12">
                    <GradientStop Offset="0" Color="{DynamicResource Color.Accent.Red.3}" />
                    <GradientStop Offset="1" Color="Transparent" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Grid Margin="14,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="76" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="64" Height="64" VerticalAlignment="Center" Source="{Binding MostExpensivePurchasedItem?.DisplayItemIcon, Mode=OneWay}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Foreground="{DynamicResource SolidColorBrush.Accent.Red.3}"
                             Text="{Binding TranslationMostExpensivePurchase, FallbackValue=MOST_EXPENSIVE_PURCHASE}" />
                  <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock Margin="0,0,4,0"
                               FontSize="14"
                               Foreground="{DynamicResource SolidColorBrush.Text.1}"
                               Text="{Binding MostExpensivePurchasedItem?.DisplayItemTier, FallbackValue='T?'}" />
                    <TextBlock FontSize="14"
                               Foreground="{DynamicResource SolidColorBrush.Text.1}"
                               Text="{Binding MostExpensivePurchasedItem?.DisplayItemName}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                    <Image Width="18" Height="18" Margin="0,0,7,0" Source="avares://StatisticsAnalysisTool/Resources/silver.png" />
                    <Panel>
                    <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SolidColorBrush.Accent.Red.3}"
                               Text="{Binding MostExpensivePurchasedItem?.MailContent?.TotalPrice?.IntegerValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               IsVisible="{Binding MostExpensivePurchasedItem?.Type, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Mail=True|*=False'}" />
                    <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SolidColorBrush.Accent.Red.3}"
                               Text="{Binding MostExpensivePurchasedItem?.InstantBuySellContent?.TotalPrice?.IntegerValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               IsVisible="{Binding MostExpensivePurchasedItem?.Type, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='InstantBuy=True|*=False'}" />
                  </Panel>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="MailOptionsObjectTemplate" DataType="trade:TradeOptionsObject">
      <Border Padding="12" Theme="{StaticResource Dashboard.Section}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding TranslationSettings, FallbackValue=SETTINGS}" Theme="{StaticResource Dashboard.SectionTitle}" />
          <UniformGrid Grid.Row="1" Margin="0,12,0,0" Columns="3">
            <Border Margin="0,0,4,0" Padding="12" Theme="{StaticResource Dashboard.Card}">
              <StackPanel VerticalAlignment="Center">
                <CheckBox MinWidth="240"
                          Margin="0,0,0,12"
                          HorizontalAlignment="Left"
                          HorizontalContentAlignment="Left"
                          Content="{Binding TranslationCraftingCostsMonitoringActive, FallbackValue=TRACK__CRAFTING__COSTS}"
                          IsChecked="{Binding IsCraftingCostsMonitoringActive}" />
                <CheckBox MinWidth="240"
                          HorizontalAlignment="Left"
                          HorizontalContentAlignment="Left"
                          Content="{Binding TranslationIgnoreMailsWithZeroValues, FallbackValue=IGNORE__MAILS__WITH__ZERO__VALUES}"
                          IsChecked="{Binding IgnoreMailsWithZeroValues}" />
              </StackPanel>
            </Border>
            <Border Margin="4,0" Padding="12" Theme="{StaticResource Dashboard.Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition Height="12" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding TranslationMarketTaxRate, FallbackValue=MARKET__TAX__RATE}"
                           Theme="{StaticResource App.FilterLabel}" />
                <TextBox Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Text="{Binding MarketTaxRate}"
                         common:TextBoxHelper.OnlyNumeric="Double" />
                <TextBlock Grid.Row="2"
                           VerticalAlignment="Center"
                           Text="{Binding TranslationMarketTaxSetupRate, FallbackValue=MARKET__TAX__SETUP__RATE}"
                           Theme="{StaticResource App.FilterLabel}" />
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Text="{Binding MarketTaxSetupRate}"
                         common:TextBoxHelper.OnlyNumeric="Double" />
              </Grid>
            </Border>
            <Border Margin="4,0,0,0" Padding="12" Theme="{StaticResource Dashboard.Card}">
              <StackPanel VerticalAlignment="Center">
                <ComboBox MinWidth="240"
                          Margin="0,0,0,12"
                          HorizontalAlignment="Left"
                          DisplayMemberBinding="{ReflectionBinding Name}"
                          ItemsSource="{Binding DeleteTradesOlderThanSpecifiedDays}"
                          SelectedItem="{Binding DeleteTradesOlderThanSpecifiedDaysSelection}"
                          SelectedValueBinding="{ReflectionBinding Days}" />
                <CheckBox MinWidth="240"
                          HorizontalAlignment="Left"
                          HorizontalContentAlignment="Left"
                          Content="{Binding TranslationPlayerTradeMonitoringActive, FallbackValue=PERSONAL__TRADES__ACTIVE}"
                          IsChecked="{Binding IsPlayerTradeMonitoringActive}" />
              </StackPanel>
            </Border>
          </UniformGrid>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ManuallyMailMenuTemplate" DataType="trade:ManuallyTradeMenuObject">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding TranslationAddTradeManually, FallbackValue=ADD_TRADE_MANUALLY}" Theme="{StaticResource Dashboard.SectionTitle}" />
        <ComboBox Grid.Row="1"
                  Width="200"
                  Margin="0,12,0,10"
                  HorizontalAlignment="Left"
                  DisplayMemberBinding="{ReflectionBinding Name}"
                  ItemsSource="{Binding ManuallyTradeTypes}"
                  SelectedItem="{Binding ManuallyTradeTypeSelection}"
                  SelectedValueBinding="{ReflectionBinding Type}" />
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="{Binding TranslationDescription, FallbackValue=DESCRIPTION}" Theme="{StaticResource App.FilterLabel}" />
            <TextBox Height="64"
                     Padding="6"
                     VerticalContentAlignment="Top"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding TranslationValue, FallbackValue=VALUE}" Theme="{StaticResource App.FilterLabel}" />
            <TextBox Height="32"
                     VerticalContentAlignment="Center"
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     common:TextBoxHelper.OnlyNumeric="Double" />
          </StackPanel>
        </Grid>
        <Button Grid.Row="3"
                Width="200"
                Height="32"
                Margin="0,12,0,0"
                HorizontalAlignment="Left"
                Content="{Binding TranslationAddTrade, FallbackValue=ADD__TRADE}"
                common:MouseCommands.LeftClick="{Binding AddTradeCommand}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TradeExportTemplate" DataType="trade:TradeExportTemplateObject">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding TranslationExport, FallbackValue=EXPORT}" Theme="{StaticResource Dashboard.SectionTitle}" />
        <Button Grid.Row="1"
                Width="220"
                Height="32"
                Margin="0,12,0,0"
                HorizontalAlignment="Left"
                Content="{Binding TranslationExportTradesAsCsv, FallbackValue=EXPORT__TRADES__TO__CSV}"
                common:MouseCommands.LeftClick="{Binding TradeExportCommand}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="MailMarketplaceBuyOrderExpiredTemplate" DataType="trade:Trade">
      <Grid Height="50">
        <Grid Theme="{StaticResource Mail.Type.Colors}" />
        <Border Theme="{StaticResource Container.Border}">
          <DockPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="5,0,10,0">
            <Grid Margin="0,0, 5, 0" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Source="{Binding Item?.Icon, Mode=OneWay}" Theme="{StaticResource Trade.Icon}" />
            </Grid>
            <StackPanel Orientation="Vertical">
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding MailTypeDescription, StringFormat='{}{0}: ', FallbackValue=MAIL}"
                             Theme="{StaticResource Mail.Text.Colors}" />
                  <TextBlock Text="{Binding MailContent?.UsedQuantity, StringFormat='{}{0}', FallbackValue=0}"
                             FontWeight="Bold"
                             Margin="0,0,3,0"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                  <TextBlock Text="{Binding TranslationFrom, FallbackValue=FROM}" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                  <TextBlock Text="{Binding MailContent?.Quantity, StringFormat='{} {0}', FallbackValue=0}"
                             FontWeight="Bold"
                             Margin="0,0,3,0"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                  <TextBlock Theme="{StaticResource Trade.Text.Tier}" />
                  <TextBlock Text="{Binding Item?.LocalizedName}" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                </StackPanel>
                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0}'}"
                           TextAlignment="Right"
                           Foreground="{DynamicResource SolidColorBrush.Text.1}" />
              </DockPanel>
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding TranslationCostPerItem}" Width="160" Foreground="{DynamicResource SolidColorBrush.Text.4}" />
                  <TextBlock Text="{Binding TranslationTotalDistanceFee, FallbackValue=TOTAL_DISTANCE_FEE}"
                             Width="160"
                             Foreground="{DynamicResource SolidColorBrush.Text.4}"
                             IsVisible="{Binding MailContent?.DistanceFeeAboveZeroVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}" />
                  <TextBlock Width="160" Foreground="{DynamicResource SolidColorBrush.Text.4}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} ({1}%)">
                        <Binding Path="TranslationSetupTax" />
                        <Binding Path="MailContent.TaxSetupRate" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Width="160"
                             Foreground="{DynamicResource SolidColorBrush.Text.4}"
                             IsVisible="{Binding MailContent?.IsTaxesStated, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='true=True|false=False|*=False'}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} ({1}%)">
                        <Binding Path="TranslationTax" />
                        <Binding Path="MailContent.TaxRate" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Width="160"
                             Text="{Binding TranslationTotalCost, FallbackValue=TOTAL_COST}"
                             Foreground="{DynamicResource SolidColorBrush.Text.4}" />
                </StackPanel>
                <TextBlock Theme="{StaticResource Trade.City.Text}" />
              </DockPanel>
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <Grid Width="160">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding MailContent.UnitPriceWithoutTax.DoubleValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               Theme="{StaticResource Mail.Text.Colors}"
                               Margin="25,0,0,0" />
                  </Grid>
                  <Grid Width="160"
                        IsVisible="{Binding MailContent?.DistanceFeeAboveZeroVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding MailContent.TotalDistanceFee.IntegerValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               Theme="{StaticResource Mail.Text.Colors}"
                               Margin="25,0,0,0" />
                  </Grid>
                  <Grid Width="160">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding MailContent.TaxSetupPrice.DoubleValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               HorizontalAlignment="Left"
                               Foreground="{DynamicResource SolidColorBrush.Accent.Red.3}"
                               Margin="25,0,0,0" />
                  </Grid>
                  <Grid Width="160"
                        IsVisible="{Binding MailContent?.IsTaxesStated, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='true=True|false=False|*=False'}">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding MailContent.TaxPrice.DoubleValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               HorizontalAlignment="Left"
                               Foreground="{DynamicResource SolidColorBrush.Accent.Red.3}"
                               Margin="25,0,0,0" />
                  </Grid>
                </StackPanel>
                <Grid Width="120">
                  <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                  <TextBlock Text="{common:CultureAwareBinding MailContent.TotalPriceWithAddedTaxes.DoubleValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                             Theme="{StaticResource Mail.Text.Colors}"
                             Margin="25,0,0,0">
                    <ToolTip.Tip>
                      <TextBlock>
                        <TextBlock.Text>
                          <MultiBinding StringFormat="{}{0}: {1:N0}">
                            <Binding Path="TranslationTotalCostWithoutAddedTaxes" />
                            <Binding Path="MailContent.TotalPrice.DoubleValue" />
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </ToolTip.Tip>
                  </TextBlock>
                </Grid>
                <Grid Margin="0 -2 0 0" Height="18" Width="18" HorizontalAlignment="Right">
                  <CheckBox IsChecked="{Binding IsSelectedForDeletion, FallbackValue=false}" ToolTip.Tip="{Binding TranslationSelectToDelete}" />
                </Grid>
              </DockPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </DataTemplate>
