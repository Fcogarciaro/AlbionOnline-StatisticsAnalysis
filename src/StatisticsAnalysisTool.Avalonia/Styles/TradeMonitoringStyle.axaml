                  <Grid Width="160">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding MailContent.TaxSetupPrice.DoubleValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               HorizontalAlignment="Left"
                               Foreground="{DynamicResource SolidColorBrush.Accent.Red.3}"
                               Margin="25,0,0,0" />
                  </Grid>
                  <Grid Width="160"
                        IsVisible="{Binding MailContent?.IsTaxesStated, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='true=True|false=False|*=False'}">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding MailContent.TaxPrice.DoubleValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               HorizontalAlignment="Left"
                               Foreground="{DynamicResource SolidColorBrush.Accent.Red.3}"
                               Margin="25,0,0,0" />
                  </Grid>
                </StackPanel>
                <Grid Width="120">
                  <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                  <TextBlock Text="{common:CultureAwareBinding MailContent.TotalPriceWithDeductedTaxes.DoubleValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                             Theme="{StaticResource Mail.Text.Colors}"
                             Margin="25,0,0,0">
                    <ToolTip.Tip>
                      <TextBlock>
                        <TextBlock.Text>
                          <MultiBinding StringFormat="{}{0}: {1:N0}">
                            <Binding Path="TranslationTotalIncomeWithoutTaxDeductions" />
                            <Binding Path="MailContent.TotalPrice.DoubleValue" />
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </ToolTip.Tip>
                  </TextBlock>
                </Grid>
                <Grid Margin="0 -2 0 0" Height="18" Width="18" HorizontalAlignment="Right">
                  <CheckBox IsChecked="{Binding IsSelectedForDeletion, FallbackValue=false}" ToolTip.Tip="{Binding TranslationSelectToDelete}" />
                </Grid>
              </DockPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="InstantSellTemplate" DataType="trade:Trade">
      <Grid Height="50">
        <Grid Theme="{StaticResource InstantSell.Type.Colors}" />
        <Border Theme="{StaticResource Container.Border}">
          <DockPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="5,0,10,0">
            <Grid Margin="0,0, 5, 0" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Source="{Binding DisplayItemIcon, Mode=OneWay}" Theme="{StaticResource Trade.Icon}" />
            </Grid>
            <StackPanel Orientation="Vertical">
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding TypeDescription, StringFormat='{}{0}: ', FallbackValue=INSTANT_SELL}"
                             Theme="{StaticResource Instant.Text.Color.Green}" />
                  <TextBlock Text="{Binding InstantBuySellContent?.Quantity, StringFormat='{}{0}x', FallbackValue=0}"
                             FontWeight="Bold"
                             Margin="0,0,3,0"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                  <TextBlock Theme="{StaticResource Trade.Text.Tier}" />
                  <TextBlock Text="{Binding DisplayItemName}" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                </StackPanel>
                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0}'}"
                           TextAlignment="Right"
                           Foreground="{DynamicResource SolidColorBrush.Text.1}" />
              </DockPanel>
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding TranslationCostPerItem}" Width="160" Foreground="{DynamicResource SolidColorBrush.Text.4}" />
                  <TextBlock Width="160" Foreground="{DynamicResource SolidColorBrush.Text.4}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} ({1}%)">
                        <Binding Path="TranslationTax" />
                        <Binding Path="InstantBuySellContent.TaxRate" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Width="160"
                             Text="{Binding TranslationTotalRevenue, FallbackValue=TOTAL_REVENUE}"
                             Foreground="{DynamicResource SolidColorBrush.Text.4}" />
                </StackPanel>
                <TextBlock Theme="{StaticResource Trade.City.Text}" />
              </DockPanel>
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <Grid Width="160">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding InstantBuySellContent.UnitPrice.DoubleValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               Theme="{StaticResource Instant.Text.Color.Green}"
                               Margin="25,0,0,0" />
                  </Grid>
                  <Grid Width="160">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding InstantBuySellContent.TaxPrice.DoubleValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               Theme="{StaticResource Instant.Text.Color.Red}"
                               Margin="25,0,0,0" />
                  </Grid>
                  <Grid Width="160">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding InstantBuySellContent.TotalPriceWithDeductedTaxes.DoubleValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               Theme="{StaticResource Instant.Text.Color.Green}"
                               Margin="25,0,0,0">
                      <ToolTip.Tip>
                        <TextBlock>
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}: {1:N0}">
                              <Binding Path="TranslationTotalIncomeWithoutTaxDeductions" />
                              <Binding Path="InstantBuySellContent.TotalPrice.IntegerValue" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </ToolTip.Tip>
                    </TextBlock>
                  </Grid>
                </StackPanel>
                <Grid Margin="0 -2 0 0" Height="18" Width="18" HorizontalAlignment="Right">
                  <CheckBox IsChecked="{Binding IsSelectedForDeletion, FallbackValue=false}" ToolTip.Tip="{Binding TranslationSelectToDelete}" />
                </Grid>
              </DockPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="InstantBuyTemplate" DataType="trade:Trade">
      <Grid Height="50">
        <Grid Theme="{StaticResource InstantBuy.Type.Colors}" />
        <Border Theme="{StaticResource Container.Border}">
          <DockPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="5,0,10,0">
            <Grid Margin="0,0, 5, 0" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Source="{Binding DisplayItemIcon, Mode=OneWay}" Theme="{StaticResource Trade.Icon}" />
            </Grid>
            <StackPanel Orientation="Vertical">
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding TypeDescription, StringFormat='{}{0}: ', FallbackValue=INSTANT_BUY}"
                             Theme="{StaticResource Instant.Text.Color.Red}" />
                  <TextBlock Text="{Binding InstantBuySellContent?.Quantity, StringFormat='{}{0}x', FallbackValue=0}"
                             FontWeight="Bold"
                             Margin="0,0,3,0"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                  <TextBlock Theme="{StaticResource Trade.Text.Tier}" />
                  <TextBlock Text="{Binding DisplayItemName}" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                </StackPanel>
                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0}'}"
                           TextAlignment="Right"
                           Foreground="{DynamicResource SolidColorBrush.Text.1}" />
              </DockPanel>
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding TranslationCostPerItem}" Width="160" Foreground="{DynamicResource SolidColorBrush.Text.4}" />
                  <TextBlock Text="{Binding TranslationTotalDistanceFee, FallbackValue=TOTAL_DISTANCE_FEE}"
                             Width="160"
                             Foreground="{DynamicResource SolidColorBrush.Text.4}"
                             IsVisible="{Binding InstantBuySellContent?.DistanceFeeAboveZeroVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}" />
                  <TextBlock Text="{Binding TranslationTotalCost, FallbackValue=TOTAL_COST}"
                             Width="160"
                             Foreground="{DynamicResource SolidColorBrush.Text.4}" />
                </StackPanel>
                <TextBlock Theme="{StaticResource Trade.City.Text}" />
              </DockPanel>
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <Grid Width="160">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding InstantBuySellContent.UnitPrice.IntegerValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               Theme="{StaticResource Instant.Text.Color.Red}"
                               Margin="25,0,0,0" />
                  </Grid>
                  <Grid Width="160"
                        IsVisible="{Binding InstantBuySellContent?.DistanceFeeAboveZeroVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding InstantBuySellContent.TotalDistanceFee.IntegerValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               Theme="{StaticResource Instant.Text.Color.Red}"
                               Margin="25,0,0,0" />
                  </Grid>
                  <Grid Width="160">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding InstantBuySellContent.TotalPriceWithDeductedTaxes.DoubleValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               Theme="{StaticResource Instant.Text.Color.Red}"
                               Margin="25,0,0,0">
                      <ToolTip.Tip>
                        <TextBlock>
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}: {1:N0}">
                              <Binding Path="TranslationTotalIncomeWithoutTaxDeductions" />
                              <Binding Path="MailContent.TotalPrice.DoubleValue" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </ToolTip.Tip>
                    </TextBlock>
                  </Grid>
                </StackPanel>
                <Grid Margin="0 -2 0 0" Height="18" Width="18" HorizontalAlignment="Right">
                  <CheckBox IsChecked="{Binding IsSelectedForDeletion, FallbackValue=false}" ToolTip.Tip="{Binding TranslationSelectToDelete}" />
                </Grid>
              </DockPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ManualSellTemplate" DataType="trade:Trade">
      <Grid Height="50">
        <Grid Theme="{StaticResource InstantSell.Type.Colors}" />
        <Border Theme="{StaticResource Container.Border}">
          <DockPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="5,0,10,0">
            <Grid Margin="0,0, 5, 0" HorizontalAlignment="Center" VerticalAlignment="Center">
              <fa:FontAwesomeImage Icon="SolidHandHoldingDollar" Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}" Margin="10" />
            </Grid>
            <StackPanel Orientation="Vertical">
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding TypeDescription, StringFormat='{}{0}: ', FallbackValue=INSTANT_SELL}"
                             Theme="{StaticResource Instant.Text.Color.Green}" />
                  <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
                </StackPanel>
                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0}'}"
                           TextAlignment="Right"
                           Foreground="{DynamicResource SolidColorBrush.Text.1}" />
