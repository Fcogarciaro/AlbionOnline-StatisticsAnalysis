                  <Grid Width="160">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding InstantBuySellContent.TaxPrice.DoubleValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               Theme="{StaticResource Instant.Text.Color.Red}"
                               Margin="25,0,0,0">
                      <ToolTip.Tip>
                        <TextBlock>
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}: {1:N0}">
                              <Binding Path="TranslationTotalPriceWithDeductedTaxes" />
                              <Binding Path="InstantBuySellContent.TotalPriceWithDeductedTaxes.IntegerValue" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </ToolTip.Tip>
                    </TextBlock>
                  </Grid>
                </StackPanel>
