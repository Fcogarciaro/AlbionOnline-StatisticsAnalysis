                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
                    <TextBlock Text="{common:CultureAwareBinding InstantBuySellContent.UnitPrice.DoubleValue, StringFormat='{}{0:N0}', FallbackValue=0}"
                               Theme="{StaticResource Instant.Text.Color.Green}"
                               Margin="25,0,0,0" />
                  </Grid>
                  <Grid Width="160">
                    <Image Theme="{StaticResource Trade.Silver.Image.Style}" ToolTip.Tip="{Binding TranslationSilver}" />
