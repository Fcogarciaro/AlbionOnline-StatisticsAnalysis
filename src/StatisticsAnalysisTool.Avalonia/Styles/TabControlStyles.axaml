<!-- Port of Styles/TabControlStyles.xaml (side navigation). Differences: tab icons use fa:MaskedImage (the WPF
     Rectangle + OpacityMask ImageBrush bound to Tag, which Avalonia brushes cannot do); "Hidden" pipe is Opacity 0;
     the ancestor DataContext bindings are $parent[TabControl].DataContext. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
        xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
        x:CompileBindings="False">
  <Styles.Resources>

    <ControlTheme x:Key="NavigationMenuToggleButtonStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="{Binding $parent[TabControl].DataContext.NavigationMenuWidth}" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Text.7}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <fa:FontAwesomeImage x:Name="ToggleIcon"
                                 Icon="SolidAnglesLeft"
                                 Width="16"
                                 Height="16"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource SolidColorBrush.Accent.Blue.4}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:not(:checked) /template/ fa|FontAwesomeImage#ToggleIcon">
        <Setter Property="Icon" Value="SolidAnglesRight" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#Border">
        <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Accent.Blue.Transparent.5}" />
      </Style>
      <Style Selector="^:pointerover /template/ fa|FontAwesomeImage#ToggleIcon">
        <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="ItemContainerStyle" TargetType="TabItem">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Width="{Binding $parent[TabControl].DataContext.NavigationMenuWidth}" Margin="0,2"
                ToolTip.Tip="{TemplateBinding Header}" Background="Transparent">
            <StackPanel Orientation="Horizontal" Margin="0">
              <TextBlock Name="Pipe" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.4}" FontWeight="Bold" Text="|"
                         VerticalAlignment="Center" Padding="5,0,0,0" FontSize="16" Opacity="0" />
              <Grid Name="Icon" Width="32" Height="32" Margin="10,4,9,4"
                    IsVisible="{Binding !$parent[TabControl].DataContext.IsNavigationMenuOpen}">
                <fa:MaskedImage Name="IconMask" Fill="{DynamicResource SolidColorBrush.Text.5}"
                                Source="{TemplateBinding Tag, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}" />
              </Grid>
              <Label Name="Text" Height="40" Content="{TemplateBinding Header}" Foreground="{DynamicResource SolidColorBrush.Text.5}"
                     FontSize="16" VerticalContentAlignment="Center" Margin="5,0"
                     IsVisible="{Binding $parent[TabControl].DataContext.IsNavigationMenuOpen}" />
            </StackPanel>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:selected /template/ TextBlock#Pipe">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^:selected /template/ Label#Text">
        <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Text.1}" />
      </Style>
      <Style Selector="^:selected /template/ fa|MaskedImage#IconMask">
        <Setter Property="Fill" Value="{DynamicResource SolidColorBrush.Text.1}" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="ItemContainerDonationStyle" TargetType="TabItem">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Width="{Binding $parent[TabControl].DataContext.NavigationMenuWidth}" Margin="5,2"
                ToolTip.Tip="{TemplateBinding Header}" Background="Transparent">
            <StackPanel Orientation="Horizontal" Margin="0">
              <TextBlock Name="Pipe" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.4}" FontWeight="Bold" Text="|"
                         VerticalAlignment="Center" Padding="5,0,0,3" FontSize="16" Opacity="0" />
              <Grid Name="Icon" Width="32" Height="32" Margin="10,4,9,4"
                    IsVisible="{Binding !$parent[TabControl].DataContext.IsNavigationMenuOpen}">
                <fa:MaskedImage Name="IconMask" Fill="{DynamicResource SolidColorBrush.Accent.Yellow.2}"
                                Source="{TemplateBinding Tag, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}" />
              </Grid>
              <Label Name="Text" Height="40" Content="{TemplateBinding Header}" Foreground="{DynamicResource SolidColorBrush.Accent.Yellow.2}"
                     FontSize="16" VerticalContentAlignment="Center" Margin="5,0"
                     IsVisible="{Binding $parent[TabControl].DataContext.IsNavigationMenuOpen}" />
            </StackPanel>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:selected /template/ TextBlock#Pipe">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^:selected /template/ Label#Text">
        <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Accent.Yellow.1}" />
      </Style>
      <Style Selector="^:selected /template/ fa|MaskedImage#IconMask">
        <Setter Property="Fill" Value="{DynamicResource SolidColorBrush.Accent.Yellow.1}" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="ItemContainerThanksStyle" TargetType="TabItem">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Width="{Binding $parent[TabControl].DataContext.NavigationMenuWidth}" Margin="5,2"
                ToolTip.Tip="{TemplateBinding Header}" Background="Transparent">
            <StackPanel Orientation="Horizontal" Margin="0">
              <TextBlock Name="Pipe" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.4}" FontWeight="Bold" Text="|"
                         VerticalAlignment="Center" Padding="5,0,0,3" FontSize="16" Opacity="0" />
              <Grid Name="Icon" Width="32" Height="32" Margin="10,4,9,4"
                    IsVisible="{Binding !$parent[TabControl].DataContext.IsNavigationMenuOpen}">
                <fa:MaskedImage Name="IconMask" Fill="{DynamicResource SolidColorBrush.Accent.Red.7}"
                                Source="{TemplateBinding Tag, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}" />
                <Image Name="OriginalIcon" IsVisible="False" Stretch="Uniform"
                       Source="{TemplateBinding Tag, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}" />
              </Grid>
              <Label Name="Text" Height="40" Content="{TemplateBinding Header}" Foreground="{DynamicResource SolidColorBrush.Accent.Red.7}"
                     FontSize="16" VerticalContentAlignment="Center" Margin="5,0"
                     IsVisible="{Binding $parent[TabControl].DataContext.IsNavigationMenuOpen}" />
            </StackPanel>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:selected /template/ TextBlock#Pipe">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^:selected /template/ Label#Text">
        <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Accent.Red.1}" />
      </Style>
      <Style Selector="^:selected /template/ fa|MaskedImage#IconMask">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:selected /template/ Image#OriginalIcon">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="TabControlStyle" TargetType="TabControl">
      <Setter Property="TabStripPlacement" Value="Left" />
      <Setter Property="Margin" Value="0,90,0,40" />
      <Setter Property="ItemContainerTheme" Value="{StaticResource ItemContainerStyle}" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Vertical" Background="Transparent" Margin="2,0,2,0" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="templateRoot" ClipToBounds="True" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Padding="0" Background="Transparent">
              <DockPanel>
                <ToggleButton DockPanel.Dock="Top"
                              Theme="{StaticResource NavigationMenuToggleButtonStyle}"
                              IsChecked="{Binding DataContext.IsNavigationMenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              ToolTip.Tip="Toggle navigation menu" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </DockPanel>
            </Border>
            <Border x:Name="contentPanel" Grid.Column="1" Margin="0">
              <ContentPresenter x:Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding SelectedContent}"
                                ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="TabItemGridStyle" TargetType="Grid">
      <Setter Property="Margin" Value="0" />
    </ControlTheme>

  </Styles.Resources>
</Styles>
