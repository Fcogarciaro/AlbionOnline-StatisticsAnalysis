        <!-- Most valuable loot -->
        <TextBlock Text="{x:Static dungeonModels:DungeonBaseFragment.TranslationMostValuableLoot}"
                   FontSize="16"
                   Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
        <StackPanel Orientation="Horizontal">
          <Image Source="{Binding MostValuableLoot?.Item?.Icon}" Height="34" ToolTip.Tip="{x:Static dungeonModels:DungeonBaseFragment.TranslationMostValuableLoot}" />
          <StackPanel Orientation="Vertical" Height="32" Width="200">
            <TextBlock Padding="0" Text="{Binding MostValuableLoot?.Item?.LocalizedName}" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
