    <DataTemplate x:Key="Stats.Corrupted.Template" DataType="dungeonModels:StatsCorrupted">
      <StackPanel Orientation="Vertical" IsVisible="{Binding Visibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
        <TextBlock Theme="{StaticResource TitleText}" Text="{x:Static dungeonModels:DungeonBaseFragment.TranslationCorrupted}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,20">
          <!-- Entered dungeons -->
          <StackPanel Orientation="Vertical">
            <TextBlock Text="" FontSize="16" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
            <StackPanel Orientation="Horizontal" Height="60" Width="60" Margin="0,0,0,0">
              <StackPanel Orientation="Vertical" Width="40">
                <Image Source="avares://StatisticsAnalysisTool/Assets/dungeon.png"
                       Height="30"
                       Width="30"
                       Margin="0,6,0,4"
                       ToolTip.Tip="{Binding TranslationNumberOfDungeons}" />
                <TextBlock Text="{Binding Entered, FallbackValue=0}" Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <!-- Opened chests -->
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{Binding TranslationChestStats, FallbackValue=CHEST_STATS}"
                       FontSize="16"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                       Margin="10,0,0,0" />
            <StackPanel Orientation="Horizontal">
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedStandardChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/green_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedStandardChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedUncommonChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/blue_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedUncommonChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedRareChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/purple_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedRareChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedLegendaryChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/gold_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedLegendaryChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Rectangle VerticalAlignment="Stretch" Fill="{DynamicResource SolidColorBrush.Background.3}" Width="1" Margin="10,0" />
          <!-- Opened book chests -->
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{Binding TranslationBookChestStats, FallbackValue=BOOK_CHEST_STATS}"
                       FontSize="16"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                       Margin="10,0,0,0" />
            <StackPanel Orientation="Horizontal">
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedStandardChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/book_oblique.png" Height="20" Width="20" Margin="0,0,2,15" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/green_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedStandardBookChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedUncommonChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/book_oblique.png" Height="20" Width="20" Margin="0,0,2,15" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/blue_glow.png" Height="40" Width="40" Opacity="0.4" />
