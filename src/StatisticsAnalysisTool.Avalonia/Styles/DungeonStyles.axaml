<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
        xmlns:converters="clr-namespace:StatisticsAnalysisTool.Common.Converters"
        xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
        xmlns:dungeon="clr-namespace:StatisticsAnalysisTool.Dungeon"
        xmlns:dungeonModels="clr-namespace:StatisticsAnalysisTool.Dungeon.Models"
        xmlns:enumerations="clr-namespace:StatisticsAnalysisTool.Enumerations"
        xmlns:cluster="clr-namespace:StatisticsAnalysisTool.Cluster"
        xmlns:globalization="clr-namespace:System.Globalization;assembly=System.Runtime"
        xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
        xmlns:common="clr-namespace:StatisticsAnalysisTool.Common"
        x:CompileBindings="False">
  <Styles.Resources>
    <ImageBrush x:Key="DungeonFragment.Faction.Background.Heretic"
                Stretch="UniformToFill"
                Source="avares://StatisticsAnalysisTool/Resources/faction_heretic_banner.png"
                AlignmentY="Center"
                AlignmentX="Left"
                Opacity="0.25" />
    <ImageBrush x:Key="DungeonFragment.Faction.Background.Undead"
                Stretch="UniformToFill"
                Source="avares://StatisticsAnalysisTool/Resources/faction_undead_banner.png"
                AlignmentY="Center"
                AlignmentX="Left"
                Opacity="0.25" />
    <ImageBrush x:Key="DungeonFragment.Faction.Background.Keeper"
                Stretch="UniformToFill"
                Source="avares://StatisticsAnalysisTool/Resources/faction_keeper_banner.png"
                AlignmentY="Center"
                AlignmentX="Left"
                Opacity="0.40" />
    <ImageBrush x:Key="DungeonFragment.Faction.Background.Morgana"
                Stretch="UniformToFill"
                Source="avares://StatisticsAnalysisTool/Resources/faction_morgana_banner.png"
                AlignmentY="Center"
                AlignmentX="Left"
                Opacity="0.25" />
    <ImageBrush x:Key="DungeonFragment.Faction.Background.Avalon"
                Stretch="UniformToFill"
                Source="avares://StatisticsAnalysisTool/Resources/faction_avalon_banner.png"
                AlignmentY="Center"
                AlignmentX="Left"
                Opacity="0.25" />
    <ImageBrush x:Key="DungeonFragment.Faction.Background.HellGate"
                Stretch="UniformToFill"
                Source="avares://StatisticsAnalysisTool/Resources/hellgate_banner.png"
                AlignmentY="Center"
                AlignmentX="Left"
                Opacity="0.25" />
    <ImageBrush x:Key="DungeonFragment.Faction.Background.Corrupted"
                Stretch="UniformToFill"
                Source="avares://StatisticsAnalysisTool/Resources/corrupted_banner.png"
                AlignmentY="Center"
                AlignmentX="Left"
                Opacity="0.25" />
    <ImageBrush x:Key="DungeonFragment.Faction.Background.Mists"
                Stretch="UniformToFill"
                Source="avares://StatisticsAnalysisTool/Resources/mists_banner.png"
                AlignmentY="Center"
                AlignmentX="Left"
                Opacity="0.25" />
    <ImageBrush x:Key="DungeonFragment.Faction.Background.MistsDungeon"
                Stretch="UniformToFill"
                Source="avares://StatisticsAnalysisTool/Resources/mists_dungeon_banner.png"
                AlignmentY="Center"
                AlignmentX="Left"
                Opacity="0.25" />
    <ImageBrush x:Key="DungeonFragment.Faction.Background.AbyssalDepths"
                Stretch="UniformToFill"
                Source="avares://StatisticsAnalysisTool/Resources/abyssal_depths_banner.png"
                AlignmentY="Center"
                AlignmentX="Left"
                Opacity="0.25" />
    <LinearGradientBrush x:Key="DungeonFragment.Grid.DungeonMode.Background.DragonArea" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="{StaticResource Dungeon.Mode.DragonArea.1}" Offset="0.0" />
      <GradientStop Color="{StaticResource Dungeon.Mode.DragonArea.2}" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DungeonFragment.Grid.DungeonMode.Background.AbyssalDepths" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="{StaticResource Dungeon.Mode.AbyssalDepths.1}" Offset="0.0" />
      <GradientStop Color="{StaticResource Dungeon.Mode.AbyssalDepths.2}" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DungeonFragment.Grid.DungeonMode.Background.Mists" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="{StaticResource Dungeon.Mode.Mists.1}" Offset="0.0" />
      <GradientStop Color="{StaticResource Dungeon.Mode.Mists.2}" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DungeonFragment.Grid.DungeonMode.Background.MistsDungeon" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="{StaticResource Dungeon.Mode.MistsDungeon.1}" Offset="0.0" />
      <GradientStop Color="{StaticResource Dungeon.Mode.MistsDungeon.2}" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DungeonFragment.Grid.DungeonMode.Background.Expedition" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="{StaticResource Dungeon.Mode.Expedition.1}" Offset="0.0" />
      <GradientStop Color="{StaticResource Dungeon.Mode.Expedition.2}" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DungeonFragment.Grid.DungeonMode.Background.HellGate" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="{StaticResource Dungeon.Mode.HellGate.1}" Offset="0.0" />
      <GradientStop Color="{StaticResource Dungeon.Mode.HellGate.2}" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DungeonFragment.Grid.DungeonMode.Background.Corrupted" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="{StaticResource Dungeon.Mode.Corrupted.1}" Offset="0.0" />
      <GradientStop Color="{StaticResource Dungeon.Mode.Corrupted.2}" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DungeonFragment.Grid.DungeonMode.Background.Solo" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="{StaticResource Dungeon.Mode.Solo.1}" Offset="0.0" />
      <GradientStop Color="{StaticResource Dungeon.Mode.Solo.2}" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DungeonFragment.Grid.DungeonMode.Background.Standard" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="{StaticResource Dungeon.Mode.Standard.1}" Offset="0.0" />
      <GradientStop Color="{StaticResource Dungeon.Mode.Standard.2}" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DungeonFragment.Grid.DungeonMode.Background.StaticDungeon" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="{StaticResource Dungeon.Mode.StaticDungeon.1}" Offset="0.0" />
      <GradientStop Color="{StaticResource Dungeon.Mode.StaticDungeon.2}" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DungeonFragment.Grid.DungeonMode.Background.Avalon" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="{StaticResource Dungeon.Mode.Avalon.1}" Offset="0.0" />
      <GradientStop Color="{StaticResource Dungeon.Mode.Avalon.2}" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Fragment.Activity.Background.Active" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="{DynamicResource Color.Background.2}" Offset="0.0" />
      <GradientStop Color="{DynamicResource Color.Accent.Blue.5}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Fragment.Activity.Background.Done" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="{DynamicResource Color.Background.2}" Offset="0.0" />
      <GradientStop Color="{DynamicResource Color.Background.1}" Offset="1" />
    </LinearGradientBrush>
    <converters:ValueAvgConverter x:Key="ValueAvgConverter" />
    <converters:ShortNumberConverter x:Key="ShortNumberConverter" />
    <converters:EnumToIntOrQuestionMarkConverter x:Key="EnumToIntOrQuestionMarkConverter" />
    <converters:IntToStringOrQuestionMarkConverter x:Key="IntToStringOrQuestionMarkConverter" />
    <converters:SecondsToTimeFormatConverter x:Key="SecondsToTimeFormatConverter" />
    <converters:ShortNumberConverter x:Key="Dungeon.ShortNumberConverter" />
    <converters:DurationSecondsToCompactStringConverter x:Key="Dungeon.DurationConverter" />
    <ControlTheme x:Key="Dungeon.AnalyticsCard" TargetType="Border" BasedOn="{StaticResource Dashboard.SummaryCard}">
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="10,9" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.DetailCard" TargetType="Border" BasedOn="{StaticResource Dashboard.Section}">
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="13,11" />
      <Setter Property="MinHeight" Value="235" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.RarityBadge" TargetType="Border">
      <Setter Property="BorderBrush"
              Value="{Binding Rarity, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Common=@SolidColorBrush.Item.Level.Color.1|Uncommon=@SolidColorBrush.Item.Level.Color.2|Rare=@SolidColorBrush.Item.Level.Color.3|Legendary=@SolidColorBrush.Item.Level.Color.4|*=@SolidColorBrush.Border.2'}" />
      <Style Selector="^.other">
        <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Text.1}" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.DeltaText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="ToolTip.Tip"
              Value="{Binding DataContext?.DungeonBindings?.Analytics?.ComparisonText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Text.2}" />
      <Style Selector="^.positive">
        <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Accent.Green.3}" />
      </Style>
      <Style Selector="^.negative">
        <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Accent.Red.3}" />
      </Style>
    </ControlTheme>
    <DataTemplate x:Key="Dungeon.SummaryMetricTemplate" DataType="dungeonModels:DungeonMetric">
      <StackPanel>
        <WrapPanel>
          <TextBlock Text="{Binding Value, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}"
                     Theme="{StaticResource Dashboard.SummaryValue}" />
          <TextBlock Text="{Binding ValuePerHour, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, StringFormat='{}({0} /h)', FallbackValue=0}"
                     Theme="{StaticResource Dashboard.SummaryPerHourText}"
                     IsVisible="{Binding HasPerHourValue, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=True|*=False'}" />
        </WrapPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ChangeIndicator}" Theme="{StaticResource Dungeon.DeltaText}" Classes.positive="{Binding IsPositiveChange}" Classes.negative="{Binding IsNegativeChange}" />
          <TextBlock Text=" " Theme="{StaticResource Dungeon.DeltaText}" Classes.positive="{Binding IsPositiveChange}" Classes.negative="{Binding IsNegativeChange}" />
          <TextBlock Text="{Binding ChangeAmount, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}"
                     Theme="{StaticResource Dungeon.DeltaText}" Classes.positive="{Binding IsPositiveChange}" Classes.negative="{Binding IsNegativeChange}" />
          <TextBlock Text=" (" Theme="{StaticResource Dungeon.DeltaText}" Classes.positive="{Binding IsPositiveChange}" Classes.negative="{Binding IsNegativeChange}" />
          <TextBlock Text="{Binding ChangePercentageText}" Theme="{StaticResource Dungeon.DeltaText}" Classes.positive="{Binding IsPositiveChange}" Classes.negative="{Binding IsNegativeChange}" />
          <TextBlock Text=")" Theme="{StaticResource Dungeon.DeltaText}" Classes.positive="{Binding IsPositiveChange}" Classes.negative="{Binding IsNegativeChange}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="Dungeon.DurationMetricTemplate" DataType="dungeonModels:DungeonMetric">
      <StackPanel>
        <TextBlock Text="{Binding Value, Converter={StaticResource Dungeon.DurationConverter}, FallbackValue=0m}"
                   Theme="{StaticResource Dashboard.SummaryValue}" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ChangeIndicator}" Theme="{StaticResource Dungeon.DeltaText}" Classes.positive="{Binding IsPositiveChange}" Classes.negative="{Binding IsNegativeChange}" />
          <TextBlock Text=" " Theme="{StaticResource Dungeon.DeltaText}" Classes.positive="{Binding IsPositiveChange}" Classes.negative="{Binding IsNegativeChange}" />
          <TextBlock Text="{Binding ChangeAmount, Converter={StaticResource Dungeon.DurationConverter}, FallbackValue=0m}"
                     Theme="{StaticResource Dungeon.DeltaText}" Classes.positive="{Binding IsPositiveChange}" Classes.negative="{Binding IsNegativeChange}" />
          <TextBlock Text=" (" Theme="{StaticResource Dungeon.DeltaText}" Classes.positive="{Binding IsPositiveChange}" Classes.negative="{Binding IsNegativeChange}" />
          <TextBlock Text="{Binding ChangePercentageText}" Theme="{StaticResource Dungeon.DeltaText}" Classes.positive="{Binding IsPositiveChange}" Classes.negative="{Binding IsNegativeChange}" />
          <TextBlock Text=")" Theme="{StaticResource Dungeon.DeltaText}" Classes.positive="{Binding IsPositiveChange}" Classes.negative="{Binding IsNegativeChange}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <ControlTheme x:Key="Dungeon.ContentTabs" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.ContentTab" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Text.4}" />
      <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Background.4}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Border.2}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="15,6" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="TabBorder"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4,4,0,0">
            <ContentPresenter Name="PART_ContentPresenter"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.OverviewMetricCard" TargetType="Border" BasedOn="{StaticResource Dashboard.SummaryCard}">
      <Setter Property="MinWidth" Value="135" />
      <Setter Property="MinHeight" Value="88" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Background.3}" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.OverviewMetricTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Text.3}" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.OverviewMetricValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Text.1}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.OverviewMetricCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Text.4}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.SettingsCard" TargetType="Border" BasedOn="{StaticResource Dashboard.Section}">
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="13,11" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.EfficiencyBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="19" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Background.4}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="PART_Track" ClipToBounds="True">
            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.LootToggle" TargetType="Border">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Margin" Value="0,-2,0,2" />
      <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Accent.Blue.Transparent.5}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Accent.Blue.4}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Cursor" Value="Hand" />
    </ControlTheme>
    <DataTemplate x:Key="DungeonFragment.LootToggle.Template" DataType="dungeonModels:DungeonBaseFragment">
      <Border Theme="{StaticResource Dungeon.LootToggle}"
              ToolTip.Tip="{Binding LootToggleToolTip}"
              common:MouseCommands.LeftClick="{Binding ShowLootedItems}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition />
            <ColumnDefinition Width="18" />
          </Grid.ColumnDefinitions>
          <Grid Width="24" Height="24">
            <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" />
          </Grid>
          <StackPanel Grid.Column="1" Margin="3,0,7,0">
            <TextBlock Text="{Binding TotalValue, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, StringFormat='{}{0:N0}', FallbackValue=0}"
                       Foreground="{DynamicResource SolidColorBrush.Text.1}"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding LootSummaryText}" FontSize="10" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
          </StackPanel>
          <TextBlock Grid.Column="2"
                     FontSize="10"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                     IsVisible="{Binding HasLootVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                     Text="{Binding ItemsContainerVisibility, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Visible=▲|*=▼'}" />
        </Grid>
      </Border>
    </DataTemplate>
    <ControlTheme x:Key="DungeonFragment.Faction" TargetType="Border">
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background"
              Value="{Binding Faction, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Heretic=@DungeonFragment.Faction.Background.Heretic|Undead=@DungeonFragment.Faction.Background.Undead|Keeper=@DungeonFragment.Faction.Background.Keeper|Morgana=@DungeonFragment.Faction.Background.Morgana|Avalon=@DungeonFragment.Faction.Background.Avalon|HellGate=@DungeonFragment.Faction.Background.HellGate|Corrupted=@DungeonFragment.Faction.Background.Corrupted|Mists=@DungeonFragment.Faction.Background.Mists|MistsDungeon=@DungeonFragment.Faction.Background.MistsDungeon|AbyssalDepths=@DungeonFragment.Faction.Background.AbyssalDepths'}" />
    </ControlTheme>
    <ControlTheme x:Key="DungeonFragment.Grid.DungeonMode" TargetType="Grid">
      <Setter Property="Width" Value="5" />
      <Setter Property="ToolTip.Tip"
              Value="{Binding Mode, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='DragonArea=$DRAGONAREA|AbyssalDepths=$ABYSSALDEPTHS|Mists=$MISTS|MistsDungeon=$MISTS_DUNGEON|Expedition=$EXPEDITION|HellGate=$HELLGATE|Corrupted=$CORRUPTED|Solo=$SOLO|Standard=$STANDARD|StaticDungeon=$STATIC_DUNGEONS|Avalon=$AVALON|Unknown=$UNKNOWN'}" />
      <Setter Property="Background"
              Value="{Binding Mode, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='DragonArea=@DungeonFragment.Grid.DungeonMode.Background.DragonArea|AbyssalDepths=@DungeonFragment.Grid.DungeonMode.Background.AbyssalDepths|Mists=@DungeonFragment.Grid.DungeonMode.Background.Mists|MistsDungeon=@DungeonFragment.Grid.DungeonMode.Background.MistsDungeon|Expedition=@DungeonFragment.Grid.DungeonMode.Background.Expedition|HellGate=@DungeonFragment.Grid.DungeonMode.Background.HellGate|Corrupted=@DungeonFragment.Grid.DungeonMode.Background.Corrupted|Solo=@DungeonFragment.Grid.DungeonMode.Background.Solo|Standard=@DungeonFragment.Grid.DungeonMode.Background.Standard|StaticDungeon=@DungeonFragment.Grid.DungeonMode.Background.StaticDungeon|Avalon=@DungeonFragment.Grid.DungeonMode.Background.Avalon|Unknown=@SolidColorBrush.Dungeon.Mode.Unknown'}" />
    </ControlTheme>
    <ControlTheme x:Key="DungeonNotificationFragment.Label.DungeonMode" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
      <Setter Property="Width" Value="5" />
      <Setter Property="MinWidth" Value="31" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ToolTip.Tip"
              Value="{Binding Mode, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='DragonArea=$DRAGONAREA|AbyssalDepths=$ABYSSALDEPTHS|Mists=$EXPEDITION|MistsDungeon=$EXPEDITION|Expedition=$EXPEDITION|HellGate=$SOLO|Corrupted=$SOLO|Solo=$SOLO|Standard=$STANDARD|StaticDungeon=$STATIC_DUNGEONS|Avalon=$AVALON|Unknown=$UNKNOWN|*=$TIER'}" />
      <Setter Property="Foreground"
              Value="{Binding Mode, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='DragonArea=@SolidColorBrush.Dungeon.Mode.DragonArea.1|AbyssalDepths=@SolidColorBrush.Dungeon.Mode.AbyssalDepths.1|Mists=@SolidColorBrush.Dungeon.Mode.Mists.1|MistsDungeon=@SolidColorBrush.Dungeon.Mode.MistsDungeon.1|Expedition=@SolidColorBrush.Dungeon.Mode.Expedition.1|HellGate=@SolidColorBrush.Dungeon.Mode.HellGate.1|Corrupted=@SolidColorBrush.Dungeon.Mode.Corrupted.1|Solo=@SolidColorBrush.Dungeon.Mode.Solo.1|Standard=@SolidColorBrush.Dungeon.Mode.Standard.1|StaticDungeon=@SolidColorBrush.Dungeon.Mode.StaticDungeon.1|Avalon=@SolidColorBrush.Dungeon.Mode.Avalon.1|Unknown=@SolidColorBrush.Dungeon.Mode.Unknown'}" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeons.Stats.TitleText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Light" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeons.Stats.Text" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Light" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Text.2}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeons.Stats.Value" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Text.1}" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeons.Stats.Value.Big" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
    </ControlTheme>
    <DataTemplate x:Key="DungeonContainerItemTemplate" DataType="dungeonModels:Loot">
      <Grid Height="44" Width="44" Margin="0">
        <Image Margin="2" Source="{Binding Item?.Icon, Mode=OneWay}" Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="Stats.Total.Template" DataType="dungeonModels:StatsTotal">
      <StackPanel Orientation="Vertical" IsVisible="{Binding Visibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
        <TextBlock Theme="{StaticResource TitleText}" Text="{Binding TranslationTotalOverview, FallbackValue='TOTAL_OVERVIEW'}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,24">
          <!-- Entered dungeons -->
          <StackPanel Orientation="Vertical">
            <TextBlock Text="" FontSize="16" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
            <StackPanel Orientation="Horizontal" Height="60" Width="60" Margin="0,0,0,0">
              <StackPanel Orientation="Vertical" Width="40">
                <Image Source="avares://StatisticsAnalysisTool/Assets/dungeon.png"
                       Height="30"
                       Width="30"
                       Margin="0,6,0,4"
                       ToolTip.Tip="{Binding TranslationNumberOfDungeons}" />
