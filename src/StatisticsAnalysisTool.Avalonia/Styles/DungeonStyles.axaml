                  <Image Source="avares://StatisticsAnalysisTool/Assets/book_oblique.png" Height="20" Width="20" Margin="0,0,2,15" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/blue_glow.png" Height="40" Width="40" Opacity="0.4" />
