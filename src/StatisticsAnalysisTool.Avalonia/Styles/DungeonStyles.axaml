                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
            <DockPanel Width="140">
              <TextBlock Text="{Binding SilverAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,3">
            <Image Source="avares://StatisticsAnalysisTool/Assets/bag.png" Height="20" Width="20" Margin="5,0,5,0" />
            <TextBlock Width="140"
                       Text="{Binding LootInSilver, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                       Theme="{StaticResource Dungeons.Stats.Value}" />
            <DockPanel Width="140">
              <TextBlock Text="{Binding LootInSilverPerHour, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
            <DockPanel Width="140">
              <TextBlock Text="{Binding LootInSilverAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
        </StackPanel>
        <!-- Most valuable loot -->
        <TextBlock Text="{x:Static dungeonModels:DungeonBaseFragment.TranslationMostValuableLoot}"
                   FontSize="16"
                   Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
        <StackPanel Orientation="Horizontal">
          <Image Source="{Binding MostValuableLoot?.Item?.Icon}" Height="34" ToolTip.Tip="{x:Static dungeonModels:DungeonBaseFragment.TranslationMostValuableLoot}" />
          <StackPanel Orientation="Vertical" Height="32" Width="200">
            <TextBlock Padding="0" Text="{Binding MostValuableLoot?.Item?.LocalizedName}" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
            <TextBlock Padding="0"
                       Text="{Binding MostValuableLoot?.EstimatedMarketValue?.DoubleValue, StringFormat='{}{0:N0}'}"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="Stats.AbyssalDepths.Template" DataType="dungeonModels:StatsAbyssalDepths">
      <StackPanel Orientation="Vertical" IsVisible="{Binding Visibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
        <TextBlock Theme="{StaticResource TitleText}" Text="{x:Static dungeonModels:DungeonBaseFragment.TranslationAbyssalDepths}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,20">
          <!-- Entered dungeons -->
          <StackPanel Orientation="Vertical">
            <TextBlock Text="" FontSize="16" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
            <StackPanel Orientation="Horizontal" Height="60" Width="60" Margin="0,0,0,0">
              <StackPanel Orientation="Vertical" Width="40">
                <Image Source="avares://StatisticsAnalysisTool/Assets/dungeon.png"
                       Height="30"
                       Width="30"
                       Margin="0,6,0,4"
                       ToolTip.Tip="{Binding TranslationNumberOfDungeons}" />
                <TextBlock Text="{Binding Entered, FallbackValue=0}" Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <!-- Opened chests -->
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{Binding TranslationChestStats, FallbackValue=CHEST_STATS}"
                       FontSize="16"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                       Margin="10,0,0,0" />
            <StackPanel Orientation="Horizontal">
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedStandardChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/green_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedStandardChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedUncommonChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/blue_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedUncommonChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedRareChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/purple_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedRareChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedLegendaryChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/gold_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedLegendaryChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Rectangle VerticalAlignment="Stretch" Fill="{DynamicResource SolidColorBrush.Background.3}" Width="1" Margin="10,0" />
          <!-- Kills / Deaths -->
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{Binding TranslationKillsDeaths, FallbackValue=KILLS_DEATHS}"
                       FontSize="16"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                       Margin="10,0,0,0" />
            <StackPanel Orientation="Horizontal">
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationFights}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/skull.png" Height="26" Width="26" />
                </Grid>
                <TextBlock Text="{Binding Fights, StringFormat='{}{0:N0}', FallbackValue=0}" Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationKills}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/skull_green.png" Height="26" Width="26" />
                </Grid>
                <TextBlock Text="{Binding Kills, StringFormat='{}{0:N0}', FallbackValue=0}" Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationDeaths}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/skull_red.png" Height="26" Width="26" />
                </Grid>
                <TextBlock Text="{Binding Deaths, StringFormat='{}{0:N0}', FallbackValue=0}" Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <!-- Fame, ReSpec, Silver, Might, Favor, Loot value, table -->
        <StackPanel Orientation="Vertical" Margin="0,0,0,20">
          <StackPanel Orientation="Horizontal" Height="20">
            <Grid Width="34" />
            <TextBlock Width="140"
                       FontSize="14"
                       Text="{Binding TranslationTotal, FallbackValue='TOTAL'}"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
            <TextBlock Width="140"
                       FontSize="14"
                       Text="{Binding TranslationPerHour, FallbackValue='PER_HOUR'}"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
            <TextBlock Width="140"
                       FontSize="14"
                       Text="{Binding TranslationAverage, FallbackValue='AVERAGE'}"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,3">
            <Image Source="avares://StatisticsAnalysisTool/Resources/fame.png" Height="20" Width="20" Margin="5,0,5,0" />
            <TextBlock Width="140"
                       Text="{Binding Fame, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                       Theme="{StaticResource Dungeons.Stats.Value}" />
            <DockPanel Width="140">
              <TextBlock Text="{Binding FamePerHour, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
            <DockPanel Width="140">
              <TextBlock Text="{Binding FameAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,3">
            <Image Source="avares://StatisticsAnalysisTool/Resources/respec.png" Height="20" Width="20" Margin="5,0,5,0" />
            <TextBlock Width="140"
                       Text="{Binding ReSpec, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                       Theme="{StaticResource Dungeons.Stats.Value}" />
            <DockPanel Width="140">
              <TextBlock Text="{Binding ReSpecPerHour, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
            <DockPanel Width="140">
              <TextBlock Text="{Binding ReSpecAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,3">
            <Image Source="avares://StatisticsAnalysisTool/Resources/might.png" Height="20" Width="20" Margin="5,0,5,0" />
            <TextBlock Width="140"
                       Text="{Binding Might, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                       Theme="{StaticResource Dungeons.Stats.Value}" />
            <DockPanel Width="140">
              <TextBlock Text="{Binding MightPerHour, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
            <DockPanel Width="140">
              <TextBlock Text="{Binding MightAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,3">
            <Image Source="avares://StatisticsAnalysisTool/Resources/favor.png" Height="20" Width="20" Margin="5,0,5,0" />
            <TextBlock Width="140"
                       Text="{Binding Favor, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                       Theme="{StaticResource Dungeons.Stats.Value}" />
            <DockPanel Width="140">
              <TextBlock Text="{Binding FavorPerHour, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
            <DockPanel Width="140">
              <TextBlock Text="{Binding FavorAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,3">
            <Image Source="avares://StatisticsAnalysisTool/Resources/silver.png" Height="20" Width="20" Margin="5,0,5,0" />
            <TextBlock Width="140"
                       Text="{Binding Silver, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                       Theme="{StaticResource Dungeons.Stats.Value}" />
            <DockPanel Width="140">
              <TextBlock Text="{Binding SilverPerHour, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
            <DockPanel Width="140">
              <TextBlock Text="{Binding SilverAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,3">
            <Image Source="avares://StatisticsAnalysisTool/Assets/bag.png" Height="20" Width="20" Margin="5,0,5,0" />
            <TextBlock Width="140"
                       Text="{Binding LootInSilver, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                       Theme="{StaticResource Dungeons.Stats.Value}" />
            <DockPanel Width="140">
              <TextBlock Text="{Binding LootInSilverPerHour, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
            <DockPanel Width="140">
              <TextBlock Text="{Binding LootInSilverAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
        </StackPanel>
        <!-- Most valuable loot -->
        <TextBlock Text="{x:Static dungeonModels:DungeonBaseFragment.TranslationMostValuableLoot}"
                   FontSize="16"
                   Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
        <StackPanel Orientation="Horizontal">
          <Image Source="{Binding MostValuableLoot?.Item?.Icon}" Height="34" ToolTip.Tip="{x:Static dungeonModels:DungeonBaseFragment.TranslationMostValuableLoot}" />
          <StackPanel Orientation="Vertical" Height="32" Width="200">
            <TextBlock Padding="0" Text="{Binding MostValuableLoot?.Item?.LocalizedName}" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
            <TextBlock Padding="0"
                       Text="{Binding MostValuableLoot?.EstimatedMarketValue?.DoubleValue, StringFormat='{}{0:N0}'}"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="Dungeon.Stats.Template" DataType="dungeonModels:DungeonStats">
      <StackPanel Height="420">
        <!-- Total View -->
        <ContentControl ContentTemplate="{StaticResource Stats.Total.Template}" Content="{Binding StatsTotal}" />
        <!-- Solo dungeons -->
        <ContentControl ContentTemplate="{StaticResource Stats.Solo.Template}" Content="{Binding StatsSolo}" />
        <!-- Standard dungeons -->
        <ContentControl ContentTemplate="{StaticResource Stats.Standard.Template}" Content="{Binding StatsStandard}" />
        <!-- Avalonian dungeons -->
        <ContentControl ContentTemplate="{StaticResource Stats.Avalonian.Template}" Content="{Binding StatsAvalonian}" />
        <!-- Mists -->
        <ContentControl ContentTemplate="{StaticResource Stats.Mists.Template}" Content="{Binding StatsMists}" />
        <!-- Mists dungeon -->
        <ContentControl ContentTemplate="{StaticResource Stats.MistsDungeon.Template}" Content="{Binding StatsMistsDungeon}" />
        <!-- Expedition -->
        <ContentControl ContentTemplate="{StaticResource Stats.Expedition.Template}" Content="{Binding StatsExpedition}" />
        <!-- Corrupted -->
        <ContentControl ContentTemplate="{StaticResource Stats.Corrupted.Template}" Content="{Binding StatsCorrupted}" />
        <!-- HellGate -->
        <ContentControl ContentTemplate="{StaticResource Stats.HellGate.Template}" Content="{Binding StatsHellGate}" />
        <!-- Abyssal Depths -->
        <ContentControl ContentTemplate="{StaticResource Stats.AbyssalDepths.Template}" Content="{Binding StatsAbyssalDepths}" />
      </StackPanel>
    </DataTemplate>
    <!-- Filter settings template -->
    <DataTemplate x:Key="DungeonStatsFilterTemplate" DataType="dungeon:DungeonStatsFilter">
      <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="0,0,0,0">
        <DockPanel Margin="0,0,0,0" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left">
          <CheckBox Content="T?" Margin="5,0,5,0" IsChecked="{Binding IsTierUnknown}" />
          <CheckBox Content="{Binding TranslationT1, FallbackValue='T1'}" Margin="5,0,5,0" IsChecked="{Binding IsT1}" />
          <CheckBox Content="{Binding TranslationT2, FallbackValue='T2'}" Margin="5,0,5,0" IsChecked="{Binding IsT2}" />
          <CheckBox Content="{Binding TranslationT3, FallbackValue='T3'}" Margin="5,0,5,0" IsChecked="{Binding IsT3}" />
          <CheckBox Content="{Binding TranslationT4, FallbackValue='T4'}" Margin="5,0,5,0" IsChecked="{Binding IsT4}" />
          <CheckBox Content="{Binding TranslationT5, FallbackValue='T5'}" Margin="5,0,5,0" IsChecked="{Binding IsT5}" />
          <CheckBox Content="{Binding TranslationT6, FallbackValue='T6'}" Margin="5,0,5,0" IsChecked="{Binding IsT6}" />
          <CheckBox Content="{Binding TranslationT7, FallbackValue='T7'}" Margin="5,0,5,0" IsChecked="{Binding IsT7}" />
          <CheckBox Content="{Binding TranslationT8, FallbackValue='T8'}" Margin="5,0,5,0" IsChecked="{Binding IsT8}" />
        </DockPanel>
        <DockPanel Margin="0,0,0,0" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left">
          <CheckBox ToolTip.Tip="{x:Static dungeonModels:DungeonBaseFragment.TranslationUnknown}" Margin="5,0,5,0" IsChecked="{Binding IsLevelUnknown}">
            <CheckBox.Content>
              <Label>?</Label>
            </CheckBox.Content>
          </CheckBox>
          <CheckBox ToolTip.Tip="{Binding TranslationFlat}" Margin="5,0,5,0" IsChecked="{Binding IsLevel0}">
            <CheckBox.Content>
              <StackPanel Orientation="Horizontal">
                <Image Source="avares://StatisticsAnalysisTool/Assets/gem_level0.png" Height="11" Width="11" Margin="0,2,0,0" />
              </StackPanel>
            </CheckBox.Content>
          </CheckBox>
          <CheckBox ToolTip.Tip=".0" Margin="5,0,5,0" IsChecked="{Binding IsLevel1}">
            <CheckBox.Content>
              <StackPanel Orientation="Horizontal">
                <Image Source="avares://StatisticsAnalysisTool/Assets/gem_level1.png" Height="11" Width="11" Margin="0,2,0,0" />
              </StackPanel>
            </CheckBox.Content>
          </CheckBox>
          <CheckBox ToolTip.Tip=".1" Margin="5,0,5,0" IsChecked="{Binding IsLevel2}">
            <CheckBox.Content>
              <StackPanel Orientation="Horizontal">
                <Image Source="avares://StatisticsAnalysisTool/Assets/gem_level2.png" Height="11" Width="11" Margin="-5,2,0,0" />
              </StackPanel>
            </CheckBox.Content>
          </CheckBox>
          <CheckBox ToolTip.Tip=".2" Margin="5,0,5,0" IsChecked="{Binding IsLevel3}">
            <CheckBox.Content>
              <StackPanel Orientation="Horizontal">
                <Image Source="avares://StatisticsAnalysisTool/Assets/gem_level3.png" Height="11" Width="11" Margin="-5,2,0,0" />
              </StackPanel>
            </CheckBox.Content>
          </CheckBox>
          <CheckBox ToolTip.Tip=".3" Margin="5,0,5,0" IsChecked="{Binding IsLevel4}">
            <CheckBox.Content>
              <StackPanel Orientation="Horizontal">
                <Image Source="avares://StatisticsAnalysisTool/Assets/gem_level4.png" Height="11" Width="11" Margin="-5,2,0,0" />
              </StackPanel>
            </CheckBox.Content>
          </CheckBox>
        </DockPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="Dungeon.CheckPoint.Template" DataType="dungeonModels:CheckPoint">
      <Grid Width="18">
        <Image Source="avares://StatisticsAnalysisTool/Assets/checkpoint.png"
               ToolTip.Tip="{Binding TranslationCheckPoint, Mode=OneWay}"
               Opacity="{Binding Status, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Unknown=0.25|Active=1|Done=0.75|*=0.50'}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DungeonFragment.RandomDungeon.MapTypeIcon.Template" DataType="dungeonModels:RandomDungeonFragment">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-10,0,-10">
        <Image Height="46"
               Width="38"
               Source="{Binding Level, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='1=avares://StatisticsAnalysisTool/Assets/butterfly_uncommon.png|2=avares://StatisticsAnalysisTool/Assets/butterfly_rare.png|3=avares://StatisticsAnalysisTool/Assets/butterfly_epic.png|4=avares://StatisticsAnalysisTool/Assets/butterfly_legendary.png'}"
               IsVisible="{Binding Level, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='1=True|2=True|3=True|4=True|*=False'}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="DungeonFragment.Mists.MapTypeIcon.Template" DataType="dungeonModels:MistsFragment">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Height="34"
               Width="34"
               Source="{Binding Rarity, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Unknown=avares://StatisticsAnalysisTool/Assets/shiny_common.png|Common=avares://StatisticsAnalysisTool/Assets/shiny_common.png|Uncommon=avares://StatisticsAnalysisTool/Assets/shiny_uncommon.png|Rare=avares://StatisticsAnalysisTool/Assets/shiny_rare.png|Epic=avares://StatisticsAnalysisTool/Assets/shiny_epic.png|Legendary=avares://StatisticsAnalysisTool/Assets/shiny_legendary.png'}"
               IsVisible="{Binding Rarity, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Unknown=True|Common=True|Uncommon=True|Rare=True|Epic=True|Legendary=True|*=False'}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="DungeonFragment.ClusterTypeIcon.Template" DataType="dungeonModels:DungeonBaseFragment">
      <DockPanel>
        <Panel Height="20" Width="20" VerticalAlignment="Center" ToolTip.Tip="{x:Static dungeonModels:DungeonBaseFragment.TranslationClusterType}">
          <Image Source="{Binding ClusterType, Mode=OneWay, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='SafeArea=avares://StatisticsAnalysisTool/Assets/map_blue_icon.png|Yellow=avares://StatisticsAnalysisTool/Assets/map_yellow_icon.png|Red=avares://StatisticsAnalysisTool/Assets/map_red_icon.png|Black=avares://StatisticsAnalysisTool/Assets/map_black_icon.png|*=avares://StatisticsAnalysisTool/Assets/map_white_icon.png'}"
                 IsVisible="{Binding Mode, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='AbyssalDepths=False|*=True'}" />
          <Image Source="avares://StatisticsAnalysisTool/Assets/map_orange_icon.png"
                 IsVisible="{Binding Mode, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='AbyssalDepths=True|*=False'}" />
        </Panel>
      </DockPanel>
    </DataTemplate>
    <ControlTheme x:Key="Fragment.Activity" TargetType="Grid">
      <Setter Property="Background"
              Value="{Binding Status, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Active=@Fragment.Activity.Background.Active|Done=@Fragment.Activity.Background.Done'}" />
    </ControlTheme>
    <ControlTheme x:Key="Fragment.TierLevel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Foreground"
              Value="{Binding Level, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='0=@SolidColorBrush.Text.3|1=@SolidColorBrush.Item.Level.Color.1|2=@SolidColorBrush.Item.Level.Color.2|3=@SolidColorBrush.Item.Level.Color.3|4=@SolidColorBrush.Item.Level.Color.4|*=@SolidColorBrush.Text.5'}" />
    </ControlTheme>
    <ControlTheme x:Key="Fragment.Tier" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Foreground"
              Value="{Binding Tier, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Unknown=@SolidColorBrush.Text.5|*=@SolidColorBrush.Text.3'}" />
    </ControlTheme>
    <DataTemplate x:Key="DungeonFragment.Fame.Template" DataType="dungeonModels:DungeonBaseFragment">
      <DockPanel Height="16">
        <Grid HorizontalAlignment="Center"
              Width="20"
              Margin="0,0,2,0"
              VerticalAlignment="Center"
              ToolTip.Tip="{x:Static dungeonModels:DungeonBaseFragment.TranslationFame}">
          <Image Source="avares://StatisticsAnalysisTool/Resources/fame.png" />
        </Grid>
        <DockPanel>
          <TextBlock Text="{Binding Fame, Converter={StaticResource ShortNumberConverter},                                                          ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, Mode=OneWay, FallbackValue=-}"
                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                     TextAlignment="Right" />
          <TextBlock Text="/" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" FontWeight="Bold" Margin="2,0,2,0" />
          <TextBlock Text="{Binding FamePerHour, Converter={StaticResource ShortNumberConverter},                                                          ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, Mode=OneWay, StringFormat='{}{0:N0}/h', FallbackValue=-}"
                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                     TextAlignment="Left" />
        </DockPanel>
      </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="DungeonFragment.ReSpec.Template" DataType="dungeonModels:DungeonBaseFragment">
      <DockPanel Height="16">
        <Grid HorizontalAlignment="Center"
              Width="20"
              Margin="0,0,2,0"
              VerticalAlignment="Center"
              ToolTip.Tip="{x:Static dungeonModels:DungeonBaseFragment.TranslationReSpec}">
          <Image Source="avares://StatisticsAnalysisTool/Resources/respec.png" />
        </Grid>
        <DockPanel>
          <TextBlock Text="{Binding ReSpec, Converter={StaticResource ShortNumberConverter},                                                          ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, Mode=OneWay, FallbackValue=-}"
                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                     TextAlignment="Right" />
          <TextBlock Text="/" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" FontWeight="Bold" Margin="2,0,2,0" />
          <TextBlock Text="{Binding ReSpecPerHour, Converter={StaticResource ShortNumberConverter},                                                          ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, Mode=OneWay, StringFormat='{}{0:N0}/h', FallbackValue=-}"
                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                     TextAlignment="Left" />
        </DockPanel>
      </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="DungeonFragment.Silver.Template" DataType="dungeonModels:DungeonBaseFragment">
      <DockPanel Height="16">
        <Grid HorizontalAlignment="Center"
              Width="20"
              Margin="0,0,2,0"
              VerticalAlignment="Center"
              ToolTip.Tip="{x:Static dungeonModels:DungeonBaseFragment.TranslationSilver}">
          <Image Source="avares://StatisticsAnalysisTool/Resources/silver.png" />
        </Grid>
        <DockPanel>
          <TextBlock Text="{Binding Silver, Converter={StaticResource ShortNumberConverter},                                                          ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, Mode=OneWay, FallbackValue=-}"
                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                     TextAlignment="Right" />
          <TextBlock Text="/" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" FontWeight="Bold" Margin="2,0,2,0" />
          <TextBlock Text="{Binding SilverPerHour, Converter={StaticResource ShortNumberConverter},                                                          ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, Mode=OneWay, StringFormat='{}{0:N0}/h', FallbackValue=-}"
                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                     TextAlignment="Left" />
        </DockPanel>
      </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="DungeonFragment.Kill.Template" DataType="dungeonModels:DungeonBaseFragment">
      <StackPanel Orientation="Horizontal"
                  Height="20"
                  IsVisible="{Binding KillStatus, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='LocalPlayerDead=True|OpponentDead=True|*=False'}">
        <Image Height="18"
               Margin="0,2,5,0"
               Source="{Binding KillStatus, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='OpponentDead=avares://StatisticsAnalysisTool/Assets/skull_green.png|LocalPlayerDead=avares://StatisticsAnalysisTool/Assets/skull_red.png|*=avares://StatisticsAnalysisTool/Assets/skull.png'}" />
        <TextBlock Text="{Binding DiedName, Mode=OneWay}" Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" Margin="2,2,2,0" />
        <TextBlock Text="{x:Static dungeonModels:DungeonBaseFragment.TranslationKilledBy}"
                   Foreground="{DynamicResource SolidColorBrush.Text.1}"
                   Margin="2,2,2,0"
                   IsVisible="{Binding KilledByVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}" />
        <TextBlock Text="{Binding KilledBy, Mode=OneWay}" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" Margin="2,2,2,0" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="DungeonFragment.LootAndDeath.Template" DataType="dungeonModels:DungeonBaseFragment">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DungeonFragment.LootToggle.Template}" />
        <ContentControl Grid.Column="1"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          Content="{Binding}"
                          ContentTemplate="{StaticResource DungeonFragment.Kill.Template}" />
      </Grid>
    </DataTemplate>
    <!-- Dungeon fragments -->
    <ControlTheme x:Key="Dungeon.RunEntry.Card" TargetType="Border">
      <Setter Property="Margin" Value="4,0,4,7" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Background.2}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderBrush"
              Value="{Binding Status, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Active=@SolidColorBrush.Accent.Yellow.0|*=@SolidColorBrush.Border.2'}" />
      <Setter Property="BorderThickness"
              Value="{Binding Status, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Active=2|*=1'}" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.RunEntry.Divider" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Border.2}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.RunEntry.Badge" TargetType="Border">
      <Setter Property="Margin" Value="0,6,5,0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Background.1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Border.2}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.RunEntry.TierBadge" TargetType="Border" BasedOn="{StaticResource Dungeon.RunEntry.Badge}">
      <Setter Property="BorderBrush"
              Value="{Binding Tier, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='T1=@SolidColorBrush.Item.Tier.Color.1|T2=@SolidColorBrush.Item.Tier.Color.2|T3=@SolidColorBrush.Item.Tier.Color.3|T4=@SolidColorBrush.Item.Tier.Color.4|T5=@SolidColorBrush.Item.Tier.Color.5|T6=@SolidColorBrush.Item.Tier.Color.6|T7=@SolidColorBrush.Item.Tier.Color.7|T8=@SolidColorBrush.Item.Tier.Color.8'}" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.RunEntry.EnchantmentBadge" TargetType="Border" BasedOn="{StaticResource Dungeon.RunEntry.Badge}">
      <Setter Property="BorderBrush"
              Value="{Binding Level, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='0=@SolidColorBrush.Item.Level.Color.0|1=@SolidColorBrush.Item.Level.Color.1|2=@SolidColorBrush.Item.Level.Color.2|3=@SolidColorBrush.Item.Level.Color.3|4=@SolidColorBrush.Item.Level.Color.4'}" />
    </ControlTheme>
    <ControlTheme x:Key="Dungeon.RunEntry.MistsTypeBadge" TargetType="Border" BasedOn="{StaticResource Dungeon.RunEntry.Badge}">
      <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
    </ControlTheme>
    <DataTemplate x:Key="Dungeon.RunEntry.Metric.Template" DataType="dungeonModels:DungeonRunMetric">
      <Grid Height="21" Margin="0,0,0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="62" />
          <ColumnDefinition Width="77" />
        </Grid.ColumnDefinitions>
        <Image Source="{Binding IconPath, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}"
               Width="15"
               Height="15"
               Margin="0,0,7,0"
               VerticalAlignment="Center"
               IsVisible="{Binding IconVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding Label}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SolidColorBrush.Text.3}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2"
                   Text="{Binding Value, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}"
                   Margin="5,0,0,0"
                   FontSize="12"
                   FontWeight="SemiBold"
                   TextAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SolidColorBrush.Text.1}" />
        <TextBlock Grid.Column="3"
                   Margin="5,0,0,0"
                   FontSize="12"
                   TextAlignment="Right"
                   VerticalAlignment="Center"
                   Text="{Binding ValuePerHour, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, StringFormat='{}({0} /h)'}"
                   Foreground="{DynamicResource SolidColorBrush.Text.4}"
                   IsVisible="{Binding ValuePerHour, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='0=False|*=True'}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="Dungeon.RunEntry.ChestItem.Template" DataType="dungeonModels:Loot">
      <Grid Width="44" Height="44" Margin="0,0,0,0" ToolTip.Tip="{Binding Item?.LocalizedName}">
        <Image Margin="1" Source="{Binding Item?.Icon}" Stretch="Uniform" />
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,4,5"
                Padding="2,0"
                Background="{DynamicResource SolidColorBrush.Background.1}"
                CornerRadius="2">
          <TextBlock Text="{Binding Quantity, StringFormat='{}x{0}'}" FontSize="12" Foreground="{DynamicResource SolidColorBrush.Text.2}" />
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="Dungeon.RunEntry.Chest.Template" DataType="dungeonModels:DungeonLootGroup">
      <Border x:Name="ChestCard"
              Width="250"
              MinHeight="100"
              Margin="0,0,7,7"
              Padding="8"
              Background="{DynamicResource SolidColorBrush.Background.3}"
              BorderThickness="1"
              CornerRadius="4"
              BorderBrush="{Binding Rarity, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Common=@SolidColorBrush.Item.Level.Color.1|Uncommon=@SolidColorBrush.Item.Level.Color.2|Rare=@SolidColorBrush.Item.Level.Color.3|Legendary=@SolidColorBrush.Item.Level.Color.4|*=@SolidColorBrush.Border.2'}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="{Binding LootGroupIconPath, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}" Width="40" Height="40" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
              <Border Padding="5,2"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource SolidColorBrush.Background.1}"
                      BorderThickness="1"
                      CornerRadius="2"
                      Theme="{StaticResource Dungeon.RarityBadge}"
                      Classes.other="{Binding IsOtherLoot}">
                <TextBlock Text="{Binding BadgeText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
              </Border>
              <StackPanel Margin="1,4,0,0" Orientation="Horizontal">
                <TextBlock Text="{x:Static dungeonModels:DungeonBaseFragment.TranslationTotalValue}"
                           FontSize="12"
                           Foreground="{DynamicResource SolidColorBrush.Text.4}" />
                <TextBlock Margin="5,0,0,0"
                           Text="{Binding TotalValue, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SolidColorBrush.Text.2}" />
              </StackPanel>
            </StackPanel>
          </Grid>
          <Grid Margin="0,4,0,8" IsVisible="{Binding MostValuableItemVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Height="40" Width="40" Margin="0" Source="{Binding MostValuableItem?.Item?.Icon}" Stretch="Uniform" />
            <StackPanel Grid.Column="1" Margin="5,1,0,0">
              <TextBlock Text="{Binding MostValuableItem?.Item?.LocalizedName}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SolidColorBrush.Text.1}"
                         TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding MostValuableItem?.EstimatedMarketValue?.DoubleValue, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                           FontSize="12"
                           Foreground="{DynamicResource SolidColorBrush.Text.3}" />
                <TextBlock Margin="5,0,0,0"
                           Text="{Binding MostValuableItem?.Quantity, StringFormat='{}x{0}'}"
                           FontSize="12"
                           Foreground="{DynamicResource SolidColorBrush.Text.4}" />
              </StackPanel>
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding DisplayedAdditionalItems}"
                        ItemTemplate="{StaticResource Dungeon.RunEntry.ChestItem.Template}"
                        IsVisible="{Binding AdditionalItemsVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Button Margin="0,0,0,0"
                  Padding="5,2"
                  HorizontalAlignment="Left"
                  Command="{Binding ToggleAdditionalItems}"
                  IsVisible="{Binding AdditionalItemsToggleVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand"
                  Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}">
            <TextBlock Text="{Binding AdditionalItemsToggleText}" FontSize="12" />
          </Button>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="Dungeon.RunEntry.CombatEvent.Template" DataType="dungeonModels:DungeonCombatEvent">
      <Border MinWidth="100"
              MinHeight="40"
              Margin="0,0,5,5"
              Padding="5"
              Background="{DynamicResource SolidColorBrush.Background.3}"
              BorderThickness="1"
              CornerRadius="3"
              BorderBrush="{Binding Status, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='OpponentDead=@SolidColorBrush.Accent.Green.3|*=@SolidColorBrush.Accent.Red.3'}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Width="32"
                 Height="32"
                 VerticalAlignment="Top"
                 Source="{Binding Status, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='OpponentDead=avares://StatisticsAnalysisTool/Assets/skull_green.png|*=avares://StatisticsAnalysisTool/Assets/skull_red.png'}" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding DiedName}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SolidColorBrush.Text.1}"
                       TextTrimming="CharacterEllipsis" />
            <WrapPanel IsVisible="{Binding KilledByVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
              <TextBlock Text="{x:Static dungeonModels:DungeonBaseFragment.TranslationKilledBy}"
                         FontSize="12"
                         Foreground="{DynamicResource SolidColorBrush.Text.4}" />
              <TextBlock Margin="5,0,0,0"
                         Text="{Binding KilledBy}"
                         FontSize="12"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                         TextTrimming="CharacterEllipsis" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="Dungeon.ModernRunEntry.Template" DataType="dungeonModels:DungeonBaseFragment">
      <Border Theme="{StaticResource Dungeon.RunEntry.Card}">
        <Grid MinHeight="100">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" MinWidth="250" />
            <ColumnDefinition Width="100" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" IsHitTestVisible="False" Theme="{StaticResource DungeonFragment.Faction}" />
          <Grid Grid.Column="0" Margin="10,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="{Binding ContentIconPath, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}" Width="48" Height="48" VerticalAlignment="Top" Stretch="Uniform" />
            <StackPanel Grid.Column="1" Margin="4,0,0,0">
              <TextBlock Text="{Binding EnterDungeonFirstTime, StringFormat='{}{0:g}'}"
                         FontSize="9.5"
                         Foreground="{DynamicResource SolidColorBrush.Text.4}" />
              <TextBlock Margin="0,3,0,0"
                         Text="{Binding ContentDisplayName}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SolidColorBrush.Text.1}"
                         TextWrapping="Wrap" />
              <StackPanel Margin="0,3,0,0"
                          Orientation="Horizontal"
                          IsVisible="{Binding MapNameVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DungeonFragment.ClusterTypeIcon.Template}" />
                <TextBlock Margin="5,1,0,0"
                           Text="{Binding MainMapName}"
                           FontSize="10.5"
                           Foreground="{DynamicResource SolidColorBrush.Text.3}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <WrapPanel>
                <Border Theme="{StaticResource Dungeon.RunEntry.TierBadge}"
                        IsVisible="{Binding TierBadgeVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                  <TextBlock Text="{Binding TierDisplayText}"
                             FontSize="10.5"
                             FontWeight="SemiBold"
                             Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
                </Border>
                <Border Theme="{StaticResource Dungeon.RunEntry.EnchantmentBadge}"
                        IsVisible="{Binding EnchantmentBadgeVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                  <TextBlock Text="{Binding EnchantmentDisplayText}"
                             FontSize="10.5"
                             FontWeight="SemiBold"
                             Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
                </Border>
                <Border Theme="{StaticResource Dungeon.RunEntry.MistsTypeBadge}"
                        IsVisible="{Binding MistsTypeBadgeVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                  <TextBlock Text="{Binding MistsTypeDisplayText}"
                             FontSize="10.5"
                             FontWeight="SemiBold"
                             Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
                </Border>
              </WrapPanel>
            </StackPanel>
          </Grid>
          <Border Grid.Column="1" Theme="{StaticResource Dungeon.RunEntry.Divider}" Padding="10,8">
            <ItemsControl ItemsSource="{Binding PerformanceMetrics}" ItemTemplate="{StaticResource Dungeon.RunEntry.Metric.Template}" />
          </Border>
          <Border Grid.Column="2" Theme="{StaticResource Dungeon.RunEntry.Divider}" Padding="10,10,7,4">
            <StackPanel>
              <Grid IsVisible="{Binding LootGroupVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                <ItemsControl ItemsSource="{Binding DisplayedLootGroups}" ItemTemplate="{StaticResource Dungeon.RunEntry.Chest.Template}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Grid>
              <Button Margin="0,0,5,5"
                      Padding="10,5"
                      HorizontalAlignment="Left"
                      Command="{Binding ToggleAdditionalChests}"
                      IsVisible="{Binding AdditionalChestToggleVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                      Background="{DynamicResource SolidColorBrush.Background.3}"
                      BorderBrush="{DynamicResource SolidColorBrush.Border.2}"
                      Foreground="{DynamicResource SolidColorBrush.Text.2}"
                      Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Width="20" Height="20" Margin="5,0,5,0" />
                  <TextBlock Text="{Binding AdditionalChestToggleText}" VerticalAlignment="Center" Margin="0,0,5,0" />
                </StackPanel>
              </Button>
              <StackPanel IsVisible="{Binding CombatEventsVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                <ItemsControl ItemsSource="{Binding DisplayedCombatEvents}" ItemTemplate="{StaticResource Dungeon.RunEntry.CombatEvent.Template}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Margin="0,0,5,5"
                        Padding="5,2"
                        HorizontalAlignment="Left"
                        Command="{Binding ToggleAdditionalCombatEvents}"
                        IsVisible="{Binding AdditionalCombatEventsToggleVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}">
                  <TextBlock Text="{Binding AdditionalCombatEventsToggleText}" FontSize="12" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Theme="{StaticResource Dungeon.RunEntry.Divider}" Padding="10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <CheckBox HorizontalAlignment="Right" IsChecked="{Binding IsSelectedForDeletion}" ToolTip.Tip="{x:Static dungeonModels:DungeonBaseFragment.TranslationSelectToDelete}" />
              <StackPanel Grid.Row="1" Margin="0,4,0,0" Orientation="Horizontal">
                <fa:FontAwesomeImage Icon="SolidUsers" Width="17" Height="17" Foreground="{DynamicResource SolidColorBrush.Text.3}" />
                <TextBlock Margin="7,0,0,0" Text="{Binding PartySize}" FontWeight="SemiBold" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                <TextBlock Margin="5,1,0,0" Text="{x:Static dungeonModels:DungeonBaseFragment.TranslationPlayers}" FontSize="9.5" Foreground="{DynamicResource SolidColorBrush.Text.4}" />
              </StackPanel>
              <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                <fa:FontAwesomeImage Icon="RegularClock" Width="17" Height="17" Foreground="{DynamicResource SolidColorBrush.Text.3}" />
                <TextBlock Margin="7,0,0,0"
                           Text="{Binding TotalRunTimeInSeconds, Converter={StaticResource SecondsToTimeFormatConverter}}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SolidColorBrush.Text.1}" />
              </StackPanel>
              <WrapPanel Grid.Row="3" Margin="0,7,0,0">
                <StackPanel Margin="0,0,8,0"
                            Orientation="Horizontal"
                            IsVisible="{Binding FloorCountVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                  <fa:FontAwesomeImage Icon="SolidDungeon"
                                       Width="16"
                                       Height="16"
                                       Foreground="{DynamicResource SolidColorBrush.Text.3}"
                                       ToolTip.Tip="{x:Static dungeonModels:DungeonBaseFragment.TranslationNumberOfDungeonFloors}" />
                  <TextBlock Margin="5,0,0,0" Text="{Binding FloorCount}" Foreground="{DynamicResource SolidColorBrush.Text.2}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding DisplayedCheckPoints}"
                              ItemTemplate="{StaticResource Dungeon.CheckPoint.Template}"
                              IsVisible="{Binding CheckPointVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </WrapPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="DungeonOptionsObjectTemplate" DataType="dungeonModels:DungeonOptionsObject">
      <StackPanel>
        <CheckBox IsChecked="{Binding IsDungeonPlayerLootVisible}"
                  Content="{Binding TranslationDungeonPlayerLootVisible, FallbackValue=DUNGEON_PLAYER_LOOT_VISIBLE}"
                  HorizontalContentAlignment="Left" />
      </StackPanel>
    </DataTemplate>
  </Styles.Resources>
</Styles>
