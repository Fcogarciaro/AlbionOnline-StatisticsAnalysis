            <DockPanel Width="140">
              <TextBlock Text="{Binding MightAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,3">
            <Image Source="avares://StatisticsAnalysisTool/Resources/favor.png" Height="20" Width="20" Margin="5,0,5,0" />
            <TextBlock Width="140"
                       Text="{Binding Favor, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                       Theme="{StaticResource Dungeons.Stats.Value}" />
            <DockPanel Width="140">
              <TextBlock Text="{Binding FavorPerHour, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
            <DockPanel Width="140">
              <TextBlock Text="{Binding FavorAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,3">
            <Image Source="avares://StatisticsAnalysisTool/Resources/silver.png" Height="20" Width="20" Margin="5,0,5,0" />
            <TextBlock Width="140"
                       Text="{Binding Silver, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                       Theme="{StaticResource Dungeons.Stats.Value}" />
            <DockPanel Width="140">
              <TextBlock Text="{Binding SilverPerHour, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
            <DockPanel Width="140">
              <TextBlock Text="{Binding SilverAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,3">
            <Image Source="avares://StatisticsAnalysisTool/Assets/bag.png" Height="20" Width="20" Margin="5,0,5,0" />
            <TextBlock Width="140"
                       Text="{Binding LootInSilver, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                       Theme="{StaticResource Dungeons.Stats.Value}" />
            <DockPanel Width="140">
              <TextBlock Text="{Binding LootInSilverPerHour, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
            <DockPanel Width="140">
              <TextBlock Text="{Binding LootInSilverAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
        </StackPanel>
        <!-- Most valuable loot -->
        <TextBlock Text="{x:Static dungeonModels:DungeonBaseFragment.TranslationMostValuableLoot}"
                   FontSize="16"
                   Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
        <StackPanel Orientation="Horizontal">
          <Image Source="{Binding MostValuableLoot?.Item?.Icon}" Height="34" ToolTip.Tip="{x:Static dungeonModels:DungeonBaseFragment.TranslationMostValuableLoot}" />
          <StackPanel Orientation="Vertical" Height="32" Width="200">
            <TextBlock Padding="0" Text="{Binding MostValuableLoot?.Item?.LocalizedName}" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
            <TextBlock Padding="0"
                       Text="{Binding MostValuableLoot?.EstimatedMarketValue?.DoubleValue, StringFormat='{}{0:N0}'}"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="Stats.Solo.Template" DataType="dungeonModels:StatsSolo">
      <StackPanel Orientation="Vertical" IsVisible="{Binding Visibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
        <TextBlock Theme="{StaticResource TitleText}" Text="{x:Static dungeonModels:DungeonBaseFragment.TranslationSoloDungeon}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,20">
          <!-- Entered dungeons -->
          <StackPanel Orientation="Vertical">
            <TextBlock Text="" FontSize="16" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
            <StackPanel Orientation="Horizontal" Height="60" Width="60" Margin="0,0,0,0">
              <StackPanel Orientation="Vertical" Width="40">
                <Image Source="avares://StatisticsAnalysisTool/Assets/dungeon.png"
                       Height="30"
                       Width="30"
                       Margin="0,6,0,4"
                       ToolTip.Tip="{Binding TranslationNumberOfDungeons}" />
                <TextBlock Text="{Binding Entered, FallbackValue=0}" Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <!-- Entered type -->
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{Binding TranslationType, FallbackValue=TYPE}"
                       FontSize="16"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                       Margin="10,0,0,0" />
            <StackPanel Orientation="Horizontal" Height="60" Margin="0,0,0,0">
              <StackPanel Orientation="Vertical" Width="40">
                <Image Source="avares://StatisticsAnalysisTool/Assets/butterfly_common.png" Height="40" Width="40" />
                <TextBlock Text="{Binding EnteredCommon, FallbackValue=0}" Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Width="40">
                <Image Source="avares://StatisticsAnalysisTool/Assets/butterfly_uncommon.png" Height="40" Width="40" />
                <TextBlock Text="{Binding EnteredUncommon, FallbackValue=0}" Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Width="40">
                <Image Source="avares://StatisticsAnalysisTool/Assets/butterfly_rare.png" Height="40" Width="40" />
                <TextBlock Text="{Binding EnteredRare, FallbackValue=0}" Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Width="40">
                <Image Source="avares://StatisticsAnalysisTool/Assets/butterfly_epic.png" Height="40" Width="40" />
                <TextBlock Text="{Binding EnteredEpic, FallbackValue=0}" Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Width="40">
                <Image Source="avares://StatisticsAnalysisTool/Assets/butterfly_legendary.png" Height="40" Width="40" />
                <TextBlock Text="{Binding EnteredLegendary, FallbackValue=0}" Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Rectangle VerticalAlignment="Stretch" Fill="{DynamicResource SolidColorBrush.Background.3}" Width="1" Margin="10,0" />
          <!-- Opened chests -->
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{Binding TranslationChestStats, FallbackValue=CHEST_STATS}"
                       FontSize="16"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                       Margin="10,0,0,0" />
            <StackPanel Orientation="Horizontal">
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedStandardChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/green_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedStandardChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedUncommonChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/blue_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedUncommonChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedRareChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/purple_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedRareChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedLegendaryChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/gold_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedLegendaryChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Rectangle VerticalAlignment="Stretch" Fill="{DynamicResource SolidColorBrush.Background.3}" Width="1" Margin="10,0" />
          <!-- Opened book chests -->
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{Binding TranslationBookChestStats, FallbackValue=BOOK_CHEST_STATS}"
                       FontSize="16"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                       Margin="10,0,0,0" />
            <StackPanel Orientation="Horizontal">
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedStandardChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/book_oblique.png" Height="20" Width="20" Margin="0,0,2,15" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/green_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedStandardBookChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedUncommonChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/book_oblique.png" Height="20" Width="20" Margin="0,0,2,15" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/blue_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedUncommonBookChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="5,0">
                <Grid Height="40" Width="40" ToolTip.Tip="{Binding TranslationOpenedRareChests}">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Height="26" Width="26" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/book_oblique.png" Height="20" Width="20" Margin="0,0,2,15" />
                  <Image Source="avares://StatisticsAnalysisTool/Assets/purple_glow.png" Height="40" Width="40" Opacity="0.4" />
                </Grid>
                <TextBlock Text="{Binding OpenedRareBookChests, StringFormat='{}{0:N0}', FallbackValue=0}"
                           Theme="{StaticResource Dungeons.Stats.Value.Big}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <!-- Fame, ReSpec, Silver, Might, Favor, Loot value, table -->
        <StackPanel Orientation="Vertical" Margin="0,0,0,20">
          <StackPanel Orientation="Horizontal" Height="20">
            <Grid Width="34" />
            <TextBlock Width="140"
                       FontSize="14"
                       Text="{Binding TranslationTotal, FallbackValue='TOTAL'}"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
            <TextBlock Width="140"
                       FontSize="14"
                       Text="{Binding TranslationPerHour, FallbackValue='PER_HOUR'}"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
            <TextBlock Width="140"
                       FontSize="14"
                       Text="{Binding TranslationAverage, FallbackValue='AVERAGE'}"
                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,3">
            <Image Source="avares://StatisticsAnalysisTool/Resources/fame.png" Height="20" Width="20" Margin="5,0,5,0" />
            <TextBlock Width="140"
                       Text="{Binding Fame, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                       Theme="{StaticResource Dungeons.Stats.Value}" />
            <DockPanel Width="140">
              <TextBlock Text="{Binding FamePerHour, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
            <DockPanel Width="140">
              <TextBlock Text="{Binding FameAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,3">
            <Image Source="avares://StatisticsAnalysisTool/Resources/respec.png" Height="20" Width="20" Margin="5,0,5,0" />
            <TextBlock Width="140"
                       Text="{Binding ReSpec, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                       Theme="{StaticResource Dungeons.Stats.Value}" />
            <DockPanel Width="140">
              <TextBlock Text="{Binding ReSpecPerHour, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
            <DockPanel Width="140">
              <TextBlock Text="{Binding ReSpecAverage, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationAverageAbbreviation, FallbackValue='Avg.'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="5,0"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" />
            </DockPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,3">
            <Image Source="avares://StatisticsAnalysisTool/Resources/might.png" Height="20" Width="20" Margin="5,0,5,0" />
            <TextBlock Width="140"
                       Text="{Binding Might, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                       Theme="{StaticResource Dungeons.Stats.Value}" />
            <DockPanel Width="140">
              <TextBlock Text="{Binding MightPerHour, Converter={StaticResource ShortNumberConverter}, FallbackValue='0'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Padding="0"
                         Margin="0" />
              <TextBlock Text="{Binding TranslationHourAbbreviation, FallbackValue='/h', StringFormat='{}/{0}'}"
                         Theme="{StaticResource Dungeons.Stats.Value}"
                         Margin="0,0"
