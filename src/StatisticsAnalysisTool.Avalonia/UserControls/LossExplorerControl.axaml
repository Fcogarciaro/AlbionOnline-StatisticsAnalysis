<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:crafting="clr-namespace:StatisticsAnalysisTool.Crafting"
             xmlns:translation="clr-namespace:StatisticsAnalysisTool.Models.TranslationModel"
             xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
             xmlns:common="clr-namespace:StatisticsAnalysisTool.Common"
             x:CompileBindings="False"
             x:Class="StatisticsAnalysisTool.UserControls.LossExplorerControl">
  <UserControl.Resources>
    <ControlTheme x:Key="LossExplorer.Card" TargetType="Border">
      <Setter Property="Width" Value="205" />
      <Setter Property="Height" Value="260" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Background.2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Background.4}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
    </ControlTheme>
    <ControlTheme x:Key="LossExplorer.Badge" TargetType="Border">
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Background" Value="{DynamicResource SolidColorBrush.Background.3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SolidColorBrush.Text.4}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
    </ControlTheme>
    <ControlTheme x:Key="LossExplorer.TierBadge" TargetType="Border" BasedOn="{StaticResource LossExplorer.Badge}">
      <Setter Property="BorderBrush"
              Value="{Binding Tier, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='1=@SolidColorBrush.Item.Tier.Color.1|2=@SolidColorBrush.Item.Tier.Color.2|3=@SolidColorBrush.Item.Tier.Color.3|4=@SolidColorBrush.Item.Tier.Color.4|5=@SolidColorBrush.Item.Tier.Color.5|6=@SolidColorBrush.Item.Tier.Color.6|7=@SolidColorBrush.Item.Tier.Color.7|8=@SolidColorBrush.Item.Tier.Color.8'}" />
    </ControlTheme>
    <ControlTheme x:Key="LossExplorer.EnchantmentBadge" TargetType="Border" BasedOn="{StaticResource LossExplorer.Badge}">
      <Setter Property="BorderBrush"
              Value="{Binding EnchantmentLevel, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='0=@SolidColorBrush.Item.Level.Color.0|1=@SolidColorBrush.Item.Level.Color.1|2=@SolidColorBrush.Item.Level.Color.2|3=@SolidColorBrush.Item.Level.Color.3|4=@SolidColorBrush.Item.Level.Color.4'}" />
    </ControlTheme>
    <ControlTheme x:Key="LossExplorer.QualityBadge" TargetType="Border" BasedOn="{StaticResource LossExplorer.Badge}">
      <Setter Property="BorderBrush"
              Value="{Binding QualityLevel, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='1=@SolidColorBrush.Item.Quality.Color.1|2=@SolidColorBrush.Item.Quality.Color.2|3=@SolidColorBrush.Item.Quality.Color.3|4=@SolidColorBrush.Item.Quality.Color.4|5=@SolidColorBrush.Item.Quality.Color.5'}" />
    </ControlTheme>
    <DataTemplate x:Key="LossExplorer.ItemTemplate" DataType="crafting:LossExplorerItemRow">
      <Border Theme="{StaticResource LossExplorer.Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="*" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0"
                     Text="{Binding ItemName}"
                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="1"
                     Margin="0,2,0,0"
                     Text="{Binding ItemUniqueName}"
                     Foreground="{DynamicResource SolidColorBrush.Text.3}"
                     FontSize="10"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Row="2" Margin="0,7,0,4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Border Theme="{StaticResource LossExplorer.TierBadge}">
              <TextBlock Text="{Binding TierText}"
                         FontSize="11"
                         FontWeight="Bold"
                         Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
            </Border>
            <Border Theme="{StaticResource LossExplorer.EnchantmentBadge}">
              <TextBlock Text="{Binding EnchantmentText}"
                         FontSize="11"
                         FontWeight="Bold"
                         Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
            </Border>
            <Border Theme="{StaticResource LossExplorer.QualityBadge}">
              <TextBlock Text="{Binding QualityName}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
            </Border>
          </StackPanel>
          <Image Grid.Row="3" Width="96" Height="96" Source="{Binding Icon}" Stretch="Uniform" />
          <StackPanel Grid.Row="4" Margin="0,6,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="avares://StatisticsAnalysisTool/Resources/silver.png" Width="18" Height="18" Margin="0,0,6,0" Stretch="Uniform" />
            <TextBlock Text="{Binding TotalValueText}"
                       Foreground="{DynamicResource SolidColorBrush.Text.1}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Row="5"
                     Margin="0,1,0,0"
                     Text="{Binding UnitValueText}"
                     Foreground="{DynamicResource SolidColorBrush.Text.3}"
                     FontSize="11"
                     HorizontalAlignment="Center" />
          <TextBlock Grid.Row="6"
                     Margin="0,3,0,0"
                     Text="{Binding QuantityText}"
                     Foreground="{DynamicResource SolidColorBrush.Text.2}"
                     FontSize="12"
                     HorizontalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="10" DataContext="{Binding CraftingBindings.LossExplorer}">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Theme="{StaticResource App.TopFilterCard}" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="4,0,4,6" VerticalAlignment="Bottom">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="*" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <fa:FontAwesomeImage Grid.Column="0"
                               Icon="SolidMagnifyingGlass"
                               Width="16"
                               Height="16"
                               Margin="0,0,9,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SolidColorBrush.Text.2}" />
          <TextBox Grid.Column="1"
                   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip.Tip="{x:Static translation:MainWindowTranslation.Search}"
                   Theme="{StaticResource ItemSearchTextBoxStyle}" />
          <Button Grid.Column="2"
                  Width="32"
                  Height="32"
                  Margin="6,0,0,0"
                  Padding="0"
                  ToolTip.Tip="{x:Static translation:MainWindowTranslation.ResetFilters}"
                  Theme="{StaticResource Style.Button.Neutral}"
                  Click="LossExplorerFilterReset_Click">
            <fa:FontAwesomeImage Icon="SolidRotateRight"
                                 Width="14"
                                 Height="14"
                                 IsHitTestVisible="False"
                                 Foreground="{DynamicResource SolidColorBrush.Text.1}" />
          </Button>
        </Grid>
        <UniformGrid Grid.Column="1" Columns="4">
          <StackPanel Theme="{StaticResource ItemSearch.FilterField}">
            <TextBlock Text="{x:Static translation:MainWindowTranslation.ShopCategory}" Theme="{StaticResource App.FilterLabel}" />
            <ComboBox ItemsSource="{Binding ItemShopCategories}"
                      SelectedItem="{Binding SelectedItemShopCategory, Mode=TwoWay}"
                      SelectedValueBinding="{ReflectionBinding Id}"
                      DisplayMemberBinding="{ReflectionBinding DisplayName}"
                      Theme="{StaticResource ItemSearch.FilterComboBox}" />
          </StackPanel>
          <StackPanel Theme="{StaticResource ItemSearch.FilterField}">
            <TextBlock Text="{x:Static translation:MainWindowTranslation.Tier}" Theme="{StaticResource App.FilterLabel}" />
            <ComboBox ItemsSource="{Binding ItemTiers}"
                      SelectedValue="{Binding SelectedItemTier, Mode=TwoWay}"
                      SelectedValueBinding="{ReflectionBinding Key}"
                      DisplayMemberBinding="{ReflectionBinding Value}"
                      Theme="{StaticResource ItemSearch.FilterComboBox}" />
          </StackPanel>
          <StackPanel Theme="{StaticResource ItemSearch.FilterField}">
            <TextBlock Text="{x:Static translation:MainWindowTranslation.Enchantment}" Theme="{StaticResource App.FilterLabel}" />
            <ComboBox ItemsSource="{Binding ItemLevels}"
                      SelectedValue="{Binding SelectedItemLevel, Mode=TwoWay}"
                      SelectedValueBinding="{ReflectionBinding Key}"
                      DisplayMemberBinding="{ReflectionBinding Value}"
                      Theme="{StaticResource ItemSearch.FilterComboBox}" />
          </StackPanel>
          <StackPanel Theme="{StaticResource ItemSearch.FilterField}">
            <TextBlock Text="{x:Static crafting:LossExplorerBindings.TranslationQuality}" Theme="{StaticResource App.FilterLabel}" />
            <ComboBox ItemsSource="{Binding ItemQualities}"
                      SelectedValue="{Binding SelectedItemQuality, Mode=TwoWay}"
                      SelectedValueBinding="{ReflectionBinding Key}"
                      DisplayMemberBinding="{ReflectionBinding Value}"
                      Theme="{StaticResource ItemSearch.FilterComboBox}" />
          </StackPanel>
        </UniformGrid>
      </Grid>
    </Border>
    <Border Grid.Row="1"
            Margin="0,0,0,8"
            Padding="10,6"
            Background="{DynamicResource SolidColorBrush.Background.2}"
            BorderBrush="{DynamicResource SolidColorBrush.Background.4}"
            BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition />
          <ColumnDefinition Width="160" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding StatusText}"
                   Foreground="{DynamicResource SolidColorBrush.Text.2}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1"
                   Margin="16,0,0,0"
                   Text="{Binding StoredEventCountText}"
                   Foreground="{DynamicResource SolidColorBrush.Text.1}"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <ProgressBar Grid.Column="2" Height="4" Margin="10,0,0,0" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>
    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
      <TabItem Header="{x:Static crafting:LossExplorerBindings.TranslationEquipment}">
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{Binding EquipmentItems}" ItemTemplate="{StaticResource LossExplorer.ItemTemplate}">
              <ItemsRepeater.Layout>
                <WrapLayout />
              </ItemsRepeater.Layout>
            </ItemsRepeater>
          </ScrollViewer>
          <TextBlock Text="{x:Static crafting:LossExplorerBindings.TranslationNoData}"
                     Foreground="{DynamicResource SolidColorBrush.Text.3}"
                     FontSize="16"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="{Binding HasEquipmentItems, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=False|*=True'}" />
        </Grid>
      </TabItem>
      <TabItem Header="{x:Static crafting:LossExplorerBindings.TranslationInventory}">
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{Binding InventoryItems}" ItemTemplate="{StaticResource LossExplorer.ItemTemplate}">
              <ItemsRepeater.Layout>
                <WrapLayout />
              </ItemsRepeater.Layout>
            </ItemsRepeater>
          </ScrollViewer>
          <TextBlock Text="{x:Static crafting:LossExplorerBindings.TranslationNoData}"
                     Foreground="{DynamicResource SolidColorBrush.Text.3}"
                     FontSize="16"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="{Binding HasInventoryItems, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=False|*=True'}" />
        </Grid>
      </TabItem>
      <TabItem Header="{x:Static crafting:LossExplorerBindings.TranslationCrafting}">
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{Binding CraftingItems}" ItemTemplate="{StaticResource LossExplorer.ItemTemplate}">
              <ItemsRepeater.Layout>
                <WrapLayout />
              </ItemsRepeater.Layout>
            </ItemsRepeater>
          </ScrollViewer>
          <TextBlock Text="{x:Static crafting:LossExplorerBindings.TranslationNoData}"
                     Foreground="{DynamicResource SolidColorBrush.Text.3}"
                     FontSize="16"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="{Binding HasCraftingItems, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='True=False|*=True'}" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
