<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             x:Class="StatisticsAnalysisTool.UserControls.MapHistoryControl"
             x:DataType="viewModels:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="0" />
            <RowDefinition Height="30" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="40">
            <Button x:Name="BtnCopySelectedMapHistoryToClipboard"
                    Content="{Binding Translation.CopyToClipboard, FallbackValue=COPY__TO__CLIPBOARD}"
                    ContentTemplate="{StaticResource Template.Button.Content.Spacious}"
                    Margin="5,0"
                    IsEnabled="False"
                    Click="BtnCopySelectedMapHistoryToClipboard_Click" />
            <Button Content="{Binding Translation.DeleteAllMapHistoryEntries, FallbackValue=DELETE__ALL__MAP__HISTORY__ENTRIES}"
                    ContentTemplate="{StaticResource Template.Button.Content.Spacious}"
                    Margin="5,0"
                    Theme="{StaticResource Style.Button.Danger}"
                    Click="BtnDeleteAllMapHistoryEntries_Click" />
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource SolidColorBrush.Background.3}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="35" />
                    <ColumnDefinition Width="149" />
                    <ColumnDefinition Width="149" />
                    <ColumnDefinition Width="149" />
                    <ColumnDefinition Width="149" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1" Text="{Binding Translation.Time, FallbackValue=TIME}" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                <TextBlock Grid.Column="2" Text="{Binding Translation.Tier, FallbackValue=TIER}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                <TextBlock Grid.Column="3" Text="{Binding Translation.Zone, FallbackValue=ZONE}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                <TextBlock Grid.Column="4" Text="{Binding Translation.Name, FallbackValue=NAME}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                <TextBlock Grid.Column="5" Text="{Binding Translation.Type, FallbackValue=TYPE}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                <TextBlock Grid.Column="6" Text="{Binding Translation.Note, FallbackValue=NOTE}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource SolidColorBrush.Text.1}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
            <ItemsControl ItemsSource="{Binding EnteredCluster, Mode=OneWay}" ItemTemplate="{StaticResource ClusterInfoTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
