<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:userControls="clr-namespace:StatisticsAnalysisTool.UserControls"
             xmlns:controls="clr-namespace:StatisticsAnalysisTool.Common.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
             xmlns:common="clr-namespace:StatisticsAnalysisTool.Common"
             x:CompileBindings="False"
             x:Class="StatisticsAnalysisTool.UserControls.ItemDetailsControl">
  <UserControl.Styles>
    <Style Selector="fa|FontAwesomeImage.refresh:disabled">
      <Setter Property="Opacity" Value="0.35" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="105" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Theme="{StaticResource ItemDetails.BorderColor.ItemLevel.Style}" DataContext="{Binding Item}" />
    <Grid Grid.Row="0">
      <Image Source="{Binding Icon}" HorizontalAlignment="Left" Height="88" Margin="10,8,0,0" VerticalAlignment="Top" Width="88" />
      <StackPanel Margin="108,6,10,4">
        <StackPanel Orientation="Horizontal" Height="24">
          <TextBlock Text="{Binding TitleName, FallbackValue=TITLE__NAME}"
                     FontSize="16"
                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                     FontWeight="Bold"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding ItemTierLevel, FallbackValue=T0.0}"
                     FontSize="16"
                     Margin="5,0,0,0"
                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                     FontWeight="Bold"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="22" Margin="0,1,0,0">
          <Border Background="{DynamicResource SolidColorBrush.Background.2}"
                  BorderBrush="{DynamicResource SolidColorBrush.Text.4}"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="5,1"
                  Margin="0,0,5,0">
            <TextBlock Text="{Binding ItemTier, FallbackValue=-}" Foreground="{DynamicResource SolidColorBrush.Text.1}" FontSize="11" />
          </Border>
          <Border Background="{DynamicResource SolidColorBrush.Background.2}"
                  BorderBrush="{DynamicResource SolidColorBrush.Text.4}"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="5,1"
                  Margin="0,0,5,0">
            <TextBlock Text="{Binding ItemCategoryName, FallbackValue=-}" Foreground="{DynamicResource SolidColorBrush.Text.1}" FontSize="11" />
          </Border>
          <Border Background="{DynamicResource SolidColorBrush.Background.2}"
                  BorderBrush="{DynamicResource SolidColorBrush.Text.4}"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="5,1">
            <TextBlock Text="{Binding ItemTypeName, FallbackValue=-}" Foreground="{DynamicResource SolidColorBrush.Text.1}" FontSize="11" />
          </Border>
        </StackPanel>
        <TextBlock Text="{Binding ItemUniqueName, FallbackValue=-}"
                   Foreground="{DynamicResource SolidColorBrush.Text.2}"
                   FontSize="11"
                   Height="18"
                   VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Height="20">
          <TextBlock Text="{Binding LastUpdatedText, FallbackValue=LAST__UPDATE: -}"
                     Foreground="{DynamicResource SolidColorBrush.Text.2}"
                     FontSize="11"
                     VerticalAlignment="Center" />
          <controls:FontAwesomeImage Icon="SolidArrowsRotate"
                                     Width="14"
                                     Height="14"
                                     Margin="6,0,0,0"
                                     ToolTip.Tip="{Binding LastUpdatedText, FallbackValue=LAST__UPDATE: -}"
                                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                                     VerticalAlignment="Center"
                                     IsEnabled="{Binding CanRefreshManually}"
                                     PointerPressed="Refresh_PointerPressed"
                           Classes="refresh" Cursor="Hand">
          </controls:FontAwesomeImage>
        </StackPanel>
      </StackPanel>
      <ProgressBar Margin="0,0,0,0"
                   Height="1"
                   Minimum="{Binding TaskProgressbarMinimum}"
                   Maximum="{Binding TaskProgressbarMaximum}"
                   Value="{Binding TaskProgressbarValue}"
                   IsIndeterminate="{Binding IsTaskProgressbarIndeterminate}"
                   VerticalAlignment="Top" />
    </Grid>
    <TabControl Grid.Row="1" Background="Transparent" Margin="0">
      <TabItem Header="{Binding Translation?.Main, FallbackValue=MAIN}">
        <Grid Margin="4">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="2*" MinHeight="175" />
            <RowDefinition Height="6" />
            <RowDefinition Height="3*" MinHeight="220" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Theme="{StaticResource ItemDetails.Filter.Border}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Translation?.Location, FallbackValue=LOCATION}"
                           Foreground="{DynamicResource SolidColorBrush.Text.2}"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <ComboBox Width="170" Height="26" ItemsSource="{Binding LocationFilters}" ItemTemplate="{StaticResource LocationFilterObjectTemplate}" />
                <Border Width="1" Margin="10,2" Background="{DynamicResource SolidColorBrush.Background.4}" />
                <TextBlock Text="{Binding Translation?.Quality, FallbackValue=QUALITY}"
                           Foreground="{DynamicResource SolidColorBrush.Text.2}"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <ListBox ItemsSource="{Binding MainTabBindings?.Qualities}"
                         SelectedItem="{Binding MainTabBindings?.QualitiesSelection, Mode=TwoWay}"
                         DisplayMemberBinding="{ReflectionBinding Name}"
                         SelectionMode="Single"
                         Theme="{StaticResource ItemDetails.Filter.ListBox}"
                         ItemContainerTheme="{StaticResource ItemDetails.Filter.ListBoxItem}" />
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Border Grid.Row="1" Theme="{StaticResource ItemDetails.Section.Border}">
            <DataGrid x:Name="ItemPricesGrid" RowHeight="NaN" HorizontalScrollBarVisibility="Auto" CanUserSortColumns="True" Sorting="ItemPricesGrid_OnSorting">
        <DataGrid.Columns>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumnCityTemplate}" Tag="LocationName" CanUserSort="True">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.Location, FallbackValue=LOCATION}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumnSellPriceMinTemplate}" Tag="SellPriceMin" CanUserSort="True">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.SellPriceMin, FallbackValue=SELL_PRICE_MIN}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumnSellPriceMinDateTemplate}" Tag="SellPriceMinDate" CanUserSort="True">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.SellPriceMinDate, FallbackValue=SELL_PRICE_MIN_DATE}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumnSellPriceMaxTemplate}" Tag="SellPriceMax" CanUserSort="True">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.SellPriceMax, FallbackValue=SELL_PRICE_MAX}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumnSellPriceMaxDateTemplate}" Tag="SellPriceMaxDate" CanUserSort="True">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.SellPriceMaxDate, FallbackValue=SELL_PRICE_MAX_DATE}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumnBuyPriceMinTemplate}" Tag="BuyPriceMin" CanUserSort="True">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.BuyPriceMin, FallbackValue=BUY_PRICE_MIN}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumnBuyPriceMinDateTemplate}" Tag="BuyPriceMinDate" CanUserSort="True">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.BuyPriceMinDate, FallbackValue=BUY_PRICE_MIN_DATE}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumnBuyPriceMaxTemplate}" Tag="BuyPriceMax" CanUserSort="True">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.BuyPriceMax, FallbackValue=BUY_PRICE_MAX}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumnBuyPriceMaxDateTemplate}" Tag="BuyPriceMaxDate" CanUserSort="True">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.BuyPriceMaxDate, FallbackValue=BUY_PRICE_MAX_DATE}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
          </Border>
          <GridSplitter Grid.Row="2"
                        Height="6"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        ResizeDirection="Rows"
                        ResizeBehavior="PreviousAndNext" />
          <Border Grid.Row="3" Theme="{StaticResource ItemDetails.Section.Border}" Margin="0,6,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel Margin="10,5,8,0">
                <ListBox DockPanel.Dock="Right"
                         ItemsSource="{Binding HistoryBindings?.TimeRanges}"
                         SelectedItem="{Binding HistoryBindings?.SelectedTimeRange, Mode=TwoWay}"
                         DisplayMemberBinding="{ReflectionBinding Name}"
                         SelectionMode="Single"
                         Theme="{StaticResource ItemDetails.Filter.ListBox}"
                         ItemContainerTheme="{StaticResource ItemDetails.Filter.ListBoxItem}" />
                <TextBlock Text="{Binding Translation?.History, FallbackValue=HISTORY}"
                           Foreground="{DynamicResource SolidColorBrush.Text.1}"
                           FontWeight="Bold"
                           FontSize="13"
                           VerticalAlignment="Center" />
              </DockPanel>
              <lvc:CartesianChart Grid.Row="1"
                                  Series="{Binding HistoryBindings?.SeriesHistory}"
                                  XAxes="{Binding HistoryBindings?.XAxesHistory}"
                                  TooltipPosition="Center"
                                  FindingStrategy="ExactMatchTakeClosest"
                                  LegendPosition="Top"
                                  LegendTextPaint="{Binding HistoryLegendTextPaint}"
                                  LegendTextSize="14"
                                  Background="Transparent"
                                  Margin="6,0,6,4"
                                  DrawMarginFrame="{x:Null}" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding Translation?.Quality, FallbackValue=QUALITY}" ToolTip.Tip="{Binding Translation?.TabAllQualityToolTipDescription}">
        <Grid Margin="4">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Theme="{StaticResource ItemDetails.Filter.Border}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Translation?.Location, FallbackValue=LOCATION}"
                           Foreground="{DynamicResource SolidColorBrush.Text.2}"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <ComboBox Width="170" Height="26" ItemsSource="{Binding LocationFilters}" ItemTemplate="{StaticResource LocationFilterObjectTemplate}" />
              </StackPanel>
            </ScrollViewer>
          </Border>
          <DataGrid Grid.Row="1" ItemsSource="{Binding QualityTabBindings?.Prices}" RowHeight="NaN" HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumn.CityForMarketQualityObjectTemplate}">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.Location, FallbackValue=LOCATION}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumn.SellPriceMinNormalTemplate}">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.Normal, FallbackValue=NORMAL}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumn.SellPriceMinGoodTemplate}">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.Good, FallbackValue=GOOD}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumn.SellPriceMinOutstandingTemplate}">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.Outstanding, FallbackValue=OUTSTANDING}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumn.SellPriceMinExcellentTemplate}">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.Excellent, FallbackValue=EXCELLENT}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumn.SellPriceMinMasterpieceTemplate}">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.Masterpiece, FallbackValue=MASTERPIECE}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding Translation?.RealMoneyPrice, FallbackValue=REAL_MONEY_PRICE}">
        <Grid Margin="4">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Theme="{StaticResource ItemDetails.Filter.Border}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Translation?.Location, FallbackValue=LOCATION}"
                           Foreground="{DynamicResource SolidColorBrush.Text.2}"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <ComboBox Width="170" Height="26" ItemsSource="{Binding LocationFilters}" ItemTemplate="{StaticResource LocationFilterObjectTemplate}" />
              </StackPanel>
            </ScrollViewer>
          </Border>
          <DataGrid Grid.Row="1" ItemsSource="{Binding QualityTabBindings?.Prices}" RowHeight="NaN" HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumnCityTemplate}">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.City, FallbackValue=CITY}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumn.SellPriceMinNormalRmTemplate}">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.Normal, FallbackValue=NORMAL}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumn.SellPriceMinGoodRmTemplate}">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.Good, FallbackValue=GOOD}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumn.SellPriceMinOutstandingRmTemplate}">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.Outstanding, FallbackValue=OUTSTANDING}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumn.SellPriceMinExcellentRmTemplate}">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.Excellent, FallbackValue=EXCELLENT}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn CellTemplate="{StaticResource GridViewColumn.SellPriceMinMasterpieceRmTemplate}">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding Translation?.Masterpiece, FallbackValue=MASTERPIECE}" />
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding Translation?.Monitoring, FallbackValue=MONITORING}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="{Binding Translation?.MonitoringDescription, FallbackValue=ITEM_MONITORING_DESCRIPTION}"
                       Foreground="{DynamicResource SolidColorBrush.Text.2}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
            <Border Theme="{StaticResource ItemDetails.Section.Border}" Margin="0,0,0,10">
              <Grid Margin="14">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                  <controls:FontAwesomeImage Icon="SolidTag"
                                             Width="16"
                                             Height="16"
                                             Margin="0,0,8,0"
                                             Foreground="{DynamicResource SolidColorBrush.Accent.Yellow.1}" />
                  <TextBlock Text="{Binding Translation?.PriceMonitoring, FallbackValue=PRICE_MONITORING}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             FontWeight="Bold"
                             FontSize="14" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Text="{Binding Translation?.PriceMonitoringDescription, FallbackValue=PRICE_MONITORING_DESCRIPTION}"
                           Foreground="{DynamicResource SolidColorBrush.Text.2}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,10" />
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                  <TextBlock Text="{Binding Translation?.PriceLimit, FallbackValue=PRICE_LIMIT}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                  <controls:DigitsTextBox Text="{Binding PriceAlertThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsPriceAlertInactive}"
                                          MaxLength="20"
                                          Width="150"
                                          Height="26" />
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="{Binding Translation?.MaximumPriceAge, FallbackValue=MAXIMUM_PRICE_AGE}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                  <controls:DigitsTextBox Text="{Binding PriceAlertMaximumPriceAgeMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsPriceAlertInactive}"
                                          MaxLength="10"
                                          Width="100"
                                          Height="26" />
                  <TextBlock Text="{Binding Translation?.Minutes, FallbackValue=MINUTES}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0" />
                </StackPanel>
                <CheckBox Grid.Row="4"
                          Content="{Binding Translation?.IsAlertActive, FallbackValue=IS_ALERT_ACTIVE}"
                          IsChecked="{Binding IsPriceAlertActive, Mode=OneWay}"
                          Click="PriceAlert_Click"
                          Margin="0,12,0,0" />
              </Grid>
            </Border>
            <Border Theme="{StaticResource ItemDetails.Section.Border}" Margin="0,0,0,10">
              <Grid Margin="14">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                  <controls:FontAwesomeImage Icon="SolidMagnifyingGlass"
                                             Width="16"
                                             Height="16"
                                             Margin="0,0,8,0"
                                             Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
                  <TextBlock Text="{Binding Translation?.MarketAvailability, FallbackValue=MARKET_AVAILABILITY}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             FontWeight="Bold"
                             FontSize="14" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Text="{Binding Translation?.MarketAvailabilityDescription, FallbackValue=MARKET_AVAILABILITY_DESCRIPTION}"
                           Foreground="{DynamicResource SolidColorBrush.Text.2}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,10" />
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                  <TextBlock Text="{Binding Translation?.MaximumPriceAge, FallbackValue=MAXIMUM_PRICE_AGE}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                  <controls:DigitsTextBox Text="{Binding AvailabilityAlertMaximumPriceAgeMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsAvailabilityAlertInactive}"
                                          MaxLength="10"
                                          Width="100"
                                          Height="26" />
                  <TextBlock Text="{Binding Translation?.Minutes, FallbackValue=MINUTES}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0" />
                </StackPanel>
                <CheckBox Grid.Row="3"
                          Content="{Binding Translation?.IsAlertActive, FallbackValue=IS_ALERT_ACTIVE}"
                          IsChecked="{Binding IsAvailabilityAlertActive, Mode=OneWay}"
                          Click="AvailabilityAlert_Click"
                          Margin="0,12,0,0" />
              </Grid>
            </Border>
            <Border Theme="{StaticResource ItemDetails.Section.Border}"
                    Margin="0,0,0,10"
                    IsVisible="{Binding BlackMarketMonitoringVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
              <Grid Margin="14">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Image Source="avares://StatisticsAnalysisTool/Assets/flag_blackmarket.png"
                         Width="20"
                         Height="16"
                         Margin="0,0,8,0"
                         Stretch="Uniform" />
                  <TextBlock Text="{Binding Translation?.BlackMarketBuyOrderMonitoring, FallbackValue=BLACK_MARKET_BUY_ORDER_MONITORING}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             FontWeight="Bold"
                             FontSize="14" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Text="{Binding Translation?.BlackMarketBuyOrderMonitoringDescription, FallbackValue=BLACK_MARKET_BUY_ORDER_MONITORING_DESCRIPTION}"
                           Foreground="{DynamicResource SolidColorBrush.Text.2}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,10" />
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                  <TextBlock Text="{Binding Translation?.MinimumBuyOrderPrice, FallbackValue=MINIMUM_BUY_ORDER_PRICE}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                  <controls:DigitsTextBox Text="{Binding BlackMarketBuyOrderAlertThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsBlackMarketBuyOrderAlertInactive}"
                                          MaxLength="20"
                                          Width="150"
                                          Height="26" />
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="{Binding Translation?.MaximumPriceAge, FallbackValue=MAXIMUM_PRICE_AGE}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                  <controls:DigitsTextBox Text="{Binding BlackMarketAlertMaximumPriceAgeMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsBlackMarketBuyOrderAlertInactive}"
                                          MaxLength="10"
                                          Width="100"
                                          Height="26" />
                  <TextBlock Text="{Binding Translation?.Minutes, FallbackValue=MINUTES}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0" />
                </StackPanel>
                <CheckBox Grid.Row="4"
                          Content="{Binding Translation?.IsAlertActive, FallbackValue=IS_ALERT_ACTIVE}"
                          IsChecked="{Binding IsBlackMarketBuyOrderAlertActive, Mode=OneWay}"
                          Click="BlackMarketBuyOrderAlert_Click"
                          Margin="0,12,0,0" />
              </Grid>
            </Border>
            <CheckBox Content="{Binding Translation?.PlayAlertSound, FallbackValue=PLAY_ALERT_SOUND}"
                      IsChecked="{Binding IsAlertSoundEnabled, Mode=TwoWay}"
                      Margin="2,2,0,8" />
            <Border IsVisible="{Binding MonitoringErrorVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                    Background="{DynamicResource SolidColorBrush.Background.2}"
                    Padding="10"
                    Margin="0,4,0,0">
              <TextBlock Text="{Binding MonitoringErrorText}" Foreground="{DynamicResource SolidColorBrush.Accent.Red.1}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Translation?.Information, FallbackValue=INFORMATION}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10">
            <Border Theme="{StaticResource ItemDetails.Information.Card}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                  <controls:FontAwesomeImage Icon="SolidCircleInfo"
                                             Width="16"
                                             Height="16"
                                             Margin="0,0,8,0"
                                             Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
                  <TextBlock Text="{Binding Translation?.Information, FallbackValue=INFORMATION}"
                             Theme="{StaticResource ItemDetails.Information.CardHeader}" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,9,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="29" />
                    <RowDefinition Height="29" />
                    <RowDefinition Height="29" />
                    <RowDefinition Height="29" />
                    <RowDefinition Height="29" />
                    <RowDefinition Height="29" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="{Binding Translation?.ShopCategory, FallbackValue=SHOP_CATEGORY}"
                             Foreground="{DynamicResource SolidColorBrush.Text.3}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding ExtraItemInformation?.ShopCategory, FallbackValue=-, TargetNullValue=-}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1"
                             Text="{Binding Translation?.ShopSubCategory, FallbackValue=SHOP_SUB_CATEGORY_1}"
                             Foreground="{DynamicResource SolidColorBrush.Text.3}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding ExtraItemInformation?.ShopSubCategory1, FallbackValue=-, TargetNullValue=-}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2"
                             Text="{Binding Translation?.Durability, FallbackValue=DURABILITY}"
                             Foreground="{DynamicResource SolidColorBrush.Text.3}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2"
                             Grid.Column="1"
                             Text="{Binding ExtraItemInformation?.Durability, FallbackValue=-, TargetNullValue=-}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="3"
                             Text="{Binding Translation?.CanBeOvercharged, FallbackValue=CAN_BE_OVERCHARGED}"
                             Foreground="{DynamicResource SolidColorBrush.Text.3}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="3"
                             Grid.Column="1"
                             Text="{Binding ExtraItemInformation?.CanBeOvercharged, FallbackValue=-, TargetNullValue=-}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="4"
                             Text="{Binding Translation?.ShowInMarketplace, FallbackValue=SHOW_IN_MARKETPLACE}"
                             Foreground="{DynamicResource SolidColorBrush.Text.3}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="4"
                             Grid.Column="1"
                             Text="{Binding ExtraItemInformation?.ShowInMarketPlace, FallbackValue=-, TargetNullValue=-}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="5"
                             Text="{Binding Translation?.Weight, FallbackValue=WEIGHT}"
                             Foreground="{DynamicResource SolidColorBrush.Text.3}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="5"
                             Grid.Column="1"
                             Text="{Binding ExtraItemInformation?.Weight, FallbackValue=-, TargetNullValue=-}"
                             Foreground="{DynamicResource SolidColorBrush.Text.1}"
                             VerticalAlignment="Center" />
                </Grid>
              </Grid>
            </Border>
            <Border Theme="{StaticResource ItemDetails.Information.Card}"
                    IsVisible="{Binding ItemStatsCardVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                  <controls:FontAwesomeImage Icon="SolidGaugeHigh"
                                             Width="16"
                                             Height="16"
                                             Margin="0,0,8,0"
                                             Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
                  <TextBlock Text="{Binding Translation?.Stats, FallbackValue=STATS}" Theme="{StaticResource ItemDetails.Information.CardHeader}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ItemStats}" ItemTemplate="{StaticResource ItemDetails.Information.StatTemplate}" />
              </StackPanel>
            </Border>
            <Border Theme="{StaticResource ItemDetails.Information.Card}"
                    IsVisible="{Binding ItemSpellsCardVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <controls:FontAwesomeImage Icon="SolidWandMagicSparkles"
                                             Width="16"
                                             Height="16"
                                             Margin="0,0,8,0"
                                             Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
                  <TextBlock Text="{Binding Translation?.Spells, FallbackValue=SPELLS}" Theme="{StaticResource ItemDetails.Information.CardHeader}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding ActiveSpellsVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                  <TextBlock Text="{Binding Translation?.ActiveSpells, FallbackValue=ACTIVE}"
                             Theme="{StaticResource ItemDetails.Information.GroupHeader}" />
                  <ItemsControl ItemsSource="{Binding ActiveSpells}" ItemTemplate="{StaticResource ItemDetails.Information.SpellTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </StackPanel>
                <StackPanel IsVisible="{Binding PassiveSpellsVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                  <TextBlock Text="{Binding Translation?.PassiveSpells, FallbackValue=PASSIVE}"
                             Theme="{StaticResource ItemDetails.Information.GroupHeader}" />
                  <ItemsControl ItemsSource="{Binding PassiveSpells}" ItemTemplate="{StaticResource ItemDetails.Information.SpellTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <userControls:ErrorBarControl Grid.Row="1"
                                  VerticalAlignment="Bottom"
                                  IsVisible="{Binding ErrorBarVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                                  ErrorText="{Binding ErrorBarText}"
                                  ErrorException="{Binding ErrorBarException}" />
  </Grid>
</UserControl>
