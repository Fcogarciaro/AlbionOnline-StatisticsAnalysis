<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:userControls="clr-namespace:StatisticsAnalysisTool.UserControls"
             xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
             x:Class="StatisticsAnalysisTool.UserControls.ItemSearchControl" x:Name="ItemSearchRoot"
             x:DataType="viewModels:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1100">

    <Grid x:Name="ItemSearchLayoutGrid" Theme="{StaticResource TabItemGridStyle}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" MinWidth="420" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="500" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Theme="{StaticResource App.TopFilterCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <fa:FontAwesomeImage Grid.Column="0" Icon="SolidMagnifyingGlass" Width="16" Height="16" Margin="0,0,9,0"
                                              VerticalAlignment="Center" Foreground="{DynamicResource SolidColorBrush.Text.2}" />
                            <TextBox x:Name="TxtSearch" Grid.Column="1"
                                     Text="{Binding SearchText, Mode=TwoWay}"
                                     IsEnabled="{Binding IsTxtSearchEnabled, FallbackValue=false}"
                                     Theme="{StaticResource ItemSearchTextBoxStyle}" />
                            <Button Grid.Column="2" Width="32" Height="32" Margin="6,0,0,0" Padding="0"
                                    Theme="{StaticResource Style.Button.Neutral}"
                                    IsEnabled="{Binding IsFilterResetEnabled, FallbackValue=false}"
                                    Click="FilterReset_Click">
                                <fa:FontAwesomeImage Icon="SolidRotateRight" Width="14" Height="14" IsHitTestVisible="False"
                                                  Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                            </Button>
                            <Grid Grid.Column="3" Height="20" Width="20" Margin="10,0,0,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent"
                                  PointerEntered="OpenItemSearchInfoPopup_MouseEnter"
                                  PointerExited="CloseItemSearchInfoPopup_MouseLeave">
                                <fa:FontAwesomeImage Icon="SolidCircleInfo" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                            </Grid>
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="3" Margin="-4,10,-4,0">
                            <StackPanel Theme="{StaticResource ItemSearch.FilterField}">
                                <TextBlock Text="{Binding Translation.ShopCategory, FallbackValue=SHOP_CATEGORY}"
                                           Theme="{StaticResource App.FilterLabel}" />
                                <ComboBox ItemsSource="{Binding ItemShopCategories}"
                                          SelectedItem="{Binding SelectedItemShopCategory, Mode=TwoWay}"
                                          DisplayMemberBinding="{ReflectionBinding DisplayName}"
                                          Theme="{StaticResource ItemSearch.FilterComboBox}" />
                            </StackPanel>
                            <StackPanel Theme="{StaticResource ItemSearch.FilterField}">
                                <TextBlock Text="{Binding Translation.ShopSubCategory1, FallbackValue='SUBCATEGORY 1'}"
                                           Theme="{StaticResource App.FilterLabel}" />
                                <ComboBox ItemsSource="{Binding ItemSubCategories1}"
                                          SelectedItem="{Binding SelectedItemShopSubCategory1, Mode=TwoWay}"
                                          DisplayMemberBinding="{ReflectionBinding DisplayName}"
                                          Theme="{StaticResource ItemSearch.FilterComboBox}" />
                            </StackPanel>
                            <StackPanel Theme="{StaticResource ItemSearch.FilterField}">
                                <TextBlock Text="{Binding Translation.ShopSubCategory2, FallbackValue='SUBCATEGORY 2'}"
                                           Theme="{StaticResource App.FilterLabel}" />
                                <ComboBox ItemsSource="{Binding ItemSubCategories2}"
                                          SelectedItem="{Binding SelectedItemShopSubCategory2, Mode=TwoWay}"
                                          DisplayMemberBinding="{ReflectionBinding DisplayName}"
                                          Theme="{StaticResource ItemSearch.FilterComboBox}" />
                            </StackPanel>
                            <StackPanel Theme="{StaticResource ItemSearch.FilterField}">
                                <TextBlock Text="{Binding Translation.ShopSubCategory3, FallbackValue='SUBCATEGORY 3'}"
                                           Theme="{StaticResource App.FilterLabel}" />
                                <ComboBox ItemsSource="{Binding ItemSubCategories3}"
                                          SelectedItem="{Binding SelectedItemShopSubCategory3, Mode=TwoWay}"
                                          DisplayMemberBinding="{ReflectionBinding DisplayName}"
                                          Theme="{StaticResource ItemSearch.FilterComboBox}" />
                            </StackPanel>
                            <StackPanel Theme="{StaticResource ItemSearch.FilterField}">
                                <TextBlock Text="{Binding Translation.Tier, FallbackValue=TIER}"
                                           Theme="{StaticResource App.FilterLabel}" />
                                <ComboBox ItemsSource="{Binding ItemTiers}" SelectedValue="{Binding SelectedItemTier}"
                                          SelectedValueBinding="{ReflectionBinding Key}" DisplayMemberBinding="{ReflectionBinding Value}"
                                          Theme="{StaticResource ItemSearch.FilterComboBox}" />
                            </StackPanel>
                            <StackPanel Theme="{StaticResource ItemSearch.FilterField}">
                                <TextBlock Text="{Binding Translation.Level, FallbackValue=LEVEL}"
                                           Theme="{StaticResource App.FilterLabel}" />
                                <ComboBox ItemsSource="{Binding ItemLevels}" SelectedValue="{Binding SelectedItemLevel}"
                                          SelectedValueBinding="{ReflectionBinding Key}" DisplayMemberBinding="{ReflectionBinding Value}"
                                          Theme="{StaticResource ItemSearch.FilterComboBox}" />
                            </StackPanel>
                        </UniformGrid>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource SolidColorBrush.Background.4}"
                                BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <WrapPanel IsEnabled="{Binding IsItemSearchCheckboxesEnabled}">
                                <CheckBox Content="{Binding Translation.ShowOnlyFavorites, FallbackValue=SHOW__ONLY__FAVORITES}"
                                          IsChecked="{Binding IsShowOnlyFavoritesActive, FallbackValue=false}"
                                          Margin="0,0,18,0" />
                                <CheckBox Content="{Binding Translation.ShowOnlyItemsWithAlertOn, FallbackValue=SHOW_ONLY_ITEMS_WITH_ALERT_ON}"
                                          IsChecked="{Binding IsShowOnlyItemsWithAlertOnActive, FallbackValue=false}"
                                          Margin="0,0,5,0" />
                            </WrapPanel>
                        </Border>
                    </Grid>
                </Border>

                <DataGrid x:Name="ItemSearchList" Grid.Row="1" ItemsSource="{Binding ItemsView}"
                          SelectedItem="{Binding SelectedSearchItem, Mode=TwoWay}"
                          RowHeight="NaN">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="75" CellTemplate="{StaticResource ItemSearch.GridViewColumnIconTemplate}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding Translation.Icon, FallbackValue=ICON}" />
                            </DataGridTemplateColumn.Header>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="215" CellTemplate="{StaticResource ItemSearch.GridViewColumnNameTemplate}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding Translation.Name, FallbackValue=NAME}" />
                            </DataGridTemplateColumn.Header>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="55" CellTemplate="{StaticResource ItemSearch.GridViewColumnFavoriteTemplate}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding Translation.Favorite, FallbackValue=FAVORITE}" />
                            </DataGridTemplateColumn.Header>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="1" ZIndex="2"
                      IsVisible="{Binding IsItemSearchPopupVisible, Converter={x:Static conv:VisibilityToBoolConverter.Instance}, FallbackValue=False}"
                      Background="{DynamicResource SolidColorBrush.Background.2}">
                    <StackPanel Margin="10,8">
                        <DockPanel Margin="0,0,0,16">
                            <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                                <fa:FontAwesomeImage Icon="RegularCircleDot"
                                                  Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
                            </Grid>
                            <TextBlock Text="{Binding Translation.ItemSearchDescription3, FallbackValue='Item Prices: The prices listed under the item names in the list are averages taken directly from the game and update automatically when items are viewed in-game.'}"
                                       Foreground="{DynamicResource SolidColorBrush.Text.1}"
                                       FontSize="16" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SolidColorBrush.Background.2}"
                    BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0">
                <userControls:ItemSearchImageCounterControl LocalImageCounter="{Binding LocalImageCounter}"
                                                            ItemCounterString="{Binding ItemCounterString}" />
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                      Background="{DynamicResource SolidColorBrush.Background.2}"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

        <userControls:ItemDetailsControl Grid.Column="2" DataContext="{Binding SelectedItemDetails}"
                                         IsVisible="{ReflectionBinding DataContext.IsItemDetailsSelected, ElementName=ItemSearchRoot}" />
    </Grid>
</UserControl>
