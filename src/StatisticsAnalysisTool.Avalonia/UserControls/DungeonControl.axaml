<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:dungeon="clr-namespace:StatisticsAnalysisTool.Dungeon"
             xmlns:dungeonModels="clr-namespace:StatisticsAnalysisTool.Dungeon.Models"
             xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
             xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
             xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
             xmlns:common="clr-namespace:StatisticsAnalysisTool.Common"
             x:CompileBindings="False"
             x:Class="StatisticsAnalysisTool.UserControls.DungeonControl">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="5" />
      <RowDefinition Height="{Binding DungeonBindings?.GridSplitterPosition, Mode=TwoWay, Converter={x:Static conv:GridLengthConverter.Instance}}" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="15,10,15,0">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Margin="0,0,0,8" Theme="{StaticResource App.TopFilterCard}">
        <DockPanel LastChildFill="True">
          <WrapPanel>
            <Border Theme="{StaticResource App.FilterGroup}">
              <StackPanel>
                <TextBlock Text="{Binding Translation?.Dungeon, FallbackValue=DUNGEON}" Theme="{StaticResource App.FilterLabel}" />
                <ToggleButton IsChecked="{Binding DungeonBindings?.IsDungeonTrackingActive, Mode=OneWay}"
                              Theme="{StaticResource App.TrackingStateButton}"
                              ToolTip.Tip="{Binding Translation?.Dungeon}"
                              Click="DungeonActivationToggle_Click" />
              </StackPanel>
            </Border>
            <Border Theme="{StaticResource App.FilterGroup}">
              <StackPanel>
                <TextBlock Text="{Binding DungeonBindings?.TranslationTimeRange, FallbackValue=TIME_RANGE}" Theme="{StaticResource App.FilterLabel}" />
                <ComboBox Width="155"
                          ItemsSource="{Binding DungeonBindings?.DungeonStatTimeTypes}"
                          SelectedItem="{Binding DungeonBindings?.SelectedStatsTimeType, Mode=TwoWay}"
                          DisplayMemberBinding="{ReflectionBinding Name}" />
              </StackPanel>
            </Border>
            <Border Theme="{StaticResource App.FilterGroup}">
              <StackPanel>
                <TextBlock Text="{Binding DungeonBindings?.TranslationTier, FallbackValue=TIER}" Theme="{StaticResource App.FilterLabel}" />
                <ItemsControl ItemsSource="{Binding DungeonBindings?.DungeonStatsFilter?.TierFilterOptions}"
                              IsEnabled="{Binding DungeonBindings?.IsTierFilterEnabled}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="dungeonModels:DungeonNumericFilterOption">
                      <ToggleButton Content="{Binding DisplayName}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    Theme="{StaticResource App.FilterToggleButton}"
                                    Click="TierFilter_OnClick" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <StackPanel>
              <TextBlock Text="{Binding DungeonBindings?.TranslationEnchantment, FallbackValue=ENCHANTMENT}" Theme="{StaticResource App.FilterLabel}" />
              <ItemsControl ItemsSource="{Binding DungeonBindings?.DungeonStatsFilter?.EnchantmentFilterOptions}"
                            IsEnabled="{Binding DungeonBindings?.IsEnchantmentFilterEnabled}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="dungeonModels:DungeonNumericFilterOption">
                    <ToggleButton Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Theme="{StaticResource App.FilterToggleButton}"
                                  Click="EnchantmentFilter_OnClick" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </WrapPanel>
        </DockPanel>
      </Border>
      <ListBox Grid.Row="1"
               ItemsSource="{Binding DungeonBindings?.DungeonStatsType}"
               SelectedItem="{Binding DungeonBindings?.SelectedDungeonStatsType, Mode=TwoWay}"
               DisplayMemberBinding="{ReflectionBinding Name}"
               Theme="{StaticResource Dungeon.ContentTabs}"
               ItemContainerTheme="{StaticResource Dungeon.ContentTab}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,8,0,8">
          <UniformGrid Columns="5">
            <Border Theme="{StaticResource Dungeon.AnalyticsCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <fa:FontAwesomeImage Icon="SolidPersonRunning"
                                     Width="21"
                                     Height="21"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Top"
                                     Foreground="{DynamicResource SolidColorBrush.Text.2}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationTotalRuns, FallbackValue=TOTAL_RUNS}"
                             Theme="{StaticResource Dashboard.SummaryTitle}" />
                  <ContentControl Content="{Binding DungeonBindings?.Analytics?.TotalRuns}"
                                  ContentTemplate="{StaticResource Dungeon.SummaryMetricTemplate}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Theme="{StaticResource Dungeon.AnalyticsCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="avares://StatisticsAnalysisTool/Resources/fame.png"
                       Width="22"
                       Height="22"
                       Theme="{StaticResource Dashboard.SummaryImage}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationTotalFame, FallbackValue=TOTAL_FAME}"
                             Theme="{StaticResource Dashboard.SummaryTitle}" />
                  <ContentControl Content="{Binding DungeonBindings?.Analytics?.TotalFame}"
                                  ContentTemplate="{StaticResource Dungeon.SummaryMetricTemplate}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Theme="{StaticResource Dungeon.AnalyticsCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="avares://StatisticsAnalysisTool/Resources/respec.png"
                       Width="22"
                       Height="22"
                       Theme="{StaticResource Dashboard.SummaryImage}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationTotalReSpec, FallbackValue=TOTAL_RESPEC}"
                             Theme="{StaticResource Dashboard.SummaryTitle}" />
                  <ContentControl Content="{Binding DungeonBindings?.Analytics?.TotalReSpec}"
                                  ContentTemplate="{StaticResource Dungeon.SummaryMetricTemplate}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Theme="{StaticResource Dungeon.AnalyticsCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="avares://StatisticsAnalysisTool/Resources/might.png"
                       Width="23"
                       Height="23"
                       Theme="{StaticResource Dashboard.SummaryImage}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationTotalMight, FallbackValue=TOTAL_MIGHT}"
                             Theme="{StaticResource Dashboard.SummaryTitle}" />
                  <ContentControl Content="{Binding DungeonBindings?.Analytics?.TotalMight}"
                                  ContentTemplate="{StaticResource Dungeon.SummaryMetricTemplate}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Theme="{StaticResource Dungeon.AnalyticsCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="avares://StatisticsAnalysisTool/Resources/favor.png"
                       Width="23"
                       Height="23"
                       Theme="{StaticResource Dashboard.SummaryImage}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationTotalFavor, FallbackValue=TOTAL_FAVOR}"
                             Theme="{StaticResource Dashboard.SummaryTitle}" />
                  <ContentControl Content="{Binding DungeonBindings?.Analytics?.TotalFavor}"
                                  ContentTemplate="{StaticResource Dungeon.SummaryMetricTemplate}" />
                </StackPanel>
              </Grid>
            </Border>
          </UniformGrid>
          <UniformGrid Margin="0,8,0,0" Columns="4">
            <Border Theme="{StaticResource Dungeon.AnalyticsCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="avares://StatisticsAnalysisTool/Resources/silver.png"
                       Width="22"
                       Height="22"
                       Theme="{StaticResource Dashboard.SummaryImage}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationTotalSilver, FallbackValue=TOTAL_SILVER}"
                             Theme="{StaticResource Dashboard.SummaryTitle}" />
                  <ContentControl Content="{Binding DungeonBindings?.Analytics?.TotalSilver}"
                                  ContentTemplate="{StaticResource Dungeon.SummaryMetricTemplate}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Theme="{StaticResource Dungeon.AnalyticsCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png"
                       Width="24"
                       Height="24"
                       Theme="{StaticResource Dashboard.SummaryImage}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationTotalLootValue, FallbackValue=TOTAL_LOOT_VALUE}"
                             Theme="{StaticResource Dashboard.SummaryTitle}" />
                  <ContentControl Content="{Binding DungeonBindings?.Analytics?.TotalLootValue}"
                                  ContentTemplate="{StaticResource Dungeon.SummaryMetricTemplate}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Theme="{StaticResource Dungeon.AnalyticsCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="avares://StatisticsAnalysisTool/Assets/skull.png"
                       Width="16"
                       Height="24"
                       Theme="{StaticResource Dashboard.SummaryImage}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationDungeonDeaths, FallbackValue=DUNGEON_DEATHS}"
                             Theme="{StaticResource Dashboard.SummaryTitle}" />
                  <ContentControl Content="{Binding DungeonBindings?.Analytics?.Deaths}"
                                  ContentTemplate="{StaticResource Dungeon.SummaryMetricTemplate}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Theme="{StaticResource Dungeon.AnalyticsCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <fa:FontAwesomeImage Icon="RegularClock"
                                     Width="21"
                                     Height="21"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Top"
                                     Foreground="{DynamicResource SolidColorBrush.Text.2}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationAverageRunTime, FallbackValue=AVERAGE_RUN_TIME}"
                             Theme="{StaticResource Dashboard.SummaryTitle}" />
                  <ContentControl Content="{Binding DungeonBindings?.Analytics?.AverageRunTime}"
                                  ContentTemplate="{StaticResource Dungeon.DurationMetricTemplate}" />
                </StackPanel>
              </Grid>
            </Border>
          </UniformGrid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Theme="{StaticResource Dashboard.FactionSummaryCard}" Margin="4">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Height="40" Cursor="Arrow">
                  <TextBlock Margin="12,0"
                             Text="{Binding DungeonBindings?.Analytics?.TranslationDungeonOverview, FallbackValue=DUNGEON_OVERVIEW}"
                             Theme="{StaticResource Dashboard.ContentRankingTitle}" />
                </Grid>
                <Border Grid.Row="1" BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0">
                  <UniformGrid Columns="3" Rows="2" Margin="4">
                    <Border Theme="{StaticResource Dungeon.OverviewMetricCard}">
                      <StackPanel>
                        <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationMostProfitableTier, FallbackValue=MOST_PROFITABLE_TIER}"
                                   Theme="{StaticResource Dungeon.OverviewMetricTitle}" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource SolidColorBrush.Accent.Blue.4}">
                            <TextBlock Text="{Binding DungeonBindings?.Analytics?.MostProfitableTierEnchantment}"
                                       Foreground="{DynamicResource SolidColorBrush.Text.1}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DungeonBindings?.Analytics?.MostProfitableLootPerHour, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                                       Theme="{StaticResource Dungeon.OverviewMetricValue}" />
                            <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationLootValuePerHour, FallbackValue=LOOT_VALUE_PER_HOUR}"
                                       Theme="{StaticResource Dungeon.OverviewMetricCaption}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Theme="{StaticResource Dungeon.OverviewMetricCard}">
                      <StackPanel>
                        <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationMostPlayedTier, FallbackValue=MOST_PLAYED_TIER}"
                                   Theme="{StaticResource Dungeon.OverviewMetricTitle}" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource SolidColorBrush.Accent.Green.4}">
                            <TextBlock Text="{Binding DungeonBindings?.Analytics?.MostPlayedTierEnchantment}"
                                       Foreground="{DynamicResource SolidColorBrush.Text.1}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DungeonBindings?.Analytics?.MostPlayedTierRunCount, StringFormat='{}{0:N0}', ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                                       Theme="{StaticResource Dungeon.OverviewMetricValue}" />
                            <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationRuns, FallbackValue=RUNS}"
                                       Theme="{StaticResource Dungeon.OverviewMetricCaption}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Theme="{StaticResource Dungeon.OverviewMetricCard}">
                      <StackPanel>
                        <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationMostValuableLoot, FallbackValue=MOST_VALUABLE_LOOT}"
                                   Theme="{StaticResource Dungeon.OverviewMetricTitle}" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Image Source="{Binding DungeonBindings.Analytics.MostValuableLoot?.Item?.Icon}" Width="56" Height="56" Stretch="Uniform" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DungeonBindings.Analytics.MostValuableLoot?.Item?.LocalizedName, FallbackValue=—}"
                                       Theme="{StaticResource Dungeon.OverviewMetricValue}"
                                       FontSize="12.5"
                                       MaxWidth="145"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DungeonBindings.Analytics.MostValuableLoot?.EstimatedMarketValue.DoubleValue, StringFormat='{}{0:N0}', ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}"
                                       Theme="{StaticResource Dungeon.OverviewMetricCaption}"
                                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Theme="{StaticResource Dungeon.OverviewMetricCard}">
                      <StackPanel>
                        <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationBestDungeonMap, FallbackValue=BEST_DUNGEON_MAP}"
                                   Theme="{StaticResource Dungeon.OverviewMetricTitle}" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Image Source="avares://StatisticsAnalysisTool/Assets/dungeon.png" Width="46" Height="46" Stretch="Uniform" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DungeonBindings?.Analytics?.BestDungeonMap}"
                                       Theme="{StaticResource Dungeon.OverviewMetricValue}"
                                       FontSize="12.5"
                                       MaxWidth="145"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationAverageLootPerRun, FallbackValue=AVERAGE_LOOT_PER_RUN}"
                                         Theme="{StaticResource Dungeon.OverviewMetricCaption}" />
                              <TextBlock Text=": " Theme="{StaticResource Dungeon.OverviewMetricCaption}" />
                              <TextBlock Text="{Binding DungeonBindings?.Analytics?.BestDungeonMapAverageLoot, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                                         Theme="{StaticResource Dungeon.OverviewMetricCaption}" />
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Theme="{StaticResource Dungeon.OverviewMetricCard}">
                      <StackPanel>
                        <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationFastestRun, FallbackValue=FASTEST_RUN}"
                                   Theme="{StaticResource Dungeon.OverviewMetricTitle}" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <fa:FontAwesomeImage Icon="RegularClock"
                                               Width="34"
                                               Height="34"
                                               Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Panel>
                              <TextBlock Theme="{StaticResource Dungeon.OverviewMetricValue}"
                                         Text="{Binding DungeonBindings?.Analytics?.FastestRunTimeInSeconds, Converter={StaticResource SecondsToTimeFormatConverter}}"
                                         IsVisible="{Binding DungeonBindings?.Analytics?.HasFastestRun}" />
                              <TextBlock Theme="{StaticResource Dungeon.OverviewMetricValue}" Text="&#x2014;"
                                         IsVisible="{Binding DungeonBindings?.Analytics?.HasFastestRun, Converter={x:Static BoolConverters.Not}}" />
                            </Panel>
                            <StackPanel Orientation="Horizontal"
                                        IsVisible="{Binding DungeonBindings?.Analytics?.HasFastestRun, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='False=False|*=True'}">
                              <TextBlock Text="{Binding DungeonBindings?.Analytics?.FastestRunTierEnchantment}"
                                         Theme="{StaticResource Dungeon.OverviewMetricCaption}" />
                              <TextBlock Text=" · " Theme="{StaticResource Dungeon.OverviewMetricCaption}" />
                              <TextBlock Text="{Binding DungeonBindings?.Analytics?.FastestRunPartySize}"
                                         Theme="{StaticResource Dungeon.OverviewMetricCaption}" />
                              <TextBlock Text=" " Theme="{StaticResource Dungeon.OverviewMetricCaption}" />
                              <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationPartySize, FallbackValue=PARTY_SIZE}"
                                         Theme="{StaticResource Dungeon.OverviewMetricCaption}" />
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Theme="{StaticResource Dungeon.OverviewMetricCard}">
                      <StackPanel>
                        <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationAverageChestsPerRun, FallbackValue=AVERAGE_CHESTS_PER_RUN}"
                                   Theme="{StaticResource Dungeon.OverviewMetricTitle}" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Width="48" Height="48" Stretch="Uniform" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding DungeonBindings?.Analytics?.AverageChestsPerRun, StringFormat='{}{0:N2}', ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                                     Theme="{StaticResource Dungeon.OverviewMetricValue}"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                </Border>
              </Grid>
            </Border>
            <Border Grid.Column="1" Theme="{StaticResource Dungeon.DetailCard}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding DungeonBindings?.Analytics?.TranslationRunEfficiency, FallbackValue=RUN_EFFICIENCY}"
                           Theme="{StaticResource Dungeon.SectionTitle}" />
                <Grid Grid.Row="1" Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="1"
                             Text="{Binding DungeonBindings?.Analytics?.TranslationAverageLootPerRun, FallbackValue=AVERAGE_LOOT_PER_RUN}"
                             FontSize="10"
                             Foreground="{DynamicResource SolidColorBrush.Text.3}"
                             TextAlignment="Center" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding DungeonBindings?.Analytics?.TranslationAverageFamePerRun, FallbackValue=AVERAGE_FAME_PER_RUN}"
                             FontSize="10"
                             Foreground="{DynamicResource SolidColorBrush.Text.3}"
                             TextAlignment="Center" />
                  <TextBlock Grid.Column="3"
                             Text="{Binding DungeonBindings?.Analytics?.TranslationAverageDuration, FallbackValue=AVERAGE_DURATION}"
                             FontSize="10"
                             Foreground="{DynamicResource SolidColorBrush.Text.3}"
                             TextAlignment="Center" />
                </Grid>
                <ItemsControl Grid.Row="2" ItemsSource="{Binding DungeonBindings?.Analytics?.EfficiencyEntries}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="31" Margin="0,1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="74" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TierEnchantment}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SolidColorBrush.Text.1}"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Margin="3,4">
                          <ProgressBar Value="{Binding LootScore}"
                                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}"
                                       Theme="{StaticResource Dungeon.EfficiencyBar}" />
                          <TextBlock Text="{Binding AverageLootPerRun, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                                     Margin="7,0"
                                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Column="2" Margin="3,4">
                          <ProgressBar Value="{Binding FameScore}"
                                       Foreground="{DynamicResource SolidColorBrush.Accent.Red.3}"
                                       Theme="{StaticResource Dungeon.EfficiencyBar}" />
                          <TextBlock Text="{Binding AverageFamePerRun, Converter={StaticResource Dungeon.ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                                     Margin="7,0"
                                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <fa:FontAwesomeImage Icon="RegularClock"
                                               Width="12"
                                               Height="12"
                                               Margin="0,0,5,0"
                                               Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
                          <TextBlock Text="{Binding AverageDurationInSeconds, Converter={StaticResource Dungeon.DurationConverter}}"
                                     Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
          </Grid>
          <Border Theme="{StaticResource Dungeon.SettingsCard}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="{Binding DungeonBindings?.TranslationSettingsAndReset, FallbackValue=SETTINGS_AND_RESET}"
                         Theme="{StaticResource Dungeon.SectionTitle}" />
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="1" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <ContentControl Margin="0,2,16,0"
                                VerticalAlignment="Top"
                                Content="{Binding DungeonBindings?.DungeonOptionsObject}"
                                ContentTemplate="{StaticResource DungeonOptionsObjectTemplate}" />
                <Border Grid.Column="1" Margin="0,0,16,0" Background="{DynamicResource SolidColorBrush.Background.4}" />
                <UniformGrid Grid.Column="2" Columns="2">
                  <Button Content="{Binding Translation?.DeleteSelectedDungeons, FallbackValue=DELETE_SELECTED_DUNGEONS}"
                          Height="30"
                          Theme="{StaticResource Style.Button.Danger}"
                          Margin="0,0,6,6"
                          Click="BtnDeleteSelectedDungeons_Click" />
                  <Button Content="{Binding Translation?.DeleteZeroFameDungeons, FallbackValue=DELETE_ZERO_FAME_DUNGEONS}"
                          Height="30"
                          Theme="{StaticResource Style.Button.Danger}"
                          Margin="0,0,0,6"
                          Click="BtnDeleteZeroFameDungeons_Click" />
                  <Button Content="{Binding Translation?.ResetDungeonTracking, FallbackValue=RESET_DUNGEON_TRACKING}"
                          Height="30"
                          Theme="{StaticResource Style.Button.Danger}"
                          Margin="0,0,6,0"
                          Click="BtnDungeonTrackingReset_Click" />
                  <Button Content="{Binding Translation?.ResetTodaysDungeons, FallbackValue=RESET_TODAYS_DUNGEONS}"
                          Height="30"
                          Theme="{StaticResource Style.Button.Danger}"
                          Click="BtnResetTodaysDungeons_Click" />
                </UniformGrid>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <GridSplitter Grid.Row="1"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  HorizontalAlignment="Stretch"
                  Background="{DynamicResource SolidColorBrush.Accent.Blue.4}" />
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0"
              Margin="0,0,0,0"
              Padding="10,0"
              Background="{DynamicResource SolidColorBrush.Background.2}"
              BorderBrush="{DynamicResource SolidColorBrush.Background.4}"
              BorderThickness="0,0,0,1">
        <TextBlock Text="{Binding DungeonBindings?.TranslationContentRuns, FallbackValue=CONTENT_RUNS}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                   VerticalAlignment="Center" />
      </Border>
      <Grid Grid.Row="1">
        <!-- Upstream: VirtualizingItemsControl with DungeonDataTemplateSelector, which maps all nine fragment types to Dungeon.ModernRunEntry.Template. -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
          <ItemsControl ItemsSource="{Binding DungeonBindings?.DungeonsCollectionView, Mode=OneWay}"
                        ItemTemplate="{StaticResource Dungeon.ModernRunEntry.Template}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
