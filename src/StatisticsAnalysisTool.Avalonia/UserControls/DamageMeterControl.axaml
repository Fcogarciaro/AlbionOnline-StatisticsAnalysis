<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks"
             xmlns:damageMeter="clr-namespace:StatisticsAnalysisTool.DamageMeter"
             xmlns:enumerations="clr-namespace:StatisticsAnalysisTool.Enumerations"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
             xmlns:common="clr-namespace:StatisticsAnalysisTool.Common"
             x:CompileBindings="False"
             x:Class="StatisticsAnalysisTool.UserControls.DamageMeterControl">
  <UserControl.Resources>
    <DataTemplate x:Key="DamageStatsEntryTemplate" DataType="damageMeter:DamageStatsEntry">
      <Grid Height="22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="58" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{}{0}.'}" Theme="{StaticResource TopStats.EntryRank}" />
        <TextBlock Grid.Column="1" Text="{Binding PlayerName}" Theme="{StaticResource TopStats.EntryName}" />
        <ProgressBar Grid.Column="2"
                     Value="{Binding BarPercentage}"
                     Margin="5,0,7,0"
                     VerticalAlignment="Center"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                     Theme="{StaticResource TopStats.RankingBar}" />
        <TextBlock Grid.Column="3"
                   Text="{Binding ValueString}"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                   Theme="{StaticResource TopStats.EntryValue}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DamageStatsContributionEntryTemplate" DataType="damageMeter:DamageStatsEntry">
      <Grid Height="22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="58" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{}{0}.'}" Theme="{StaticResource TopStats.EntryRank}" />
        <TextBlock Grid.Column="1" Text="{Binding PlayerName}" Theme="{StaticResource TopStats.EntryName}" />
        <ProgressBar Grid.Column="2"
                     Value="{Binding BarPercentage}"
                     Margin="5,0,7,0"
                     VerticalAlignment="Center"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                     Theme="{StaticResource TopStats.RankingBar}" />
        <TextBlock Grid.Column="3"
                   Text="{Binding SharePercentageString}"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                   Theme="{StaticResource TopStats.EntryValue}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DamageSpellStatsEntryTemplate" DataType="damageMeter:DamageSpellStatsEntry">
      <Grid Height="38" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="42" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="50" />
          <ColumnDefinition Width="70" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{}{0}.'}" Theme="{StaticResource TopStats.EntryRank}" Margin="5,0,0,0" />
        <Ellipse Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center">
          <ToolTip.Tip>
            <ContentControl Content="{Binding}"
                            ContentTemplate="{StaticResource Spell.ToolTipContentTemplate}"
                            DataContext="{Binding SpellInformation}" />
          </ToolTip.Tip>
          <Ellipse.Fill>
            <ImageBrush Source="{Binding Icon}" Stretch="UniformToFill" />
          </Ellipse.Fill>
        </Ellipse>
        <TextBlock Grid.Column="2" Margin="5,0,0,0" Text="{Binding DisplayName}" Theme="{StaticResource TopStats.EntryName}" />
        <ProgressBar Grid.Column="3"
                     Value="{Binding BarPercentage}"
                     Margin="5,0,5,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}"
                     Theme="{StaticResource TopStats.RankingBar}" />
        <TextBlock Grid.Column="4" Text="{Binding ValueString}" Theme="{StaticResource TopStats.DamageSpellValue}" />
        <TextBlock Grid.Column="5" Text="{Binding SharePercentageString}" Theme="{StaticResource TopStats.DamageSpellShare}" Margin="0,0,10,0" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DamageSpellStatsColumnTemplate">
      <StackPanel Margin="5,5,5,5">
        <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource DamageSpellStatsEntryTemplate}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="DamageTypeStatsEntryTemplate" DataType="damageMeter:DamageTypeStatsEntry">
      <Border Margin="3"
              Padding="7,6"
              MinHeight="118"
              Background="{DynamicResource SolidColorBrush.Background.3}"
              BorderBrush="{DynamicResource SolidColorBrush.Border.2}"
              BorderThickness="1"
              CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="28" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <iconPacks:PackIconGameIcons x:Name="DamageTypeIcon"
                                       Grid.Row="0"
                                       Width="34"
                                       Height="34"
                                       Margin="0,1,0,5"
                                       HorizontalAlignment="Center"
                                       Kind="{Binding DamageType, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Physical=Broadsword|Magic=CrystalWand|True=ShieldDisabled'}"
                                       Foreground="{Binding DamageType, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Physical=@SolidColorBrush.Accent.Red.2|Magic=@SolidColorBrush.Accent.Blue.2|True=@SolidColorBrush.Accent.Orange.3'}" />
          <TextBlock Grid.Row="1"
                     Text="{Binding DisplayName}"
                     Foreground="{DynamicResource SolidColorBrush.Text.2}"
                     FontSize="11"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Row="2"
                     Text="{Binding ValueString}"
                     Foreground="{DynamicResource SolidColorBrush.Text.1}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Grid.Row="3"
                     Text="{Binding SharePercentageString}"
                     Foreground="{DynamicResource SolidColorBrush.Text.2}"
                     FontSize="11"
                     HorizontalAlignment="Center" />
          <ProgressBar x:Name="DamageTypeBar"
                       Grid.Row="4"
                       Value="{Binding BarPercentage}"
                       Margin="2,7,2,0"
                       Theme="{StaticResource TopStats.RankingBar}"
                       Foreground="{Binding DamageType, Converter={x:Static conv:ValueMapConverter.Instance}, ConverterParameter='Physical=@SolidColorBrush.Accent.Red.2|Magic=@SolidColorBrush.Accent.Blue.2|True=@SolidColorBrush.Accent.Orange.3'}" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="YourStatsTopEntryTemplate" DataType="damageMeter:DamageMeterYourStatsTopEntry">
      <Border Theme="{StaticResource YourStats.Defense.TopEntryCard}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{}{0}.'}" Theme="{StaticResource YourStats.TopEntryRank}" />
          <TextBlock Grid.Column="1" Text="{Binding Name}" Theme="{StaticResource YourStats.TopEntryName}" />
          <TextBlock Grid.Column="2"
                     Text="{Binding ValueString}"
                     Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                     Theme="{StaticResource YourStats.TopEntryValue}" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="YourStatsHealingTopEntryTemplate" DataType="damageMeter:DamageMeterYourStatsTopEntry">
      <Border Theme="{StaticResource YourStats.Healing.TopEntryCard}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{}{0}.'}" Theme="{StaticResource YourStats.TopEntryRank}" />
          <TextBlock Grid.Column="1" Text="{Binding Name}" Theme="{StaticResource YourStats.TopEntryName}" />
          <TextBlock Grid.Column="2"
                     Text="{Binding ValueString}"
                     Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}"
                     Theme="{StaticResource YourStats.TopEntryValue}" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="YourStatsSnapshotTemplate" DataType="damageMeter:DamageMeterYourStatsSnapshot">
      <ScrollViewer Margin="0,7,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <Grid Margin="3,0,3,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Margin="0,2,5,5" Theme="{StaticResource YourStats.Damage.SectionCard}">
            <StackPanel>
              <Grid Margin="2,0,2,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Theme="{StaticResource YourStats.Damage.HeaderIcon}">
                  <fa:FontAwesomeImage Icon="SolidHandFist" Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding DataContext.DamageMeterBindings.TranslationYourStatsDamageSection, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=YOUR_STATS_DAMAGE_SECTION}"
                           Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}"
                           Theme="{StaticResource YourStats.SectionTitle}" />
              </Grid>
              <UniformGrid Columns="3">
                <Border Theme="{StaticResource YourStats.Damage.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationTotalDamage, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=TOTAL_DAMAGE}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding TotalDamage}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource YourStats.Damage.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationTotalDps, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=TOTAL_DPS}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding TotalDps}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource YourStats.Damage.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationPeakDpsFiveSeconds, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=PEAK_DPS_5_SECONDS}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding PeakDpsFiveSeconds}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
              </UniformGrid>
              <UniformGrid Columns="5">
                <Border Theme="{StaticResource YourStats.Damage.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationPeakDpsThreeSeconds, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=PEAK_DPS_3_SECONDS}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding PeakDpsThreeSeconds}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource YourStats.Damage.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationPeakDpsTenSeconds, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=PEAK_DPS_10_SECONDS}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding PeakDpsTenSeconds}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource YourStats.Damage.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationBiggestHit, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=BIGGEST_HIT}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding BiggestHit}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource YourStats.Damage.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationPveDamage, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=PVE_DAMAGE}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding PveDamage}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource YourStats.Damage.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationPvpDamage, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=PVP_DAMAGE}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding PvpDamage}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
              </UniformGrid>
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Margin="5,2,0,5" Theme="{StaticResource YourStats.Healing.SectionCard}">
            <StackPanel>
              <Grid Margin="2,0,2,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Theme="{StaticResource YourStats.Healing.HeaderIcon}">
                  <fa:FontAwesomeImage Icon="RegularHeart" Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding DataContext.DamageMeterBindings.TranslationYourStatsHealingSection, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=YOUR_STATS_HEALING_SECTION}"
                           Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}"
                           Theme="{StaticResource YourStats.SectionTitle}" />
              </Grid>
              <UniformGrid Columns="3">
                <Border Theme="{StaticResource YourStats.Healing.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationTotalHealing, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=TOTAL_HEALING}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding TotalHealing}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource YourStats.Healing.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationEffectiveHealing, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=EFFECTIVE_HEALING}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding EffectiveHealing}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource YourStats.Healing.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationOverhealPercent, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=OVERHEAL_PERCENT}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding OverhealPercent}"
                               Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}"
                               Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
              </UniformGrid>
              <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationHealingTargetsTopThree, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=HEALING_TARGETS_TOP_3}"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Green.1}"
                         FontSize="12"
                         FontWeight="Bold"
                         Margin="2,8,2,3" />
              <ItemsControl ItemsSource="{Binding TopHealingTargets}" ItemTemplate="{StaticResource YourStatsHealingTopEntryTemplate}" />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Margin="0,5,5,2" Theme="{StaticResource YourStats.Defense.SectionCard}">
            <StackPanel>
              <Grid Margin="2,0,2,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Theme="{StaticResource YourStats.Defense.HeaderIcon}">
                  <fa:FontAwesomeImage Icon="SolidShieldHalved" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding DataContext.DamageMeterBindings.TranslationYourStatsDefenseSection, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=YOUR_STATS_DEFENSE_SECTION}"
                           Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                           Theme="{StaticResource YourStats.SectionTitle}" />
              </Grid>
              <UniformGrid Columns="2">
                <Border Theme="{StaticResource YourStats.Defense.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationDamageTaken, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=DAMAGE_TAKEN}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding DamageTaken}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource YourStats.Defense.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationDtps, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=DTPS}"
                               ToolTip.Tip="{Binding DataContext.DamageMeterBindings.TranslationDtpsTooltip, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=DTPS_TOOLTIP}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding Dtps}"
                               ToolTip.Tip="{Binding DataContext.DamageMeterBindings.TranslationDtpsTooltip, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=DTPS_TOOLTIP}"
                               Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
              </UniformGrid>
              <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationBiggestDamageTakenBySpellTopThree, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=BIGGEST_DAMAGE_TAKEN_BY_SPELL_TOP_3}"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}"
                         FontSize="12"
                         FontWeight="Bold"
                         Margin="2,8,2,3" />
              <ItemsControl ItemsSource="{Binding TopDamageTakenBySpell}" ItemTemplate="{StaticResource YourStatsTopEntryTemplate}" />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Margin="5,5,0,2" Theme="{StaticResource YourStats.Combat.SectionCard}">
            <StackPanel>
              <Grid Margin="2,0,2,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Theme="{StaticResource YourStats.Combat.HeaderIcon}">
                  <fa:FontAwesomeImage Icon="RegularClock" Foreground="{DynamicResource SolidColorBrush.Accent.Yellow.3}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding DataContext.DamageMeterBindings.TranslationYourStatsCombatSection, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=YOUR_STATS_COMBAT_SECTION}"
                           Foreground="{DynamicResource SolidColorBrush.Accent.Yellow.3}"
                           Theme="{StaticResource YourStats.SectionTitle}" />
              </Grid>
              <UniformGrid Columns="3">
                <Border Theme="{StaticResource YourStats.Combat.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationCombatTime, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=COMBAT_TIME}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding CombatTime}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource YourStats.Combat.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationFightCount, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=FIGHT_COUNT}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding FightCount}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource YourStats.Combat.MetricCard}">
                  <StackPanel>
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationAverageFightDuration, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=AVERAGE_FIGHT_DURATION}"
                               Theme="{StaticResource YourStats.MetricLabel}" />
                    <TextBlock Text="{Binding AverageFightDuration}" Theme="{StaticResource YourStats.MetricValue}" />
                  </StackPanel>
                </Border>
              </UniformGrid>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </DataTemplate>
    <DataTemplate x:Key="DamageStatsSnapshotTemplate" DataType="damageMeter:DamageStatsSnapshot">
      <ScrollViewer Margin="0,5,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <StackPanel Margin="0,0,0,0">
          <UniformGrid Columns="6">
            <Border Theme="{StaticResource TopStats.Damage.HighlightCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Theme="{StaticResource TopStats.Damage.HighlightIcon}">
                  <iconPacks:PackIconGameIcons Kind="GooeyImpact"
                                               Width="24"
                                               Height="24"
                                               Margin="0,0,0,0"
                                               Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationBiggestHit, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=BIGGEST_HIT}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}"
                             Theme="{StaticResource TopStats.HighlightTitle}" />
                  <TextBlock Text="{Binding BiggestHit.PlayerName}" Theme="{StaticResource TopStats.HighlightPlayer}" />
                  <TextBlock Text="{Binding BiggestHit.ValueString}" Theme="{StaticResource TopStats.HighlightValue}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Theme="{StaticResource TopStats.Damage.HighlightCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Theme="{StaticResource TopStats.Damage.HighlightIcon}">
                  <iconPacks:PackIconGameIcons Kind="BulletImpacts"
                                               Width="24"
                                               Height="24"
                                               Margin="0,0,0,0"
                                               Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationPeakDpsFiveSeconds, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=PEAK_DPS_5_SECONDS}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}"
                             Theme="{StaticResource TopStats.HighlightTitle}" />
                  <TextBlock Text="{Binding PeakDpsFiveSeconds.PlayerName}" Theme="{StaticResource TopStats.HighlightPlayer}" />
                  <TextBlock Text="{Binding PeakDpsFiveSeconds.ValueString}" Theme="{StaticResource TopStats.HighlightValue}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Theme="{StaticResource TopStats.Damage.HighlightCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Theme="{StaticResource TopStats.Damage.HighlightIcon}">
                  <iconPacks:PackIconGameIcons Kind="BulletImpacts"
                                               Width="24"
                                               Height="24"
                                               Margin="0,0,0,0"
                                               Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationPeakDpsTenSeconds, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=PEAK_DPS_10_SECONDS}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}"
                             Theme="{StaticResource TopStats.HighlightTitle}" />
                  <TextBlock Text="{Binding PeakDpsTenSeconds.PlayerName}" Theme="{StaticResource TopStats.HighlightPlayer}" />
                  <TextBlock Text="{Binding PeakDpsTenSeconds.ValueString}" Theme="{StaticResource TopStats.HighlightValue}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Theme="{StaticResource TopStats.Healing.HighlightCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Theme="{StaticResource TopStats.Healing.HighlightIcon}">
                  <iconPacks:PackIconGameIcons Kind="Healing"
                                               Width="24"
                                               Height="24"
                                               Margin="0,0,0,0"
                                               Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationTopHealer, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=TOP_HEALER}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}"
                             Theme="{StaticResource TopStats.HighlightTitle}" />
                  <TextBlock Text="{Binding TopHealer.PlayerName}" Theme="{StaticResource TopStats.HighlightPlayer}" />
                  <TextBlock Text="{Binding TopHealer.ValueString}" Theme="{StaticResource TopStats.HighlightValue}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Theme="{StaticResource TopStats.Defense.HighlightCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Theme="{StaticResource TopStats.Defense.HighlightIcon}">
                  <iconPacks:PackIconGameIcons Kind="SnakeBite"
                                               Width="24"
                                               Height="24"
                                               Margin="0,0,0,0"
                                               Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationTopDamageTaken, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=TOP_DAMAGE_TAKEN}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                             Theme="{StaticResource TopStats.HighlightTitle}" />
                  <TextBlock Text="{Binding MostDamageTaken.PlayerName}" Theme="{StaticResource TopStats.HighlightPlayer}" />
                  <TextBlock Text="{Binding MostDamageTaken.ValueString}" Theme="{StaticResource TopStats.HighlightValue}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Theme="{StaticResource TopStats.Defense.HighlightCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Theme="{StaticResource TopStats.Defense.HighlightIcon}">
                  <fa:FontAwesomeImage Icon="SolidUsers" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationTotalTrackedFights, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=TOTAL_TRACKED_FIGHTS}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                             Theme="{StaticResource TopStats.HighlightTitle}" />
                  <TextBlock Text="{Binding TrackedFightCount}" Theme="{StaticResource TopStats.HighlightValue}" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TrackedFightDurationString}" Theme="{StaticResource TopStats.HighlightPlayer}" Margin="0" />
                    <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationTotalLabel, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=TOTAL}"
                               Theme="{StaticResource TopStats.HighlightPlayer}"
                               Margin="4,0,0,0" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </UniformGrid>
          <UniformGrid Columns="4">
            <Border Theme="{StaticResource DamageMeter.RankingCard}">
              <StackPanel>
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <fa:FontAwesomeImage Grid.Column="0"
                                       Icon="SolidBolt"
                                       Theme="{StaticResource TopStats.RankingIcon}"
                                       Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding DataContext.DamageMeterBindings.TranslationBiggestSingleHitTop5, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=BIGGEST_SINGLE_HIT_TOP_5}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}"
                             Theme="{StaticResource TopStats.RankingTitle}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TopSingleHits}"
                              ItemTemplate="{StaticResource DamageStatsEntryTemplate}"
                              Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
              </StackPanel>
            </Border>
            <Border Theme="{StaticResource DamageMeter.RankingCard}">
              <StackPanel>
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <fa:FontAwesomeImage Grid.Column="0"
                                       Icon="SolidChartLine"
                                       Theme="{StaticResource TopStats.RankingIcon}"
                                       Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding DataContext.DamageMeterBindings.TranslationBurstDamageFiveSecondsTop5, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=BURST_DAMAGE_5_SECONDS_TOP_5}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}"
                             Theme="{StaticResource TopStats.RankingTitle}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TopBurstDamageFiveSeconds}"
                              ItemTemplate="{StaticResource DamageStatsEntryTemplate}"
                              Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
              </StackPanel>
            </Border>
            <Border Theme="{StaticResource DamageMeter.RankingCard}">
              <StackPanel>
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <fa:FontAwesomeImage Grid.Column="0"
                                       Icon="RegularClock"
                                       Theme="{StaticResource TopStats.RankingIcon}"
                                       Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding DataContext.DamageMeterBindings.TranslationBurstDamageTenSecondsTop5, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=BURST_DAMAGE_10_SECONDS_TOP_5}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}"
                             Theme="{StaticResource TopStats.RankingTitle}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TopBurstDamageTenSeconds}"
                              ItemTemplate="{StaticResource DamageStatsEntryTemplate}"
                              Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
              </StackPanel>
            </Border>
            <Border Theme="{StaticResource DamageMeter.RankingCard}">
              <StackPanel>
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <fa:FontAwesomeImage Grid.Column="0"
                                       Icon="SolidBolt"
                                       Theme="{StaticResource TopStats.RankingIcon}"
                                       Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding DataContext.DamageMeterBindings.TranslationTotalDamageTop5, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=TOTAL_DAMAGE_TOP_5}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}"
                             Theme="{StaticResource TopStats.RankingTitle}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TopTotalDamage}"
                              ItemTemplate="{StaticResource DamageStatsEntryTemplate}"
                              Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <UniformGrid Columns="4">
            <Border Theme="{StaticResource DamageMeter.RankingCard}">
              <StackPanel>
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <fa:FontAwesomeImage Grid.Column="0"
                                       Icon="RegularHeart"
                                       Theme="{StaticResource TopStats.RankingIcon}"
                                       Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding DataContext.DamageMeterBindings.TranslationEffectiveHealingTop5, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=EFFECTIVE_HEALING_TOP_5}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}"
                             Theme="{StaticResource TopStats.RankingTitle}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TopEffectiveHealing}"
                              ItemTemplate="{StaticResource DamageStatsEntryTemplate}"
                              Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}" />
              </StackPanel>
            </Border>
            <Border Theme="{StaticResource DamageMeter.RankingCard}">
              <StackPanel>
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <fa:FontAwesomeImage Grid.Column="0"
                                       Icon="SolidPlus"
                                       Theme="{StaticResource TopStats.RankingIcon}"
                                       Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding DataContext.DamageMeterBindings.TranslationOverhealTop5, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=OVERHEAL_TOP_5}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}"
                             Theme="{StaticResource TopStats.RankingTitle}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TopOverheals}"
                              ItemTemplate="{StaticResource DamageStatsEntryTemplate}"
                              Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}" />
              </StackPanel>
            </Border>
            <Border Theme="{StaticResource DamageMeter.RankingCard}">
              <StackPanel>
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <iconPacks:PackIconGameIcons Grid.Column="0"
                                               Grid.Row="0"
                                               Kind="SnakeBite"
                                               Theme="{StaticResource TopStats.RankingGameIcon}"
                                               Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding DataContext.DamageMeterBindings.TranslationDamageTakenTop5, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=DAMAGE_TAKEN_TOP_5}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                             Theme="{StaticResource TopStats.RankingTitle}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TopTakenDamage}"
                              ItemTemplate="{StaticResource DamageStatsEntryTemplate}"
                              Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
              </StackPanel>
            </Border>
            <Border Theme="{StaticResource DamageMeter.RankingCard}">
              <StackPanel>
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <fa:FontAwesomeImage Grid.Column="0"
                                       Icon="SolidUsers"
                                       Theme="{StaticResource TopStats.RankingIcon}"
                                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding DataContext.DamageMeterBindings.TranslationAttackedMobsPlayersTop5, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=ATTACKED_MOBS_PLAYERS_TOP_5}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}"
                             Theme="{StaticResource TopStats.RankingTitle}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TopAttackedTargets}"
                              ItemTemplate="{StaticResource DamageStatsEntryTemplate}"
                              Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Border Grid.Column="0" Theme="{StaticResource DamageMeter.RankingCard}">
              <StackPanel>
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <iconPacks:PackIconGameIcons Grid.Column="0"
                                               Grid.Row="0"
                                               Kind="SkullCrack"
                                               Theme="{StaticResource TopStats.RankingGameIcon}"
                                               Foreground="{DynamicResource SolidColorBrush.Accent.Orange.3}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding DataContext.DamageMeterBindings.TranslationTopMobKillContributionTop5, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=TOP_MOB_KILL_CONTRIBUTION_TOP_5}"
                             Foreground="{DynamicResource SolidColorBrush.Accent.Orange.3}"
                             Theme="{StaticResource TopStats.RankingTitle}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TopMobKillContribution}"
                              ItemTemplate="{StaticResource DamageStatsContributionEntryTemplate}"
                              Foreground="{DynamicResource SolidColorBrush.Accent.Orange.3}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Theme="{StaticResource DamageMeter.RankingCard}">
              <StackPanel>
                <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationDamageByType, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=DAMAGE_BY_TYPE}"
                           Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}"
                           Margin="2,0,0,5"
                           Theme="{StaticResource TopStats.RankingTitle}" />
                <ItemsControl ItemsSource="{Binding DamageTypeTotals}" ItemTemplate="{StaticResource DamageTypeStatsEntryTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Theme="{StaticResource DamageMeter.RankingCard}">
              <StackPanel>
                <TextBlock Text="{Binding DataContext.DamageMeterBindings.TranslationDamageByAbilityTop10, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=DAMAGE_BY_ABILITY_TOP_10}"
                           Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}"
                           Margin="2,0,0,4"
                           Theme="{StaticResource TopStats.RankingTitle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ContentControl Grid.Column="0"
                                  Content="{Binding TopDamageSpellsLeftColumn}"
                                  ContentTemplate="{StaticResource DamageSpellStatsColumnTemplate}"
                                  HorizontalContentAlignment="Stretch" />
                  <ContentControl Grid.Column="1"
                                  Content="{Binding TopDamageSpellsRightColumn}"
                                  ContentTemplate="{StaticResource DamageSpellStatsColumnTemplate}"
                                  HorizontalContentAlignment="Stretch" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <TabControl Background="{DynamicResource SolidColorBrush.Transparent}" BorderThickness="0">
      <TabItem Header="{Binding DamageMeterBindings.TranslationLive, FallbackValue=LIVE}">
        <TabControl Background="{DynamicResource SolidColorBrush.Transparent}" BorderThickness="0">
          <TabItem Header="{Binding DamageMeterBindings.TranslationMeter, FallbackValue=METER}">
            <Grid Margin="3,7,3,0">
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Theme="{StaticResource App.TopFilterCard}" Margin="0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Theme="{StaticResource App.FilterGroup}">
                    <StackPanel>
                      <TextBlock Text="{Binding Translation.Status, FallbackValue=STATUS}" Theme="{StaticResource App.FilterLabel}" />
                      <Button MinWidth="190"
                              HorizontalAlignment="Stretch"
                              Theme="{StaticResource Style.Button.Neutral}"
                              ToolTip.Tip="{Binding Translation.DamageMeterOnOff, FallbackValue=DAMAGE__METER__ON__OFF}"
                              Click="DamageMeterActivationToggle_Click">
                        <StackPanel Orientation="Horizontal">
                          <fa:FontAwesomeImage Width="16"
                                               Height="16"
                                               Margin="0,0,8,0"
                                               Icon="{Binding DamageMeterBindings.DamageMeterActivationToggleIcon, FallbackValue=SolidToggleOff}"
                                               Foreground="{Binding DamageMeterBindings.DamageMeterActivationToggleColor, Converter={x:Static conv:CompatBrushConverter.Instance}}"
                                               IsHitTestVisible="False" />
                          <Panel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Translation.TrackingIsNotActive, FallbackValue=TRACKING__IS__NOT__ACTIVE}"
                                       IsVisible="{Binding IsDamageMeterTrackingActive, Converter={x:Static BoolConverters.Not}}" />
                            <TextBlock Text="{Binding Translation.TrackingIsActive, FallbackValue=TRACKING__IS__ACTIVE}"
                                       IsVisible="{Binding IsDamageMeterTrackingActive}" />
                          </Panel>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Theme="{StaticResource App.FilterGroup}">
                    <StackPanel>
                      <TextBlock Text="{Binding Translation.Display, FallbackValue=DISPLAY}" Theme="{StaticResource App.FilterLabel}" />
                      <ComboBox Width="210"
                                ItemsSource="{Binding DamageMeterBindings.DamageMeterSort}"
                                SelectedItem="{Binding DamageMeterBindings.DamageMeterSortSelection}"
                                DisplayMemberBinding="{ReflectionBinding Name}"
                                SelectedValueBinding="{ReflectionBinding DamageMeterSortType}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Theme="{StaticResource App.FilterGroup}">
                    <StackPanel>
                      <TextBlock Text="{Binding DamageMeterBindings.TranslationContent, FallbackValue=CONTENT}"
                                 Theme="{StaticResource App.FilterLabel}" />
                      <ComboBox Width="210"
                                ItemsSource="{Binding DamageMeterBindings.DamageMeterContentFilters}"
                                SelectedItem="{Binding DamageMeterBindings.DamageMeterContentFilterSelection, Mode=TwoWay}"
                                DisplayMemberBinding="{ReflectionBinding Name}" />
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Theme="{StaticResource DamageMeter.ActionButton}"
                            ToolTip.Tip="{Binding Translation.OpenExtendedDamageMeterWindow, FallbackValue=OPEN__EXTENDED__DAMAGE__METER__WINDOW}"
                            Click="OpenDamageMeterWindow_Click">
                      <fa:FontAwesomeImage Icon="SolidExpand" Theme="{StaticResource DamageMeter.ActionIcon}" />
                    </Button>
                    <Button Theme="{StaticResource DamageMeter.ActionButton}"
                            ToolTip.Tip="{Binding Translation.CopyToClipboard, FallbackValue=COPY__TO__CLIPBOARD}"
                            Click="CopyDamageMeterToClipboard_Click">
                      <fa:FontAwesomeImage Icon="RegularCopy" Theme="{StaticResource DamageMeter.ActionIcon}" />
                    </Button>
                    <Button Theme="{StaticResource DamageMeter.ActionButton}"
                            ToolTip.Tip="{Binding DamageMeterBindings.TranslationTakeASnapshotOfDamageMeterDescription, FallbackValue=TAKE_A_SNAPSHOT_OF_DAMAGE_METER}"
                            Click="TakeSnapshot_Click">
                      <fa:FontAwesomeImage Icon="SolidCamera" Theme="{StaticResource DamageMeter.ActionIcon}" />
                    </Button>
                    <Button Theme="{StaticResource DamageMeter.ActionButton}"
                            ToolTip.Tip="{Binding Translation.DamageMeter, FallbackValue=DAMAGE__METER}"
                            PointerEntered="OpenDamageMeterInfoPopup_MouseEnter"
                            PointerExited="CloseDamageMeterInfoPopup_MouseLeave">
                      <fa:FontAwesomeImage Icon="SolidCircleInfo" Theme="{StaticResource DamageMeter.ActionIcon}" />
                    </Button>
                    <Button Content="{Binding Translation.ResetDamageMeter, FallbackValue=RESET__DAMAGE__METER}"
                            Margin="2,0,0,0"
                            Theme="{StaticResource DamageMeter.DangerButton}"
                            Click="ResetDamageMeter_Click" />
                  </StackPanel>
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="2" Margin="-3,0,0,0" Theme="{StaticResource DamageMeter.Live.PlayerList}">
                <ItemsControl ItemsSource="{Binding DamageMeterBindings.DamageMeter, Mode=OneWay}"
                              ItemTemplate="{StaticResource DamageMeterFragmentTemplate}" />
              </ScrollViewer>
              <ListBox Grid.Row="2"
                       Margin="-3,0,0,0"
                       Theme="{StaticResource DamageMeter.Live.MobList}"
                       ItemsSource="{Binding DamageMeterBindings.MobDamageMeter, Mode=OneWay}"
                       ItemTemplate="{StaticResource MobDamageMeterFragmentTemplate}" />
              <Grid Grid.Row="2"
                    ZIndex="1"
                    IsVisible="{Binding IsDamageMeterPopupVisible, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                    Background="{DynamicResource SolidColorBrush.Background.2}">
                <StackPanel Margin="14,12">
                  <DockPanel Margin="0,0,0,16">
                    <Grid Theme="{StaticResource DamageMeter.DescriptionIcon}">
                      <fa:FontAwesomeImage Icon="RegularCircleDot" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.DamageMeterDescription1}" Theme="{StaticResource DamageMeter.DescriptionText}" />
                  </DockPanel>
                  <DockPanel Margin="0,0,0,16">
                    <Grid Theme="{StaticResource DamageMeter.DescriptionIcon}">
                      <fa:FontAwesomeImage Icon="RegularCircleDot" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.DamageMeterDescription2}" Theme="{StaticResource DamageMeter.DescriptionText}" />
                  </DockPanel>
                </StackPanel>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="{Binding DamageMeterBindings.TranslationTopStats, FallbackValue=TOP_STATS}">
            <ContentControl Content="{Binding DamageMeterBindings.CurrentDamageStats}" ContentTemplate="{StaticResource DamageStatsSnapshotTemplate}" />
          </TabItem>
          <TabItem Header="{Binding DamageMeterBindings.TranslationYourStats, FallbackValue=YOUR_STATS}">
            <ContentControl Content="{Binding DamageMeterBindings.CurrentYourStats}" ContentTemplate="{StaticResource YourStatsSnapshotTemplate}" />
          </TabItem>
          <TabItem Header="{Binding Translation.Settings, FallbackValue=SETTINGS}">
            <ScrollViewer Padding="10,10,12,0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch">
              <Border Theme="{StaticResource Settings.Card}">
                <StackPanel>
                  <Border Theme="{StaticResource Settings.CardHeader}">
                    <TextBlock Text="{Binding Translation.Settings, FallbackValue=SETTINGS}" Theme="{StaticResource Settings.CardTitle}" />
                  </Border>
                  <Grid Margin="14,12,14,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <CheckBox IsChecked="{Binding DamageMeterBindings.IsDamageMeterResetByMapChangeActive}"
                                Theme="{StaticResource DamageMeter.SettingCheckBox}">
                        <TextBlock Text="{Binding Translation.MapChangeReset, FallbackValue=MAP__CHANGE__RESET}" TextWrapping="Wrap" />
                      </CheckBox>
                      <CheckBox IsChecked="{Binding DamageMeterBindings.IsDamageMeterResetBeforeCombatActive}"
                                Theme="{StaticResource DamageMeter.SettingCheckBox}">
                        <TextBlock Text="{Binding Translation.ResetBeforeCombat, FallbackValue=RESET__BEFORE__COMBAT}" TextWrapping="Wrap" />
                      </CheckBox>
                      <CheckBox IsChecked="{Binding DamageMeterBindings.IsSnapshotAfterMapChangeActive}"
                                Theme="{StaticResource DamageMeter.SettingCheckBox}">
                        <TextBlock Text="{Binding Translation.SnapshotAfterMapChange, FallbackValue=SNAPSHOT__AFTER__MAP__CHANGE}" TextWrapping="Wrap" />
                      </CheckBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <CheckBox IsChecked="{Binding DamageMeterBindings.ShortDamageMeterToClipboard}"
                                Theme="{StaticResource DamageMeter.SettingCheckBox}">
                        <TextBlock Text="{Binding Translation.CopyShortDamageMeterToTheClipboard, FallbackValue=COPY__SHORT__DAMAGE__METER__TO__THE__CLIPBOARD}"
                                   TextWrapping="Wrap" />
                      </CheckBox>
                      <CheckBox IsChecked="{Binding DamageMeterBindings.OnlyDamageToPlayersCounts}"
                                Theme="{StaticResource DamageMeter.SettingCheckBox}">
                        <TextBlock Text="{Binding Translation.OnlyDamageToPlayersCounts, FallbackValue=ONLY__DAMAGE__TO__PLAYERS__COUNTS}"
                                   TextWrapping="Wrap" />
                      </CheckBox>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </TabItem>
      <TabItem Header="{Binding DamageMeterBindings.TranslationSnapshots, FallbackValue=SNAPSHOTS}">
        <Grid Margin="10,10,10,0">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Theme="{StaticResource App.TopFilterCard}" Margin="0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition Width="*" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Theme="{StaticResource App.FilterGroup}">
                <StackPanel>
                  <TextBlock Text="{Binding DamageMeterBindings.TranslationSnapshots, FallbackValue=SNAPSHOTS}"
                             Theme="{StaticResource App.FilterLabel}" />
                  <ComboBox Width="240"
                            ItemsSource="{Binding DamageMeterBindings.DamageMeterSnapshots}"
                            SelectedItem="{Binding DamageMeterBindings.DamageMeterSnapshotSelection}"
                            DisplayMemberBinding="{ReflectionBinding TimestampString}"
                            SelectedValueBinding="{ReflectionBinding DamageMeter}" />
                  <ProgressBar Height="2"
                               Margin="0,0,0,0"
                               IsIndeterminate="True"
                               IsVisible="{Binding DamageMeterBindings.DamageMeterSnapshotLoadBarVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Theme="{StaticResource App.FilterGroup}" Margin="8,0,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding DamageMeterBindings.TranslationContent, FallbackValue=CONTENT}" Theme="{StaticResource App.FilterLabel}" />
                  <ComboBox Width="210"
                            ItemsSource="{Binding DamageMeterBindings.DamageMeterContentFilters}"
                            SelectedItem="{Binding DamageMeterBindings.DamageMeterSnapshotContentFilterSelection, Mode=TwoWay}"
                            DisplayMemberBinding="{ReflectionBinding Name}" />
                </StackPanel>
              </Border>
              <WrapPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="{Binding DamageMeterBindings.TranslationDeleteSelectedSnapshot, FallbackValue=DELETE__SELECTED__SNAPSHOT}"
                        Margin="0,0,8,0"
                        Theme="{StaticResource DamageMeter.DangerButton}"
                        Click="DeleteSelectedSnapshot_Click" />
                <Button Content="{Binding DamageMeterBindings.TranslationDeleteAllSnapshots, FallbackValue=DELETE__ALL__SNAPSHOTS}"
                        Margin="0,0,8,0"
                        Theme="{StaticResource DamageMeter.DangerButton}"
                        Click="DeleteAllSnapshots_Click" />
                <Button Theme="{StaticResource DamageMeter.TextButton}"
                        ToolTip.Tip="{Binding Translation.CopyToClipboard, FallbackValue=COPY__TO__CLIPBOARD}"
                        Click="CopySnapshotToClipboard_Click">
                  <StackPanel Orientation="Horizontal">
                    <fa:FontAwesomeImage Icon="RegularCopy" Width="14" Height="14" Margin="0,0,8,0" Theme="{StaticResource Style.Button.Icon.White}" />
                    <TextBlock Text="{Binding Translation.CopyToClipboard, FallbackValue=COPY__TO__CLIPBOARD}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </WrapPanel>
            </Grid>
          </Border>
          <TabControl Grid.Row="2" Background="{DynamicResource SolidColorBrush.Transparent}" BorderThickness="0">
            <TabItem Header="{Binding DamageMeterBindings.TranslationMeter, FallbackValue=METER}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition Height="8" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Theme="{StaticResource App.TopFilterCard}" Margin="0,5,0,0">
                  <Grid>
                    <Border HorizontalAlignment="Left" Theme="{StaticResource App.FilterGroup}">
                      <StackPanel>
                        <TextBlock Text="{Binding Translation.Display, FallbackValue=DISPLAY}" Theme="{StaticResource App.FilterLabel}" />
                        <ComboBox Width="210"
                                  ItemsSource="{Binding DamageMeterBindings.DamageMeterSnapshotSort}"
                                  SelectedItem="{Binding DamageMeterBindings.DamageMeterSnapshotSortSelection}"
                                  DisplayMemberBinding="{ReflectionBinding Name}"
                                  SelectedValueBinding="{ReflectionBinding DamageMeterSortType}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" Margin="-3,0,0,0" Theme="{StaticResource DamageMeter.Snapshot.PlayerList}">
                  <ItemsControl ItemsSource="{Binding DamageMeterBindings.DamageMeterSnapshotSelection?.DamageMeter, Mode=OneWay}"
                                ItemTemplate="{StaticResource DamageMeterSnapshotFragmentTemplate}" />
                </ScrollViewer>
                <ListBox Grid.Row="2"
                         Margin="-3,0,0,0"
                         Theme="{StaticResource DamageMeter.Snapshot.MobList}"
                         ItemsSource="{Binding DamageMeterBindings.DamageMeterSnapshotSelection?.MobDamageMeter, Mode=OneWay}"
                         ItemTemplate="{StaticResource MobDamageMeterFragmentTemplate}" />
              </Grid>
            </TabItem>
            <TabItem Header="{Binding DamageMeterBindings.TranslationTopStats, FallbackValue=TOP_STATS}">
              <ContentControl Content="{Binding DamageMeterBindings.SnapshotDamageStats}"
                              ContentTemplate="{StaticResource DamageStatsSnapshotTemplate}" />
            </TabItem>
            <TabItem Header="{Binding DamageMeterBindings.TranslationYourStats, FallbackValue=YOUR_STATS}">
              <ContentControl Content="{Binding DamageMeterBindings.SnapshotYourStats}" ContentTemplate="{StaticResource YourStatsSnapshotTemplate}" />
            </TabItem>
          </TabControl>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
