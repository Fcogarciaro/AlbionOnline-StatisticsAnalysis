<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Class="StatisticsAnalysisTool.UserControls.InformationBarControl"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignHeight="70" d:DesignWidth="800">

  <Grid ZIndex="3" Theme="{StaticResource Grid.Information.Bar}">
    <Button ZIndex="1" Theme="{StaticResource Window.Information.Bar.Button.Style}" Click="BtnInformationBar_Click" />
    <Grid RowDefinitions="35,35">
      <TextBlock Grid.Row="0"
                 Theme="{StaticResource Grid.Information.Bar.Label}"
                 Text="{Binding InformationText, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=INFORMATION}" />
      <TextBlock Grid.Row="1"
                 Theme="{StaticResource Grid.Information.Bar.CopyLink}"
                 Text="Copy to clipboard"
                 PointerReleased="CopyToClipboard_PointerReleased" />
    </Grid>
    <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.1}" IsHitTestVisible="False" />
    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.1}" IsHitTestVisible="False" />
    <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.5}" IsHitTestVisible="False" />
    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.5}" IsHitTestVisible="False" />
  </Grid>
</UserControl>
