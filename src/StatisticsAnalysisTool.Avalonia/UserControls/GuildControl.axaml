<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
             xmlns:gl="clr-namespace:System.Globalization;assembly=System.Runtime"
             x:Class="StatisticsAnalysisTool.UserControls.GuildControl"
             x:DataType="viewModels:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="800">
    <Grid>
        <TabControl SelectedIndex="1" Background="Transparent">
            <TabItem Header="{Binding GuildBindings.TranslationLootLogChecker, FallbackValue=LOOT_LOG_CHECKER}" IsVisible="False">
                
            </TabItem>
            <TabItem Header="{Binding GuildBindings.TranslationSiphonedEnergy, FallbackValue=SIPHONED_ENERGY}">
                <ScrollViewer x:Name="SiphonedEnergyScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <Grid MinWidth="1360"
                          Width="{Binding Viewport.Width, ElementName=SiphonedEnergyScrollViewer, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ContentControl Grid.Row="0"
                                        ContentTemplate="{StaticResource ManuallySiphonedEnergy.Template}"
                                        Content="{Binding GuildBindings.ManuallySiphonedEnergy}" />

                        <Grid Grid.Row="1" Margin="12,0,12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Theme="{StaticResource App.FilterCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Grid.ColumnSpan="3"
                                                   Text="{Binding GuildBindings.TranslationTotalOverview, FallbackValue=TOTAL_OVERVIEW}"
                                                   Theme="{StaticResource Dashboard.SectionTitle}" />

                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,8,0,0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding GuildBindings.SiphonedEnergyLastUpdateVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                                            <TextBlock Text="{Binding GuildBindings.TranslationLastUpdate, StringFormat='{}{0:N0}: ', FallbackValue=LAST_UPDATE:}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SolidColorBrush.Text.4}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding GuildBindings.SiphonedEnergyLastUpdate, StringFormat='{}{0} UTC', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=00:00:00}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SolidColorBrush.Text.4}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="2"
                                                    Margin="0,8,0,0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GuildBindings.TranslationTotal, StringFormat='{}{0:N0}: ', FallbackValue='TOTAL: '}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SolidColorBrush.Text.4}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding GuildBindings.TotalSiphonedEnergyQuantity, StringFormat='{}{0} ', FallbackValue=0}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SolidColorBrush.Text.4}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Separator Grid.Row="1" Height="4" Background="{DynamicResource SolidColorBrush.Background.2}" />

                                    <ScrollViewer Grid.Row="2" Margin="0,20,0,0" Background="{DynamicResource SolidColorBrush.Accent.Blue.Transparent.5}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                                        <ItemsControl ItemsSource="{Binding GuildBindings.SiphonedEnergyOverviewList, Mode=OneWay}" ItemTemplate="{StaticResource SiphonedEnergyOverviewItemTemplate}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Theme="{StaticResource App.FilterCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding GuildBindings.TranslationDetails, FallbackValue=DETAILS}"
                                                   Theme="{StaticResource Dashboard.SectionTitle}" />
                                        <StackPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="{Binding GuildBindings.TranslationDeleteSelectedEntries, FallbackValue=DELETE__SELECTED__ENTRIES}"
                                                    ContentTemplate="{StaticResource Template.Button.Content.Spacious}"
                                                    IsEnabled="{Binding TradeMonitoringBindings.IsDeleteTradesButtonEnabled}"
                                                    Theme="{StaticResource Style.Button.Danger}"
                                                    Click="BtnDeleteSelectedSiphonedEnergyEntries_Click" />
                                            <Button Content="{Binding GuildBindings.TranslationSelectDeselectAll, FallbackValue=SELECT__DESELECT__ALL}"
                                                    ContentTemplate="{StaticResource Template.Button.Content.Spacious}"
                                                    Margin="8,0,0,0"
                                                    MaxWidth="300"
                                                    Click="BtnSelectSwitchAllSiphonedEnergyEntries_Click" />
                                            <Grid Width="20"
                                                  Height="20"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  PointerEntered="OpenSiphonedEnergyInfoPopup_MouseEnter"
                                                  PointerExited="CloseSiphonedEnergyInfoPopup_MouseLeave">
                                                <fa:FontAwesomeImage Icon="SolidCircleInfo" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                                        <ItemsControl ItemsSource="{Binding GuildBindings.SiphonedEnergyCollectionView, Mode=OneWay}" ItemTemplate="{StaticResource SiphonedEnergyItemTemplate}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid IsVisible="{Binding GuildBindings.GuildPopupVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}, FallbackValue=False}" Margin="0,220,0,0" Background="{DynamicResource SolidColorBrush.Background.2}">
            <StackPanel Margin="10,0">
                <StackPanel Orientation="Horizontal">
                    <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                        <fa:FontAwesomeImage Icon="RegularCircleDot" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.SiphonedEnergyDescription1}" Foreground="{DynamicResource SolidColorBrush.Text.1}" 
                                   FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                        <fa:FontAwesomeImage Icon="RegularCircleDot" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.SiphonedEnergyDescription2}" Foreground="{DynamicResource SolidColorBrush.Text.1}" 
                                   FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                        <fa:FontAwesomeImage Icon="RegularCircleDot" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.SiphonedEnergyDescription3}" Foreground="{DynamicResource SolidColorBrush.Text.1}" 
                                   FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                        <fa:FontAwesomeImage Icon="RegularCircleDot" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.SiphonedEnergyDescription4}" Foreground="{DynamicResource SolidColorBrush.Text.1}" FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
                <Image Margin="0,10" Source="avares://StatisticsAnalysisTool/Assets/siphoned_energy_description01.jpg" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
