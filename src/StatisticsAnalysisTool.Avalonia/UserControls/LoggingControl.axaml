<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
             xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
             xmlns:eventLogging="clr-namespace:StatisticsAnalysisTool.EventLogging"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             x:Class="StatisticsAnalysisTool.UserControls.LoggingControl"
             x:DataType="viewModels:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1000">
    <UserControl.Resources>
        <ControlTheme x:Key="Logging.ComparatorSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush.Text.1}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </ControlTheme>

        <DataTemplate x:Key="LootLoggerStatsEntryTemplate" DataType="eventLogging:LootLoggerStatsEntry" x:CompileBindings="False">
            <StackPanel Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{}{0}.'}"
                               Foreground="{DynamicResource SolidColorBrush.Text.2}" FontSize="15" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               Foreground="{DynamicResource SolidColorBrush.Text.1}" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding ValueString}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               HorizontalAlignment="Right" FontSize="15" FontWeight="Bold" />
                </Grid>
                <TextBlock Margin="24,-1,0,0" Foreground="{DynamicResource SolidColorBrush.Text.3}" FontSize="13"
                           IsVisible="{Binding DetailVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}: {1}">
                            <Binding Path="DataContext.LoggingBindings.Translation.Killer" RelativeSource="{RelativeSource AncestorType=UserControl}" FallbackValue="Killer" />
                            <Binding Path="Detail" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="LootLoggerStatsDetailEntryTemplate" DataType="eventLogging:LootLoggerStatsEntry" x:CompileBindings="False">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{}{0}.'}" Foreground="{DynamicResource SolidColorBrush.Text.2}" 
                               FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                    <Image Grid.Column="1" Source="{Binding Icon}" Width="36" Height="36" Stretch="Fill" Margin="0,4,0,0"
                           IsVisible="{Binding IconVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SolidColorBrush.Text.1}" FontSize="16" TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{DynamicResource SolidColorBrush.Accent.Blue.1}" FontSize="12" 
                                   IsVisible="{Binding DetailVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding ValueString}" 
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="LootLoggerStatsTemplate" DataType="eventLogging:LootLoggerStats" x:CompileBindings="False">
            <Grid Margin="0,5,0,0">
                <ScrollViewer>
                    <UniformGrid Columns="2">
                        <Border Margin="0,2,10,4" Padding="4,3" BorderBrush="{DynamicResource SolidColorBrush.Accent.Yellow.3}" BorderThickness="0,1,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.LoggingBindings.Translation.LootStats, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Loot'}"
                                           Foreground="{DynamicResource SolidColorBrush.Accent.Yellow.3}" FontWeight="Bold" Margin="0,0,0,2" FontSize="16" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="125"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DataContext.LoggingBindings.Translation.TotalLootValue, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Total Loot Value'}"
                                               Foreground="{DynamicResource SolidColorBrush.Text.1}" FontSize="14" Margin="0,0,0,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalLootValue}" Foreground="{DynamicResource SolidColorBrush.Accent.Yellow.3}"
                                               HorizontalAlignment="Right" FontSize="15" FontWeight="Bold" Margin="0,0,0,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DataContext.LoggingBindings.Translation.LootValuePerHour, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Loot Value per Hour'}"
                                               Foreground="{DynamicResource SolidColorBrush.Text.1}" FontSize="14" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LootValuePerHour}" Foreground="{DynamicResource SolidColorBrush.Accent.Yellow.3}"
                                               HorizontalAlignment="Right" FontSize="15" FontWeight="Bold" />
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Border Margin="10,2,0,8" Padding="5" BorderBrush="{DynamicResource SolidColorBrush.Accent.Yellow.3}" BorderThickness="0,1,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.LoggingBindings.Translation.BestSingleLoot, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Best Single Item'}"
                                           Foreground="{DynamicResource SolidColorBrush.Accent.Yellow.3}" FontWeight="Bold" Margin="0,0,0,5" FontSize="16" />
                                <ItemsControl ItemsSource="{Binding BestSingleLoots}" ItemTemplate="{StaticResource LootLoggerStatsDetailEntryTemplate}"
                                              Foreground="{DynamicResource SolidColorBrush.Accent.Yellow.3}" />
                            </DockPanel>
                        </Border>

                        <Border Margin="0,2,10,8" Padding="5" BorderBrush="{DynamicResource SolidColorBrush.Value.Silver}" BorderThickness="0,1,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.LoggingBindings.Translation.HighestKillValue, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Highest Kill Value'}"
                                           Foreground="{DynamicResource SolidColorBrush.Value.Silver}" FontWeight="Bold" Margin="0,0,0,5" FontSize="16" />
                                <ItemsControl ItemsSource="{Binding HighestKillValues}" ItemTemplate="{StaticResource LootLoggerStatsEntryTemplate}"
                                              Foreground="{DynamicResource SolidColorBrush.Value.Silver}" />
                            </DockPanel>
                        </Border>

                        <Border Margin="10,2,0,8" Padding="5" BorderBrush="{DynamicResource SolidColorBrush.Accent.Green.3}" BorderThickness="0,1,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.LoggingBindings.Translation.HighestLootedValue, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Highest Looted Value'}"
                                           Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}" FontWeight="Bold" Margin="0,0,0,5" FontSize="16" />
                                <ItemsControl ItemsSource="{Binding HighestLootedValues}" ItemTemplate="{StaticResource LootLoggerStatsEntryTemplate}"
                                              Foreground="{DynamicResource SolidColorBrush.Accent.Green.3}" />
                            </DockPanel>
                        </Border>

                        <Border Margin="0,2,10,8" Padding="5" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" BorderThickness="0,1,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.LoggingBindings.Translation.MostLootedItems, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Most Looted Items'}"
                                           Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" FontWeight="Bold" Margin="0,0,0,5" FontSize="16" />
                                <ItemsControl ItemsSource="{Binding MostLootedItems}" ItemTemplate="{StaticResource LootLoggerStatsEntryTemplate}"
                                              Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
                            </DockPanel>
                        </Border>

                        <Border Margin="10,2,0,8" Padding="5" BorderBrush="{DynamicResource SolidColorBrush.Accent.Red.2}" BorderThickness="0,1,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.LoggingBindings.Translation.MostKills, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Most Kills'}"
                                           Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" FontWeight="Bold" Margin="0,0,0,5" FontSize="16" />
                                <ItemsControl ItemsSource="{Binding MostKills}" ItemTemplate="{StaticResource LootLoggerStatsEntryTemplate}"
                                              Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
                            </DockPanel>
                        </Border>

                        <Border Margin="0,2,10,8" Padding="5" BorderBrush="{DynamicResource SolidColorBrush.Accent.Orange.3}" BorderThickness="0,1,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.LoggingBindings.Translation.MostDeaths, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Most Deaths'}"
                                           Foreground="{DynamicResource SolidColorBrush.Accent.Orange.3}" FontWeight="Bold" Margin="0,0,0,5" FontSize="16" />
                                <ItemsControl ItemsSource="{Binding MostDeaths}" ItemTemplate="{StaticResource LootLoggerStatsEntryTemplate}"
                                              Foreground="{DynamicResource SolidColorBrush.Accent.Orange.3}" />
                            </DockPanel>
                        </Border>
                    </UniformGrid>
                </ScrollViewer>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="{Binding Translation.Logging, FallbackValue=LOGGING}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Theme="{StaticResource App.TopFilterCard}">
                        <WrapPanel VerticalAlignment="Bottom">
                            <Border Margin="0,0,12,8" Theme="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Translation.Logging, FallbackValue=LOGGING}"
                                               Theme="{StaticResource App.FilterLabel}" />
                                    <Button Width="180" Height="32"
                                            Theme="{StaticResource Style.Button.Neutral}"
                                            ToolTip.Tip="{Binding Translation.Logging}"
                                            Click="LoggingActivationToggle_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:FontAwesomeImage Theme="{StaticResource Logging.ToggleIcon}" Classes.on="{Binding LoggingBindings.IsLoggingTrackingActive}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Translation.TrackingIsActive}" IsVisible="{Binding LoggingBindings.IsLoggingTrackingActive}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Translation.TrackingIsNotActive}" IsVisible="{Binding !LoggingBindings.IsLoggingTrackingActive}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,12,8" Theme="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Translation.Search, FallbackValue=SEARCH}"
                                               Theme="{StaticResource App.FilterLabel}" />
                                    <TextBox Text="{Binding LoggingSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="240" Height="32" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,12,8" Theme="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LoggingBindings.Translation.Filter, FallbackValue=FILTER}"
                                               Theme="{StaticResource App.FilterLabel}" />
                                    <WrapPanel>
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.FilterAll, FallbackValue=ALL}"
                                                      IsChecked="{Binding LoggingBindings.IsAllNotificationFilterSelected, Mode=OneWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}"
                                                      Click="AllNotificationFilters_Click" />
                                        <ItemsControl ItemsSource="{Binding LoggingBindings.Filters}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="eventLogging:LoggingFilterObject">
                                                    <ToggleButton Content="{Binding Name}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Theme="{StaticResource App.FilterToggleButton}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,12,8" Theme="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LoggingBindings.Translation.Tracking, FallbackValue=TRACKING}"
                                               Theme="{StaticResource App.FilterLabel}" />
                                    <WrapPanel>
                                        <ToggleButton Content="{Binding Translation.TrackPartyLootOnly, FallbackValue=TRACK__PARTY__LOOT__ONLY}"
                                                      IsChecked="{Binding LoggingBindings.IsTrackingPartyLootOnly, Mode=TwoWay, FallbackValue=true}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding Translation.TrackingSilver, FallbackValue=TRACKING__SILVER}"
                                                      IsChecked="{Binding LoggingBindings.IsTrackingSilver, Mode=TwoWay, FallbackValue=true}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding Translation.TrackingFame, FallbackValue=TRACKING__FAME}"
                                                      IsChecked="{Binding LoggingBindings.IsTrackingFame, Mode=TwoWay, FallbackValue=true}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding Translation.TrackingMobLoot, FallbackValue=TRACKING__MOB__LOOT}"
                                                      IsChecked="{Binding LoggingBindings.IsTrackingMobLoot, Mode=TwoWay, FallbackValue=true}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding Translation.TrackingPlayerLoot, FallbackValue=TRACKING__PLAYER__LOOT}"
                                                      IsChecked="{Binding LoggingBindings.IsTrackingPlayerLoot, Mode=TwoWay, FallbackValue=true}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding Translation.TrackingKills, FallbackValue=TRACKING__KILLS}"
                                                      IsChecked="{Binding LoggingBindings.IsTrackingKill, Mode=TwoWay, FallbackValue=true}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding LoggingBindings.Translation.LootComparatorActions, FallbackValue=ACTIONS}"
                                           Theme="{StaticResource App.FilterLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <Grid Height="32" Width="32" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <fa:FontAwesomeImage Icon="SolidFileCsv" ToolTip.Tip="{Binding Translation.ExportLootToFile}"
                                                          Width="30" Height="30" Foreground="{DynamicResource SolidColorBrush.Accent.Green.4}"
                                                          PointerReleased="BtnExportLootToFile_MouseUp" Cursor="Hand" />
                                    </Grid>
                                    <Grid Height="32" Width="32" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <fa:FontAwesomeImage Icon="SolidFileCode" ToolTip.Tip="{Binding Translation.ExportLootToJsonFile}"
                                                          Width="30" Height="30" Foreground="{DynamicResource SolidColorBrush.Accent.Green.4}"
                                                          PointerReleased="BtnExportLootToJsonFile_MouseUp" Cursor="Hand" />
                                    </Grid>
                                    <Button Content="{Binding Translation.ResetTrackingNotifications, FallbackValue=RESET__TRACKING__NOTIFICATIONS}"
                                            Height="32" MaxWidth="500" MinWidth="210"
                                            VerticalAlignment="Center" Theme="{StaticResource Style.Button.Danger}"
                                            Click="BtnTrackingNotificationsReset_Click" />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <TabItem Header="{Binding LoggingBindings.Translation.Notifications, FallbackValue=NOTIFICATIONS}">
                            <ListBox Background="Transparent"
                                     BorderThickness="0"
                                     SelectionMode="Single"
                                     ItemsSource="{Binding LoggingBindings.GameLoggingCollectionView, Mode=OneWay}"
                                     ItemTemplate="{StaticResource NotificationTemplate}"
                                     ItemContainerTheme="{StaticResource Logging.PlainListBoxItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <!-- VirtualizingStackPanel: thousands of events only realize the visible rows. -->
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="{Binding LoggingBindings.Translation.Stats, FallbackValue=STATS}">
                            <ContentControl Content="{Binding LoggingBindings.LootLoggerStats}" ContentTemplate="{StaticResource LootLoggerStatsTemplate}" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding Translation.LootComparator, FallbackValue=LOOT__COMPARATOR}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Theme="{StaticResource App.TopFilterCard}" IsEnabled="{Binding LoggingBindings.IsAllButtonsEnabled}">
                        <WrapPanel VerticalAlignment="Bottom">
                            <Grid Height="45" Width="32" Margin="0,0,0,0" VerticalAlignment="Bottom">
                                <fa:FontAwesomeImage Icon="SolidFilter" Width="18" Height="18" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                            </Grid>

                            <Border Margin="0,0,12,8" Theme="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Translation.LootComparator, FallbackValue=LOOT__COMPARATOR}"
                                               Theme="{StaticResource App.FilterLabel}" />
                                    <Button Width="180" Height="32" Theme="{StaticResource Style.Button.Neutral}" ToolTip.Tip="{Binding Translation.LootComparator}"
                                            Click="LootComparatorActivationToggle_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:FontAwesomeImage Theme="{StaticResource Logging.ToggleIcon}" Classes.on="{Binding LoggingBindings.IsLootComparatorTrackingActive}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Translation.TrackingIsActive}" IsVisible="{Binding LoggingBindings.IsLootComparatorTrackingActive}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Translation.TrackingIsNotActive}" IsVisible="{Binding !LoggingBindings.IsLootComparatorTrackingActive}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,12,8" Theme="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LoggingBindings.Translation.FilterStatus, FallbackValue=STATUS}"
                                               Theme="{StaticResource App.FilterLabel}" />
                                    <WrapPanel>
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.FilterAll, FallbackValue=ALL}"
                                                      IsChecked="{Binding LoggingBindings.IsAllStatusFilterSelected, Mode=OneWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}"
                                                      Click="AllStatusFilters_Click" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.Lost, FallbackValue=LOST}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingLost, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.Resolved, FallbackValue=RESOLVED}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingResolved, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.Donated, FallbackValue=DONATED}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingDonated, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.Trash, FallbackValue=TRASH}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingTrash, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,12,8" Theme="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LoggingBindings.Translation.FilterTier, FallbackValue=TIER}"
                                               Theme="{StaticResource App.FilterLabel}" />
                                    <WrapPanel>
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.FilterAll, FallbackValue=ALL}"
                                                      IsChecked="{Binding LoggingBindings.IsAllTierFilterSelected, Mode=OneWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}"
                                                      Click="AllTierFilters_Click" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.T1ToT3, FallbackValue=T1-T3}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingT1ToT3, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.T4, FallbackValue=T4}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingT4, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.T5, FallbackValue=T5}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingT5, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.T6, FallbackValue=T6}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingT6, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.T7, FallbackValue=T7}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingT7, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.T8, FallbackValue=T8}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingT8, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,12,8" Theme="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LoggingBindings.Translation.FilterType, FallbackValue=TYPE}"
                                               Theme="{StaticResource App.FilterLabel}" />
                                    <WrapPanel>
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.FilterAll, FallbackValue=ALL}"
                                                      IsChecked="{Binding LoggingBindings.IsAllTypeFilterSelected, Mode=OneWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}"
                                                      Click="AllTypeFilters_Click" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.Food, FallbackValue=FOOD}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingFood, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.Potion, FallbackValue=POTION}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingPotion, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.Bag, FallbackValue=BAG}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingBag, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.Cape, FallbackValue=CAPE}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingCape, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.Weapon, FallbackValue=WEAPON}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingWeapon, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.Armor, FallbackValue=ARMOR}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingArmor, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.Mount, FallbackValue=MOUNT}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingMount, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                        <ToggleButton Content="{Binding LoggingBindings.Translation.Others, FallbackValue=OTHERS}"
                                                      IsChecked="{Binding LoggingBindings.IsShowingOthers, Mode=TwoWay}"
                                                      Theme="{StaticResource App.FilterToggleButton}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,12,8" Theme="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LoggingBindings.Translation.Guild, FallbackValue=GUILD}"
                                               Theme="{StaticResource App.FilterLabel}" />
                                    <ToggleButton x:Name="GuildFilterDropdownToggle"
                                                  Width="220"
                                                  Content="{Binding LoggingBindings.GuildFilterSummary}"
                                                  IsChecked="{Binding #GuildFilterDropdownPopup.IsOpen, Mode=TwoWay}"
                                                  Theme="{StaticResource App.FilterDropdownButton}" />
                                    <Popup x:Name="GuildFilterDropdownPopup"
                                           PlacementTarget="{Binding #GuildFilterDropdownToggle}"
                                           Placement="Bottom"
                                           VerticalOffset="2"
                                           IsLightDismissEnabled="True"
                                           OverlayInputPassThroughElement="{Binding #GuildFilterDropdownToggle}">
                                        <Border Width="{Binding Bounds.Width, ElementName=GuildFilterDropdownToggle}"
                                                Theme="{StaticResource App.FilterDropdownPopup}">
                                            <StackPanel>
                                                <ToggleButton Content="{Binding LoggingBindings.Translation.FilterAll, FallbackValue=ALL}"
                                                              IsChecked="{Binding LoggingBindings.IsAllGuildFilterSelected, Mode=OneWay}"
                                                              Theme="{StaticResource App.FilterToggleButton}"
                                                              Margin="0,0,0,6"
                                                              Click="AllGuildFilters_Click" />
                                                <Separator Margin="0,0,0,6"
                                                           Background="{DynamicResource SolidColorBrush.Background.4}" />
                                                <ScrollViewer MaxHeight="240"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding LoggingBindings.LootComparatorGuildFilters}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="eventLogging:LootComparatorGuildFilter">
                                                                <ToggleButton Content="{Binding Name}"
                                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                              Theme="{StaticResource App.FilterToggleButton}"
                                                                              HorizontalAlignment="Stretch"
                                                                              Margin="0,0,0,4" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Border>

                            <Grid Height="53" Width="32" Margin="0,0,0,0" Cursor="Hand" VerticalAlignment="Bottom" Background="Transparent" PointerReleased="ToggleLootComparatorInfoPopup_MouseUp">
                                <fa:FontAwesomeImage Icon="SolidCircleInfo" IsHitTestVisible="False" Width="18" Height="18" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                            </Grid>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,8" IsEnabled="{Binding LoggingBindings.IsAllButtonsEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Theme="{StaticResource Logging.ComparatorCard}" Margin="0,0,5,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="65" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <fa:FontAwesomeImage Icon="RegularFileLines" Width="15" Height="17" Margin="0,0,10,0"
                                                      Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                                    <TextBlock Theme="{StaticResource Logging.ComparatorSectionTitle}"
                                               Text="{Binding LoggingBindings.Translation.LootComparatorChestLogInput, FallbackValue=CHEST__LOG__INPUT}" />
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,0,0,0">
                                    <TextBox Text="{Binding LoggingBindings.ChestLogText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Text="{Binding LoggingBindings.Translation.ChestLogTextPlaceholder, FallbackValue=Paste chest log here}"
                                               Foreground="{DynamicResource SolidColorBrush.Text.5}" Opacity="0.55" Margin="10,23,0,0"
                                               IsHitTestVisible="False" Focusable="False"
                                               IsVisible="{Binding LoggingBindings.ChestLogText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                </Grid>
                                <TextBlock Grid.Row="2" Margin="0,0,0,0"
                                           Text="{Binding LoggingBindings.LootComparatorLogCountSummary, FallbackValue='0 chest files | 0 loot log files'}"
                                           ToolTip.Tip="{Binding LoggingBindings.LootComparatorLogCountTooltip}"
                                           Foreground="{DynamicResource SolidColorBrush.Text.3}" />
                                <Grid Grid.Row="3" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Theme="{StaticResource Style.Button.Warning}" Margin="0,0,5,0"
                                            Click="BtnLoadVaultLogText_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:FontAwesomeImage Icon="SolidPlus" Width="15" Height="15" Margin="0,0,8,0" Theme="{StaticResource Style.Button.Icon.White}" />
                                            <TextBlock Text="{Binding LoggingBindings.Translation.LoadChestLogText, FallbackValue=LOAD__CHEST__LOG__TEXT}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Theme="{StaticResource Style.Button.Warning}" Margin="5,0,0,0"
                                            Click="BtnLoadVaultLogFiles_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:FontAwesomeImage Icon="SolidUpload" Width="15" Height="15" Margin="0,0,8,0" Theme="{StaticResource Style.Button.Icon.White}" />
                                            <TextBlock Text="{Binding LoggingBindings.Translation.UploadChestFiles, FallbackValue=UPLOAD__CHEST__FILES}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Button Grid.Row="4" Theme="{StaticResource Style.Button.Orange}" Margin="0,8,0,0"
                                        Click="BtnAddLootLogFiles_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:FontAwesomeImage Icon="SolidRectangleList" Width="15" Height="15" Margin="0,0,8,0" Theme="{StaticResource Style.Button.Icon.White}" />
                                        <TextBlock Text="{Binding LoggingBindings.Translation.AddLootLogFiles, FallbackValue=ADD__LOOT__LOG__FILES}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Row="5" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                           Text="{Binding LoggingBindings.LootComparatorImportEventLine}"
                                           IsVisible="{Binding LoggingBindings.LootComparatorImportEventLineVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                                           Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Theme="{StaticResource Logging.ComparatorCard}" Margin="5,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="42" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <fa:FontAwesomeImage Icon="SolidScaleBalanced" Width="17" Height="17" Margin="0,0,10,0"
                                                      Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                                    <TextBlock Theme="{StaticResource Logging.ComparatorSectionTitle}"
                                               Text="{Binding LoggingBindings.Translation.LootComparatorComparison, FallbackValue=COMPARISON}" />
                                </StackPanel>
                                <Button Grid.Row="1" Margin="0,12,0,0"
                                        IsEnabled="{Binding LoggingBindings.IsCompareButtonEnabled, FallbackValue=true}"
                                        Click="BtnLogCompare_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:FontAwesomeImage Icon="SolidScaleBalanced" Width="17" Height="17" Margin="0,0,9,0" Theme="{StaticResource Style.Button.Icon.White}" />
                                        <TextBlock Text="{Binding LoggingBindings.Translation.CompareLogs, FallbackValue=COMPARE__LOGS}" FontSize="16" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Row="2" Margin="0,12,0,5" Foreground="{DynamicResource SolidColorBrush.Text.2}"
                                           Text="{Binding LoggingBindings.Translation.LootComparatorSavedState, FallbackValue=SAVED__COMPARATOR}" />
                                <ComboBox Grid.Row="3" ItemsSource="{Binding LoggingBindings.LootComparatorSaves}"
                                          SelectedItem="{Binding LoggingBindings.SelectedLootComparatorSave, Mode=TwoWay}"
                                          DisplayMemberBinding="{ReflectionBinding Name}" VerticalContentAlignment="Center" />
                                <Button Grid.Row="4" Margin="0,10,0,0"
                                        IsEnabled="{Binding LoggingBindings.CanLoadLootComparatorSave, FallbackValue=false}"
                                        Click="BtnLoadLootComparatorSave_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:FontAwesomeImage Icon="RegularFolderOpen" Width="16" Height="16" Margin="0,0,9,0" Theme="{StaticResource Style.Button.Icon.White}" />
                                        <TextBlock Text="{Binding LoggingBindings.Translation.LoadLootComparatorState, FallbackValue=LOAD__LOOT__COMPARATOR__STATE}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="5" Theme="{StaticResource Style.Button.Danger}" Margin="0,10,0,0"
                                        IsEnabled="{Binding LoggingBindings.CanDeleteLootComparatorSave, FallbackValue=false}"
                                        Click="BtnDeleteLootComparatorSave_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:FontAwesomeImage Icon="RegularTrashCan" Width="16" Height="16" Margin="0,0,9,0" Theme="{StaticResource Style.Button.Icon.White}" />
                                        <TextBlock Text="{Binding LoggingBindings.Translation.DeleteLootComparatorState, FallbackValue=DELETE__LOOT__COMPARATOR__STATE}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Theme="{StaticResource Logging.ComparatorCard}" Margin="5,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="42" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <fa:FontAwesomeImage Icon="SolidBolt" Width="17" Height="17" Margin="0,0,10,0"
                                                      Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                                    <TextBlock Theme="{StaticResource Logging.ComparatorSectionTitle}"
                                               Text="{Binding LoggingBindings.Translation.LootComparatorActions, FallbackValue=ACTIONS}" />
                                </StackPanel>
                                <Button Grid.Row="1" Theme="{StaticResource Style.Button.Danger}" Margin="0,12,0,0"
                                        Click="BtnClearVaultLogItems_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:FontAwesomeImage Icon="RegularTrashCan" Width="16" Height="16" Margin="0,0,9,0" Theme="{StaticResource Style.Button.Icon.White}" />
                                        <TextBlock Text="{Binding LoggingBindings.Translation.DeleteChestLogs, FallbackValue=DELETE__CHEST__FILE__LOGS}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="2" Theme="{StaticResource Style.Button.Danger}" Margin="0,10,0,0"
                                        Click="BtnClearLootLogs_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:FontAwesomeImage Icon="RegularTrashCan" Width="16" Height="16" Margin="0,0,9,0" Theme="{StaticResource Style.Button.Icon.White}" />
                                        <TextBlock Text="{Binding LoggingBindings.Translation.DeleteAllLogs, FallbackValue=DELETE__ALL__LOGS}" />
                                    </StackPanel>
                                </Button>
                                <Separator Grid.Row="3" Margin="0,14,0,4" Background="{DynamicResource SolidColorBrush.Background.4}" />
                                <Button Grid.Row="4" Theme="{StaticResource Style.Button.Neutral}" Margin="0,10,0,0"
                                        IsEnabled="{Binding LoggingBindings.CanSaveLootComparator, FallbackValue=false}"
                                        Click="BtnSaveLootComparator_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:FontAwesomeImage Icon="RegularFloppyDisk" Width="16" Height="16" Margin="0,0,9,0" Theme="{StaticResource Style.Button.Icon.White}" />
                                        <TextBlock Text="{Binding LoggingBindings.Translation.SaveLootComparatorState, FallbackValue=SAVE__LOOT__COMPARATOR__STATE}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                    <!-- WpfToolkit VirtualizingItemsControl -> ScrollViewer around an ItemsControl with a VirtualizingStackPanel. -->
                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                        <ItemsControl ItemsSource="{Binding LoggingBindings.LootingPlayersCollectionView, Mode=OneWay}"
                                      ItemTemplate="{StaticResource LootingPlayersTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
        <ScrollViewer IsVisible="{Binding LoggingBindings.IsLootComparatorInfoPopupVisible, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                      Margin="0,400,0,0"
                      Background="{DynamicResource SolidColorBrush.Background.2}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      >
            <StackPanel Margin="10,0">
                <TextBlock Theme="{StaticResource InfoDescription.Header}" Text="{Binding Translation.LootComparatorHeaderHowDoIGetTheChestLogs, FallbackValue=HOW_DO_I_GET_THE_CHEST_LOGS}" />
                <TextBlock Text="{Binding Translation.LootComparatorDescription1, FallbackValue=Description1}" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                           FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10" />
                <TextBlock Text="{Binding Translation.LootComparatorDescription2, FallbackValue=Description2}" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                           FontSize="16" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Translation.LootComparatorDescription3, FallbackValue=Description3}" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                           FontSize="16" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Translation.LootComparatorDescription4, FallbackValue=Description4}" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                           FontSize="16" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Translation.LootComparatorDescription5, FallbackValue=Description5}" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                           FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10" />
                <TextBlock Text="{Binding Translation.LootComparatorDescription6, FallbackValue=Description6}" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                           FontSize="16" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Translation.LootComparatorDescription7, FallbackValue=Description7}" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                           FontSize="16" TextWrapping="Wrap" />
                <Image Margin="0,10" Source="avares://StatisticsAnalysisTool/Assets/loggingcomparator_description01.jpg" MaxWidth="1000" HorizontalAlignment="Left" />

                <TextBlock Theme="{StaticResource InfoDescription.Header}" Text="{Binding Translation.LootComparatorWhatTheItemSlotsColorsMean, FallbackValue=WHAT_THE_ITEM_SLOTS_COLORS_MEAN}" />
                <Image Source="avares://StatisticsAnalysisTool/Assets/loot_cpmparator_slot_gray.png" Height="50" Width="50" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Translation.LootComparatorSlotsColorsDescriptionGray, FallbackValue=LootComparatorSlotsColorsDescriptionGray}" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                           FontSize="16" TextWrapping="Wrap" Margin="0,0,0,20" />

                <Image Margin="0,0,0,0" Source="avares://StatisticsAnalysisTool/Assets/loot_cpmparator_slot_green.png" Height="50" Width="50" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Translation.LootComparatorSlotsColorsDescriptionGreen, FallbackValue=LootComparatorSlotsColorsDescriptionGreen}" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                           FontSize="16" TextWrapping="Wrap" Margin="0,0,0,20" />

                <Image Margin="0,0,0,0" Source="avares://StatisticsAnalysisTool/Assets/loot_cpmparator_slot_blue.png" Height="50" Width="50" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Translation.LootComparatorSlotsColorsDescriptionBlue, FallbackValue=LootComparatorSlotsColorsDescriptionBlue}" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                           FontSize="16" TextWrapping="Wrap" Margin="0,0,0,20" />

                <Image Margin="0,0,0,0" Source="avares://StatisticsAnalysisTool/Assets/loot_cpmparator_slot_red.png" Height="50" Width="50" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Translation.LootComparatorSlotsColorsDescriptionRed, FallbackValue=LootComparatorSlotsColorsDescriptionRed}" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                           FontSize="16" TextWrapping="Wrap" Margin="0,0,0,20" />

                <TextBlock Theme="{StaticResource InfoDescription.Header}" Text="{Binding Translation.LootComparatorHeaderLootLogFiles, FallbackValue=LOOT_LOG_FILES}" />
                <TextBlock Text="{Binding Translation.LootComparatorDescription8, FallbackValue=Description8}" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                           FontSize="16" TextWrapping="Wrap" Margin="0,0,0,20" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
