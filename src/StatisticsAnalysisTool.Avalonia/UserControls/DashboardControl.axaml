<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
             xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
             xmlns:common="clr-namespace:StatisticsAnalysisTool.Common"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks"
             xmlns:gl="clr-namespace:System.Globalization;assembly=System.Runtime"
             xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
             xmlns:models="clr-namespace:StatisticsAnalysisTool.Models"
             xmlns:bindingModels="clr-namespace:StatisticsAnalysisTool.Models.BindingModel"
             xmlns:controls="clr-namespace:StatisticsAnalysisTool.Common.Controls"
             xmlns:userControls="clr-namespace:StatisticsAnalysisTool.UserControls"
             x:Name="DashboardRoot"
             x:Class="StatisticsAnalysisTool.UserControls.DashboardControl"
             x:DataType="viewModels:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Theme="{StaticResource TabItemGridStyle}">
        <Grid Theme="{StaticResource BackgroundImageGridStyle}" />

        <ScrollViewer x:Name="DashboardScrollViewer" Padding="15,10,15,15" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <StackPanel Width="{Binding Viewport.Width, ElementName=DashboardScrollViewer, Mode=OneWay}">
                <Grid Margin="0,0,0,0">
                    <Border Theme="{StaticResource App.TopFilterCard}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="250" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Theme="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardBindings.TranslationTimeRange, FallbackValue=TIME_RANGE}" Theme="{StaticResource App.FilterLabel}" />
                                    <ComboBox Width="155" ItemsSource="{Binding DashboardChartRanges}" SelectedItem="{Binding SelectedDashboardChartRange, Mode=TwoWay}" DisplayMemberBinding="{ReflectionBinding Name}" SelectionChanged="DashboardChartRange_SelectionChanged" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Theme="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardBindings.TranslationContent, FallbackValue=CONTENT}" Theme="{StaticResource App.FilterLabel}" />
                                    <ComboBox Width="165" ItemsSource="{Binding DashboardContentFilters}" SelectedItem="{Binding SelectedDashboardContentFilter, Mode=TwoWay}" DisplayMemberBinding="{ReflectionBinding Name}" SelectionChanged="DashboardMetadataFilter_SelectionChanged" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Theme="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardBindings.TranslationSession, FallbackValue=SESSION}" Theme="{StaticResource App.FilterLabel}" />
                                    <ComboBox MinWidth="220"
                                              HorizontalContentAlignment="Stretch"
                                              ItemsSource="{Binding DashboardSessionFilters}"
                                              SelectedItem="{Binding SelectedDashboardSessionFilter, Mode=TwoWay}"
                                              SelectionChanged="DashboardMetadataFilter_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:DashboardSessionFilterOption">
                                                <Grid MinWidth="200">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1"
                                                            Theme="{StaticResource Dashboard.SessionDeleteButton}" Classes="session-delete" Classes.can-delete="{Binding CanDelete}"
                                                            ToolTip.Tip="{x:Static bindingModels:DashboardBindings.TranslationDeleteSession}"
                                                            Click="DeleteDashboardSession_Click">
                                                        <fa:FontAwesomeImage Width="10"
                                                                          Height="10"
                                                                          Icon="SolidXmark"
                                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Theme="{StaticResource App.FilterGroup}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardBindings.TranslationResetSessionOnMapChange, FallbackValue=RESET_SESSION_ON_MAP_CHANGE}" Theme="{StaticResource App.FilterLabel}" />
                                    <CheckBox Width="190" IsChecked="{Binding IsTrackingResetByMapChangeActive}" IsEnabled="{Binding IsTrackingActive, FallbackValue=false}" 
                                              VerticalAlignment="Bottom" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <Button Grid.Column="4" Height="32" MinWidth="150" VerticalAlignment="Bottom" IsEnabled="{Binding IsTrackingActive, FallbackValue=false}" Click="BtnSessionReset_Click">
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <fa:FontAwesomeImage Icon="SolidArrowsRotate" Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                                    <TextBlock Text="{Binding DashboardBindings.TranslationResetSession, FallbackValue=RESET_SESSION}" VerticalAlignment="Center" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Border Width="32" Height="32" Margin="8,0,0,0" Cursor="Hand" CornerRadius="4" Background="{DynamicResource SolidColorBrush.Background.2}" 
                                        BorderBrush="{DynamicResource SolidColorBrush.Text.6}" BorderThickness="1" IsVisible="{Binding ShowOpenWindowButton, ElementName=DashboardRoot}" ToolTip.Tip="{Binding Translation.OpenExtendedDashboardWindow, FallbackValue=OPEN_EXTENDED_DASHBOARD_WINDOW}" PointerReleased="OpenDashboardWindow_MouseUp">
                                    <fa:FontAwesomeImage Icon="SolidExpand" Width="16" Height="16" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <TabControl Theme="{StaticResource Dashboard.ContentTabControl}" ItemContainerTheme="{StaticResource Dashboard.ContentTabItem}" SelectedIndex="0">
                    <TabItem Header="{Binding DashboardBindings.TranslationDashboardTitle, FallbackValue=DASHBOARD}">
                        <StackPanel Margin="0,8,0,0">
                            <controls:ResponsiveUniformGrid>
                                <Border Theme="{StaticResource Dashboard.SummaryCard}" Margin="0,0,6,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Resources/fame.png" Theme="{StaticResource Dashboard.SummaryImage}" Height="22" Width="22" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationFame, FallbackValue=FAME}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.FameSummary}" 
                                                            ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Theme="{StaticResource Dashboard.SummaryCard}" Margin="0,0,6,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Resources/respec.png" Theme="{StaticResource Dashboard.SummaryImage}" Height="22" Width="22" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationReSpec, FallbackValue=RESPEC}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.ReSpecSummary}" ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Theme="{StaticResource Dashboard.SummaryCard}" Margin="0,0,6,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Resources/silver.png" Theme="{StaticResource Dashboard.SummaryImage}" Height="22" Width="22" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationSilver, FallbackValue=SILVER}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.SilverSummary}" ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Theme="{StaticResource Dashboard.SummaryCard}" Margin="0,0,6,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Resources/might.png" Theme="{StaticResource Dashboard.SummaryImage}" Margin="0,-2,5,0" Height="24" Width="24" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationMight, FallbackValue=MIGHT}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.MightSummary}" ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Theme="{StaticResource Dashboard.SummaryCard}" Margin="0,0,6,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Resources/favor.png" Theme="{StaticResource Dashboard.SummaryImage}" Margin="0,-2,5,0" Height="24" Width="24" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationFavor, FallbackValue=FAVOR}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.FavorSummary}" ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Theme="{StaticResource Dashboard.SummaryCard}" Margin="0,0,6,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <fa:FontAwesomeImage Icon="RegularClock" Width="20" Height="20" Margin="0,0,9,0" VerticalAlignment="Top" Foreground="{DynamicResource SolidColorBrush.Text.2}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationSessionTime, FallbackValue=SESSION_TIME}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding DashboardBindings.SessionTimeSummary}" ContentTemplate="{StaticResource Dashboard.SummarySessionTimeTemplate}" HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </controls:ResponsiveUniformGrid>

                            <Border Theme="{StaticResource Dashboard.FactionSummaryCard}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Theme="{StaticResource Dashboard.SectionHeader}" PointerPressed="FactionSummaryToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding DashboardBindings.SelectedFactionOption.SealIconSource, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}"
                                               Width="28"
                                               Height="28"
                                               Margin="12,0,9,0"
                                               Stretch="Uniform" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DashboardBindings.TranslationFaction, FallbackValue=FACTION}"
                                                   Theme="{StaticResource Dashboard.ContentRankingTitle}" />
                                        <fa:FontAwesomeImage Grid.Column="2"
                                                          Icon="{Binding DashboardBindings.FactionSummaryToggleIcon, FallbackValue=SolidMinus}"
                                                          Theme="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>

                                    <Border Grid.Row="1"
                                            BorderBrush="{DynamicResource SolidColorBrush.Background.4}"
                                            BorderThickness="0,1,0,0"
                                            IsVisible="{Binding DashboardBindings.FactionSummaryVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                                        <Grid Margin="14,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>

                                            <Image Source="{Binding DashboardBindings.SelectedFactionOption.SealIconSource, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}"
                                                   Width="74"
                                                   Height="74"
                                                   Margin="0,0,16,0"
                                                   VerticalAlignment="Center"
                                                   Stretch="Uniform" />

                                            <Border Grid.Column="1" Theme="{StaticResource Dashboard.FactionMetricCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding DashboardBindings.SelectedFactionOption.CoinIconSource, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}"
                                                           Width="24"
                                                           Height="24"
                                                           Theme="{StaticResource Dashboard.SummaryImage}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DashboardBindings.TranslationFactionPoints, FallbackValue=FACTION_POINTS}"
                                                                   Theme="{StaticResource Dashboard.SummaryTitle}" />
                                                        <ContentControl Content="{Binding DashboardBindings.FactionPointsSummary}"
                                                                        ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}"
                                                                        HorizontalContentAlignment="Stretch" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="2" Theme="{StaticResource Dashboard.FactionMetricCard}" Margin="0,0,20,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding DashboardBindings.SelectedFactionOption.StandingIconSource, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}"
                                                           Width="24"
                                                           Height="24"
                                                           Theme="{StaticResource Dashboard.SummaryImage}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DashboardBindings.TranslationFactionStanding, FallbackValue=FACTION_STANDING}"
                                                                   Theme="{StaticResource Dashboard.SummaryTitle}" />
                                                        <ContentControl Content="{Binding DashboardBindings.FactionStandingSummary}"
                                                                        ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}"
                                                                        HorizontalContentAlignment="Stretch" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DashboardBindings.TranslationFaction, FallbackValue=FACTION}"
                                                           Theme="{StaticResource App.FilterLabel}" />
                                                <ComboBox ItemsSource="{Binding DashboardBindings.FactionOptions}"
                                                          SelectedItem="{Binding DashboardBindings.SelectedFactionOption, Mode=TwoWay}"
                                                          SelectionChanged="DashboardMetadataFilter_SelectionChanged">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="26" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Image Source="{Binding SealIconSource, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}" Width="20" Height="20" Stretch="Uniform" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" Theme="{StaticResource Dashboard.ContentRankingCard}" />

                                <Border Grid.Column="0"
                                        MinWidth="350"
                                        BorderBrush="{DynamicResource SolidColorBrush.Background.4}"
                                        BorderThickness="0,0,1,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Theme="{StaticResource Dashboard.SectionHeader}" PointerPressed="ContentRankingToggle_OnMouseLeftButtonDown">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="avares://StatisticsAnalysisTool/Resources/fame.png" Width="22" Height="22" Margin="13,0,9,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DashboardBindings.TranslationTopFameSources, FallbackValue=TOP_FAME_SOURCES}"
                                                       Theme="{StaticResource Dashboard.ContentRankingTitle}" />
                                        </Grid>
                                        <ItemsControl Grid.Row="1"
                                                      Margin="13,10,13,0"
                                                      IsVisible="{Binding DashboardBindings.ContentRankingVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                                                      ItemsSource="{Binding DashboardBindings.FameContentRanking}"
                                                      ItemTemplate="{StaticResource Dashboard.ContentRankingItemTemplate}" />
                                        <Border Grid.Row="2"
                                                Margin="13,8,13,12"
                                                Padding="0,9,0,0"
                                                BorderBrush="{DynamicResource SolidColorBrush.Background.4}"
                                                IsVisible="{Binding DashboardBindings.ContentRankingVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                                                BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DashboardBindings.TranslationTotalFame, FallbackValue=TOTAL_FAME}"
                                                           Theme="{StaticResource Dashboard.ContentRankingTotalLabel}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DashboardBindings.TotalFameByContent, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}"
                                                           Theme="{StaticResource Dashboard.ContentRankingTotalValue}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" MinWidth="350">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Theme="{StaticResource Dashboard.SectionHeader}" PointerPressed="ContentRankingToggle_OnMouseLeftButtonDown">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="avares://StatisticsAnalysisTool/Resources/silver.png" Width="22" Height="22" Margin="13,0,9,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DashboardBindings.TranslationTopSilverSources, FallbackValue=TOP_SILVER_SOURCES}"
                                                       Theme="{StaticResource Dashboard.ContentRankingTitle}" />
                                            <fa:FontAwesomeImage Grid.Column="2" Icon="{Binding DashboardBindings.ContentRankingToggleIcon, FallbackValue=SolidMinus}" Theme="{StaticResource Dashboard.SectionToggleIcon}" />
                                        </Grid>
                                        <ItemsControl Grid.Row="1"
                                                      Margin="13,10,13,0"
                                                      IsVisible="{Binding DashboardBindings.ContentRankingVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                                                      ItemsSource="{Binding DashboardBindings.SilverContentRanking}"
                                                      ItemTemplate="{StaticResource Dashboard.ContentRankingItemTemplate}" />
                                        <Border Grid.Row="2"
                                                Margin="13,8,13,12"
                                                Padding="0,9,0,0"
                                                BorderBrush="{DynamicResource SolidColorBrush.Background.4}"
                                                IsVisible="{Binding DashboardBindings.ContentRankingVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                                                BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DashboardBindings.TranslationTotalSilver, FallbackValue=TOTAL_SILVER}"
                                                           Theme="{StaticResource Dashboard.ContentRankingTotalLabel}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DashboardBindings.TotalSilverByContent, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}"
                                                           Theme="{StaticResource Dashboard.ContentRankingTotalValue}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Theme="{StaticResource Dashboard.Section}" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Theme="{StaticResource Dashboard.SectionHeader}" PointerPressed="LootedChestsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Assets/static_chest.png" Width="24" Height="24" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationLootedChests, FallbackValue=LOOTED_CHESTS}" Theme="{StaticResource Dashboard.SectionTitle}" />
                                        <fa:FontAwesomeImage Grid.Column="2" Icon="{Binding DashboardBindings.LootedChestsStatsToggleIcon, FallbackValue=SolidMinus}" Theme="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" IsVisible="{Binding DashboardBindings.LootedChestsStatsVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                                        <ContentControl Margin="5" Content="{Binding DashboardBindings.LootedChests}" ContentTemplate="{StaticResource LootedChestsTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <userControls:DashboardLootControl Margin="0,0,0,0" ShowDetails="False" />

                            <Border Theme="{StaticResource Dashboard.Section}">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Theme="{StaticResource Dashboard.SectionHeader}" PointerPressed="ActivityChartToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <fa:FontAwesomeImage Icon="RegularClock" Width="22" Height="22" Margin="12,0,10,0" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationActivityChart, FallbackValue=HISTORY}" Theme="{StaticResource Dashboard.SectionTitle}" />
                                        <fa:FontAwesomeImage Grid.Column="2" Icon="{Binding DashboardBindings.ActivityChartToggleIcon, FallbackValue=SolidMinus}" Theme="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" IsVisible="{Binding DashboardBindings.ActivityChartVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                                        <Grid Margin="12,10,12,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="320" />
                                            </Grid.RowDefinitions>
                                            <ItemsControl Grid.Row="0" Margin="0,0,0,4" ItemsSource="{Binding DashboardChartSeriesFilters}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:DashboardChartSeriesFilter">
                                                        <Border Theme="{StaticResource Dashboard.ChartFilter}">
                                                            <CheckBox Content="{Binding Name}" Foreground="{Binding Brush, Converter={x:Static conv:CompatBrushConverter.Instance}}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="DashboardChartSeriesVisibility_Changed" Unchecked="DashboardChartSeriesVisibility_Changed" VerticalAlignment="Center" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <lvc:CartesianChart Grid.Row="1" Series="{Binding SeriesDashboardHourValues}" XAxes="{Binding XAxesDashboardHourValues}" TooltipPosition="Center" FindingStrategy="ExactMatchTakeClosest" LegendPosition="Hidden" Background="Transparent" DrawMarginFrame="{x:Null}" />
                                        </Grid>
                                    </Border>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding DashboardBindings.TranslationLoot, FallbackValue=LOOT}">
                        <StackPanel Margin="0,8,0,0">
                            <userControls:DashboardLootControl />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding DashboardBindings.TranslationCombatTitle, FallbackValue=COMBAT}">
                        <StackPanel Margin="0,8,0,0">
                            <UniformGrid Rows="1" Columns="6" Margin="0,0,0,8">
                                <Border Theme="{StaticResource Dashboard.CombatMetricCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Assets/combat_swords.png" Width="34" Height="34" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationKills, FallbackValue=KILLS}" Theme="{StaticResource Dashboard.CombatMetricTitle}" />
                                            <TextBlock Text="{Binding DashboardBindings.CombatStatistics.KillCount, StringFormat='{}{0:N0}', FallbackValue=0}" Theme="{StaticResource Dashboard.CombatMetricValue}" Foreground="{DynamicResource SolidColorBrush.Accent.Green.2}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Theme="{StaticResource Dashboard.CombatMetricCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Assets/skull_red.png" Width="34" Height="34" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationDeaths, FallbackValue=DEATHS}" Theme="{StaticResource Dashboard.CombatMetricTitle}" />
                                            <TextBlock Text="{Binding DashboardBindings.CombatStatistics.DeathCount, StringFormat='{}{0:N0}', FallbackValue=0}" Theme="{StaticResource Dashboard.CombatMetricValue}" Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Theme="{StaticResource Dashboard.CombatMetricCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Assets/combat_swords.png" Width="34" Height="34" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationKnockouts, FallbackValue=KNOCKOUTS}" Theme="{StaticResource Dashboard.CombatMetricTitle}" />
                                            <TextBlock Text="{Binding DashboardBindings.CombatStatistics.KnockoutCount, StringFormat='{}{0:N0}', FallbackValue=0}" Theme="{StaticResource Dashboard.CombatMetricValue}" 
                                                       Foreground="{DynamicResource SolidColorBrush.Accent.Yellow.3}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Theme="{StaticResource Dashboard.CombatMetricCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Assets/skull_gold.png" Width="34" Height="34" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationKnockedOut, FallbackValue=KNOCKED OUT}" Theme="{StaticResource Dashboard.CombatMetricTitle}" />
                                            <TextBlock Text="{Binding DashboardBindings.CombatStatistics.KnockedOutCount, StringFormat='{}{0:N0}', FallbackValue=0}" Theme="{StaticResource Dashboard.CombatMetricValue}" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Theme="{StaticResource Dashboard.CombatMetricCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Assets/skull.png" Width="34" Height="34" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationKillDeathRatio, FallbackValue=K/D RATIO}" Theme="{StaticResource Dashboard.CombatMetricTitle}" />
                                            <TextBlock Text="{Binding DashboardBindings.CombatStatistics.KillDeathRatio, StringFormat='{}{0:N2}', FallbackValue=0}" Theme="{StaticResource Dashboard.CombatMetricValue}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Theme="{StaticResource Dashboard.CombatMetricCard}" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Resources/silver.png" Width="34" Height="34" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DashboardBindings.TranslationPlayerCorpseLoot, FallbackValue=PLAYER CORPSE LOOT}" Theme="{StaticResource Dashboard.CombatMetricTitle}" />
                                            <TextBlock Text="{Binding DashboardBindings.CombatStatistics.TotalKillLootValue, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" Theme="{StaticResource Dashboard.CombatMetricValue}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Theme="{StaticResource Dashboard.Section}" Margin="0,0,4,0" VerticalAlignment="Top">
                                    <DockPanel LastChildFill="True">
                                        <Grid DockPanel.Dock="Top" Theme="{StaticResource Dashboard.SectionHeader}" PointerPressed="TopKillLocationsToggle_OnMouseLeftButtonDown">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="avares://StatisticsAnalysisTool/Assets/combat_swords.png" Width="24" Height="24" Margin="12,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationTopKillLocations, FallbackValue=TOP KILL LOCATIONS}" Theme="{StaticResource Dashboard.SectionTitle}" />
                                            <fa:FontAwesomeImage Grid.Column="2" Icon="{Binding DashboardBindings.TopKillLocationsToggleIcon, FallbackValue=SolidMinus}" Theme="{StaticResource Dashboard.SectionToggleIcon}" />
                                        </Grid>
                                        <Border BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" IsVisible="{Binding DashboardBindings.TopKillLocationsVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                                            <StackPanel Margin="12,8,12,10">
                                                <Grid Height="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="125" />
                                                        <ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationMap, FallbackValue=MAP}" Theme="{StaticResource Dashboard.CombatColumnHeader}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DashboardBindings.TranslationKills, FallbackValue=KILLS}" Theme="{StaticResource Dashboard.CombatColumnHeader}" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Margin="0,0,12,0" Text="{Binding DashboardBindings.TranslationEstimatedValueShort, FallbackValue=EST. VALUE}" Theme="{StaticResource Dashboard.CombatColumnHeader}" TextAlignment="Right" />
                                                </Grid>
                                                <ScrollViewer MaxHeight="410"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding DashboardBindings.CombatStatistics.TopKillLocations}" ItemTemplate="{StaticResource Dashboard.CombatLocationItemTemplate}" />
                                                </ScrollViewer>
                                                <Border Margin="0,5,0,0" Padding="0,7,0,0" BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="125" />
                                                            <ColumnDefinition Width="100" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationTotal, FallbackValue=TOTAL}" Theme="{StaticResource Dashboard.CombatRowText}" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="2" Text="{Binding DashboardBindings.CombatStatistics.KillCount, StringFormat='{}{0:N0}', FallbackValue=0}" Theme="{StaticResource Dashboard.CombatRowText}" FontWeight="SemiBold" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="3" Text="{Binding DashboardBindings.CombatStatistics.TotalKillLootValue, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" Theme="{StaticResource Dashboard.CombatRowText}" FontWeight="SemiBold" TextAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="1" Theme="{StaticResource Dashboard.Section}" Margin="4,0,0,0" VerticalAlignment="Top">
                                    <DockPanel LastChildFill="True">
                                        <Grid DockPanel.Dock="Top" Theme="{StaticResource Dashboard.SectionHeader}" PointerPressed="TopDeathLocationsToggle_OnMouseLeftButtonDown">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="avares://StatisticsAnalysisTool/Assets/skull_red.png" Width="24" Height="24" Margin="12,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationTopDeathLocations, FallbackValue=TOP DEATH LOCATIONS}" Theme="{StaticResource Dashboard.SectionTitle}" />
                                            <fa:FontAwesomeImage Grid.Column="2" Icon="{Binding DashboardBindings.TopDeathLocationsToggleIcon, FallbackValue=SolidMinus}" Theme="{StaticResource Dashboard.SectionToggleIcon}" />
                                        </Grid>
                                        <Border BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" IsVisible="{Binding DashboardBindings.TopDeathLocationsVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                                            <StackPanel Margin="12,8,12,10">
                                                <Grid Height="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="125" />
                                                        <ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationMap, FallbackValue=MAP}" Theme="{StaticResource Dashboard.CombatColumnHeader}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DashboardBindings.TranslationDeaths, FallbackValue=DEATHS}" Theme="{StaticResource Dashboard.CombatColumnHeader}" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Margin="0,0,12,0" Text="{Binding DashboardBindings.TranslationEstimatedValueShort, FallbackValue=EST. VALUE}" Theme="{StaticResource Dashboard.CombatColumnHeader}" TextAlignment="Right" />
                                                </Grid>
                                                <ScrollViewer MaxHeight="410"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding DashboardBindings.CombatStatistics.TopDeathLocations}" ItemTemplate="{StaticResource Dashboard.CombatLocationItemTemplate}" />
                                                </ScrollViewer>
                                                <Border Margin="0,5,0,0" Padding="0,7,0,0" BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="125" />
                                                            <ColumnDefinition Width="100" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationTotal, FallbackValue=TOTAL}" Theme="{StaticResource Dashboard.CombatRowText}" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="2" Text="{Binding DashboardBindings.CombatStatistics.DeathCount, StringFormat='{}{0:N0}', FallbackValue=0}" Theme="{StaticResource Dashboard.CombatRowText}" FontWeight="SemiBold" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="3" Text="{Binding DashboardBindings.CombatStatistics.TotalDeathLootValue, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" Theme="{StaticResource Dashboard.CombatRowText}" FontWeight="SemiBold" TextAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <Border Theme="{StaticResource Dashboard.Section}" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Theme="{StaticResource Dashboard.SectionHeader}" PointerPressed="RecentKillsDeathsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Assets/skull_gold.png" Width="24" Height="24" Margin="12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationRecentKillsDeaths, FallbackValue=RECENT KILLS &amp; DEATHS}" Theme="{StaticResource Dashboard.SectionTitle}" />
                                        <fa:FontAwesomeImage Grid.Column="2" Icon="{Binding DashboardBindings.RecentKillsDeathsToggleIcon, FallbackValue=SolidMinus}" Theme="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border Padding="12,8,12,10" BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" IsVisible="{Binding DashboardBindings.RecentKillsDeathsVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                                        <StackPanel>
                                            <Grid Height="25" Margin="0,0,59,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DashboardBindings.TranslationTime, FallbackValue=TIME}" Theme="{StaticResource Dashboard.CombatColumnHeader}" />
                                                <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationResult, FallbackValue=RESULT}" Theme="{StaticResource Dashboard.CombatColumnHeader}" />
                                                <TextBlock Grid.Column="2" Text="{Binding DashboardBindings.TranslationMap, FallbackValue=MAP}" Theme="{StaticResource Dashboard.CombatColumnHeader}" />
                                                <TextBlock Grid.Column="3" Text="{Binding DashboardBindings.TranslationTargetKiller, FallbackValue=TARGET / KILLER}" Theme="{StaticResource Dashboard.CombatColumnHeader}" />
                                                <TextBlock Grid.Column="4" Text="{Binding DashboardBindings.TranslationEstimatedValueShort, FallbackValue=EST. VALUE}" Theme="{StaticResource Dashboard.CombatColumnHeader}" TextAlignment="Right" />
                                            </Grid>
                                            <ListBox MaxHeight="340" ItemContainerTheme="{StaticResource Dashboard.PlainListItem}"
                                                     Padding="0"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Focusable="False"
                                                     ItemsSource="{Binding DashboardBindings.CombatStatistics.RecentEvents}"
                                                     ItemTemplate="{StaticResource Dashboard.CombatEventItemTemplate}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                            </Border>
                            <Border Theme="{StaticResource Dashboard.Section}" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Theme="{StaticResource Dashboard.SectionHeader}" PointerPressed="KillDeathToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding DashboardBindings.KillsDeathsText, FallbackValue=KILLS_DEATHS}" Theme="{StaticResource Dashboard.SectionTitle}" />
                                        <fa:FontAwesomeImage Grid.Column="2" Icon="{Binding DashboardBindings.KillDeathStatsToggleIcon, FallbackValue=SolidMinus}" Theme="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" IsVisible="{Binding DashboardBindings.KillDeathStatsVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource KillDeathStatsTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding DashboardBindings.TranslationEconomyTitle, FallbackValue=ECONOMY}">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Theme="{StaticResource Dashboard.Section}" Margin="0,0,4,0">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Theme="{StaticResource Dashboard.SectionHeader}" PointerPressed="ReSpecStatsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Resources/respec.png" Width="24" Height="24" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationReSpec, FallbackValue=RESPEC}" Theme="{StaticResource Dashboard.SectionTitle}" />
                                        <fa:FontAwesomeImage Grid.Column="2" Icon="{Binding DashboardBindings.ReSpecStatsToggleIcon, FallbackValue=SolidMinus}" Theme="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" IsVisible="{Binding DashboardBindings.ReSpecStatsVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource SilverCostForReSpecTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Theme="{StaticResource Dashboard.Section}" Margin="4,0,0,0">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Theme="{StaticResource Dashboard.SectionHeader}" PointerPressed="RepairCostsStatsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Assets/repair_cross.png" Width="26" Height="26" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DashboardBindings.TranslationRepairCosts, FallbackValue=REPAIR_COSTS}" Theme="{StaticResource Dashboard.SectionTitle}" />
                                        <fa:FontAwesomeImage Grid.Column="2" Icon="{Binding DashboardBindings.RepairCostsStatsToggleIcon, FallbackValue=SolidMinus}" Theme="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0" IsVisible="{Binding DashboardBindings.RepairCostsStatsVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource RepairCostsTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Theme="{StaticResource Dashboard.Section}" Margin="0,8,4,0">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Theme="{StaticResource Dashboard.SectionHeader}"
                                          PointerPressed="ItemQualityRerollStatsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Assets/quality_border.png" Width="24" Height="24" Margin="12,0,10,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DashboardBindings.TranslationRefineItemQuality, FallbackValue=REFINE_ITEM_QUALITY}"
                                                   Theme="{StaticResource Dashboard.SectionTitle}" />
                                        <fa:FontAwesomeImage Grid.Column="2"
                                                          Icon="{Binding DashboardBindings.ItemQualityRerollStatsToggleIcon, FallbackValue=SolidMinus}"
                                                          Theme="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0"
                                            IsVisible="{Binding DashboardBindings.ItemQualityRerollStatsVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource ItemQualityRerollTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Theme="{StaticResource Dashboard.Section}" Margin="4,8,0,0">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Theme="{StaticResource Dashboard.SectionHeader}"
                                          PointerPressed="AwakenedWeaponStatsToggle_OnMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <fa:FontAwesomeImage Icon="SolidBolt" Width="24" Height="24" Margin="12,0,10,0"
                                                          Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DashboardBindings.TranslationAwakenWeapon, FallbackValue=AWAKEN_WEAPON}"
                                                   Theme="{StaticResource Dashboard.SectionTitle}" />
                                        <fa:FontAwesomeImage Grid.Column="2"
                                                          Icon="{Binding DashboardBindings.AwakenedWeaponStatsToggleIcon, FallbackValue=SolidMinus}"
                                                          Theme="{StaticResource Dashboard.SectionToggleIcon}" />
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SolidColorBrush.Background.4}"
                                            BorderThickness="0,1,0,0"
                                            IsVisible="{Binding DashboardBindings.AwakenedWeaponStatsVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
                                        <ContentControl Margin="10" Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource AwakenedWeaponTemplate}" />
                                    </Border>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="MobsTab" Header="{Binding DashboardBindings.Mobs.TranslationMobs, FallbackValue=MOBS}">
                        <Grid Margin="0,8,0,0" DataContext="{Binding DashboardBindings.Mobs}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <UniformGrid Grid.Row="0" Columns="3" Rows="1" Margin="0,0,0,8">
                                <Border Theme="{StaticResource Dashboard.MobSummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="70" Height="70" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Source="{Binding MostKilledMob.AvatarSource}" Stretch="Uniform" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TranslationMostKilledMob}"
                                                       Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SolidColorBrush.Text.1}"
                                                       Text="{Binding MostKilledMob.MobName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" MinWidth="52" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TranslationKills}"
                                                       Theme="{StaticResource Dashboard.MobHeaderMetricTitle}"
                                                       TextAlignment="Right" />
                                            <TextBlock Text="{Binding MostKilledMob.Kills, StringFormat='{}{0:N0}', FallbackValue=0}"
                                                       Theme="{StaticResource Dashboard.MobHeaderMetricValue}"
                                                       TextAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Theme="{StaticResource Dashboard.MobSummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="70"
                                               Height="70"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               Source="{Binding LastKilledMob.AvatarSource}"
                                               Stretch="Uniform" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TranslationLastKilledMob}"
                                                       Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SolidColorBrush.Text.1}"
                                                       Text="{Binding LastKilledMob.MobName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" MinWidth="112" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TranslationLastKill}"
                                                       Theme="{StaticResource Dashboard.MobHeaderMetricTitle}"
                                                       TextAlignment="Right" />
                                            <TextBlock Text="{Binding LastKilledMob.LastKilledDisplay}"
                                                       Theme="{StaticResource Dashboard.MobHeaderMetricValue}"
                                                       TextAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Theme="{StaticResource Dashboard.MobSummaryCard}" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0" Source="avares://StatisticsAnalysisTool/Assets/skull_gold.png" Stretch="Uniform" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TranslationKilledMobs}"
                                                       Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <ContentControl Content="{Binding TotalKillsSummary}"
                                                            ContentTemplate="{StaticResource Dashboard.SummaryMetricWithPerHourTemplate}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="1" Margin="0,0,0,8" Theme="{StaticResource App.TopFilterCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Theme="{StaticResource App.FilterGroup}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TranslationSearchMobs, FallbackValue=SEARCH_MOBS}" Theme="{StaticResource App.FilterLabel}" />
                                            <TextBox Width="270" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Theme="{StaticResource App.FilterGroup}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TranslationMobTypeCategory}" Theme="{StaticResource App.FilterLabel}" />
                                            <ComboBox Width="200"
                                                      DisplayMemberBinding="{ReflectionBinding Name}"
                                                      ItemsSource="{Binding MobTypeCategoryFilters}"
                                                      SelectedValue="{Binding SelectedMobTypeCategory, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Value}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Theme="{StaticResource App.FilterGroup}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TranslationFaction}" Theme="{StaticResource App.FilterLabel}" />
                                            <ComboBox Width="200"
                                                      DisplayMemberBinding="{ReflectionBinding Name}"
                                                      ItemsSource="{Binding FactionFilters}"
                                                      SelectedValue="{Binding SelectedFaction, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Value}" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="4" Margin="18,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TranslationMobs}" Theme="{StaticResource App.FilterLabel}" TextAlignment="Right" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SolidColorBrush.Text.1}"
                                                   Text="{Binding MobCountText}"
                                                   TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ListBox x:Name="DashboardMobList"
                                     Grid.Row="2"
                                     Height="240"
                                     Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Focusable="False"
                                     ItemContainerTheme="{StaticResource Dashboard.MobListItem}"
                                     ItemsSource="{Binding VisibleMobs}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:DashboardMobListItem">
                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Theme="{StaticResource Dashboard.MobExpander}">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="74" />
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="1.6*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Image Width="70" Height="70" HorizontalAlignment="Left" Source="{Binding AvatarSource}" Stretch="Uniform" />
                                                    <StackPanel Grid.Column="1" Margin="5,0,5,0" VerticalAlignment="Center">
                                                        <TextBlock FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SolidColorBrush.Text.1}"
                                                                   Text="{Binding MobName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,5,0,0"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SolidColorBrush.Text.2}"
                                                                   Text="{Binding NameLocatag}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="5,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{ReflectionBinding DataContext.TranslationFirstAttacked, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                   Theme="{StaticResource Dashboard.MobHeaderMetricTitle}" />
                                                        <TextBlock Text="{Binding FirstAttackedDisplay}"
                                                                   Theme="{StaticResource Dashboard.MobHeaderMetricValue}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Margin="5,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{ReflectionBinding DataContext.TranslationKills, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                   Theme="{StaticResource Dashboard.MobHeaderMetricTitle}" />
                                                        <TextBlock Text="{Binding Kills, StringFormat='{}{0:N0}', FallbackValue=0}"
                                                                   Theme="{StaticResource Dashboard.MobHeaderMetricValue}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" Margin="5,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{ReflectionBinding DataContext.TranslationPerHour, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                   Theme="{StaticResource Dashboard.MobHeaderMetricTitle}" />
                                                        <TextBlock Text="{Binding KillsPerHour, StringFormat='{}{0:N1}/h', FallbackValue=0}"
                                                                   Theme="{StaticResource Dashboard.MobHeaderMetricValue}" />
                                                    </StackPanel>
                                                    <WrapPanel Grid.Column="5" Margin="5,0,0,0" VerticalAlignment="Center">
                                                        <Border Theme="{StaticResource Dashboard.MobTierTag}"
                                                Classes.t1="{Binding Tier, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=1}" Classes.t2="{Binding Tier, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=2}" Classes.t3="{Binding Tier, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=3}" Classes.t4="{Binding Tier, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=4}" Classes.t5="{Binding Tier, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=5}" Classes.t6="{Binding Tier, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=6}" Classes.t7="{Binding Tier, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=7}" Classes.t8="{Binding Tier, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=8}"
                                                                IsVisible="{Binding HasTier}">
                                                            <TextBlock Text="{Binding TierDisplay}" Theme="{StaticResource Dashboard.MobTagText}" Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
                                                        </Border>
                                                        <Border Theme="{StaticResource Dashboard.MobTypeTag}"
                                                Classes.standard="{Binding MobTypeCategory, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=standard}" Classes.boss="{Binding MobTypeCategory, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=boss}" Classes.champion="{Binding MobTypeCategory, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=champion}" Classes.chest="{Binding MobTypeCategory, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=chest}" Classes.critter="{Binding MobTypeCategory, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=critter}" Classes.environment="{Binding MobTypeCategory, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=environment}" Classes.harmless="{Binding MobTypeCategory, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=harmless}" Classes.miniboss="{Binding MobTypeCategory, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=miniboss}" Classes.summon="{Binding MobTypeCategory, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=summon}" Classes.trash="{Binding MobTypeCategory, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=trash}" Classes.vanity="{Binding MobTypeCategory, Converter={x:Static conv:ToStringEqualsConverter.Instance}, ConverterParameter=vanity}"
                                                                IsVisible="{Binding HasMobTypeCategory}">
                                                            <TextBlock Text="{Binding MobTypeCategoryDisplay}" Theme="{StaticResource Dashboard.MobTagText}" Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
                                                        </Border>
                                                        <Border Theme="{StaticResource Dashboard.MobTag}"
                                                                IsVisible="{Binding HasCategory}">
                                                            <TextBlock Text="{Binding CategoryDisplay}" Theme="{StaticResource Dashboard.MobTagText}" />
                                                        </Border>
                                                        <Border Theme="{StaticResource Dashboard.MobTag}"
                                                                IsVisible="{Binding HasFaction}">
                                                            <TextBlock Text="{Binding FactionDisplay}" Theme="{StaticResource Dashboard.MobTagText}" />
                                                        </Border>
                                                        <Border Theme="{StaticResource Dashboard.MobTag}"
                                                                IsVisible="{Binding HasAttackType}">
                                                            <TextBlock Text="{Binding AttackTypeDisplay}" Theme="{StaticResource Dashboard.MobTagText}" />
                                                        </Border>
                                                    </WrapPanel>
                                                </Grid>
                                            </Expander.Header>

                                            <Border BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="0,1,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Theme="{StaticResource Dashboard.MobDetailGroup}">
                                                        <StackPanel>
                                                            <StackPanel Theme="{StaticResource Dashboard.MobDetailTitlePanel}">
                                                                <iconPacks:PackIconGameIcons Kind="Info"
                                                                                             Theme="{StaticResource Dashboard.MobDetailIcon}" />
                                                                <TextBlock Text="{ReflectionBinding DataContext.TranslationOverview, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                           Theme="{StaticResource Dashboard.MobDetailTitle}" />
                                                            </StackPanel>
                                                            <ItemsControl ItemTemplate="{StaticResource Dashboard.MobDetailValueTemplate}"
                                                                          ItemsSource="{Binding OverviewStats}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Theme="{StaticResource Dashboard.MobDetailGroup}">
                                                        <StackPanel>
                                                            <StackPanel Theme="{StaticResource Dashboard.MobDetailTitlePanel}">
                                                                <iconPacks:PackIconGameIcons Kind="CrossedSwords"
                                                                                             Theme="{StaticResource Dashboard.MobDetailIcon}" />
                                                                <TextBlock Text="{ReflectionBinding DataContext.TranslationCombatStats, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                           Theme="{StaticResource Dashboard.MobDetailTitle}" />
                                                            </StackPanel>
                                                            <ItemsControl ItemTemplate="{StaticResource Dashboard.MobDetailValueTemplate}"
                                                                          ItemsSource="{Binding CombatStats}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="2" Theme="{StaticResource Dashboard.MobDetailGroup}">
                                                        <StackPanel>
                                                            <StackPanel Theme="{StaticResource Dashboard.MobDetailTitlePanel}">
                                                                <iconPacks:PackIconGameIcons Kind="Awareness"
                                                                                             Theme="{StaticResource Dashboard.MobDetailIcon}" />
                                                                <TextBlock Text="{ReflectionBinding DataContext.TranslationAggroBehavior, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                           Theme="{StaticResource Dashboard.MobDetailTitle}" />
                                                            </StackPanel>
                                                            <ItemsControl ItemTemplate="{StaticResource Dashboard.MobDetailValueTemplate}"
                                                                          ItemsSource="{Binding AggroStats}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="3"
                                                            BorderThickness="0"
                                                            Theme="{StaticResource Dashboard.MobDetailGroup}">
                                                        <StackPanel>
                                                            <StackPanel Theme="{StaticResource Dashboard.MobDetailTitlePanel}">
                                                                <iconPacks:PackIconGameIcons Kind="Hourglass"
                                                                                             Theme="{StaticResource Dashboard.MobDetailIcon}" />
                                                                <TextBlock Text="{ReflectionBinding DataContext.TranslationSpawnCharges, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                           Theme="{StaticResource Dashboard.MobDetailTitle}" />
                                                            </StackPanel>
                                                            <ItemsControl ItemTemplate="{StaticResource Dashboard.MobDetailValueTemplate}"
                                                                          ItemsSource="{Binding SpawnStats}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Expander>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        </Grid>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
