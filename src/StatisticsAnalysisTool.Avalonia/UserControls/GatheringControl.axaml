<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
             xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
             xmlns:common="clr-namespace:StatisticsAnalysisTool.Common"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks"
             xmlns:gl="clr-namespace:System.Globalization;assembly=System.Runtime"
             xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
             xmlns:gathering="clr-namespace:StatisticsAnalysisTool.Gathering"
             x:Class="StatisticsAnalysisTool.UserControls.GatheringControl"
             x:DataType="viewModels:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Theme="{StaticResource TabItemGridStyle}">
        <Grid Theme="{StaticResource BackgroundImageGridStyle}" />
        <Grid Margin="12,10,12,18" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
                <Border Grid.Row="0" Theme="{StaticResource App.TopFilterCard}" Margin="0,0,0,10">
                    <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border Theme="{StaticResource App.FilterGroup}">
                            <StackPanel>
                                <TextBlock Text="{Binding GatheringBindings.TranslationGathering, FallbackValue=GATHERING}" Theme="{StaticResource App.FilterLabel}" />
                                <Button Width="180" Height="32" Theme="{StaticResource Style.Button.Neutral}" ToolTip.Tip="{Binding GatheringBindings.TranslationGatheringActive}" Click="GatheringActivationToggle_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:FontAwesomeImage Theme="{StaticResource Logging.ToggleIcon}" Classes.on="{Binding GatheringBindings.IsGatheringActive}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Translation.TrackingIsActive}" IsVisible="{Binding GatheringBindings.IsGatheringActive}" />
<TextBlock VerticalAlignment="Center" Text="{Binding Translation.TrackingIsNotActive}" IsVisible="{Binding !GatheringBindings.IsGatheringActive}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Theme="{StaticResource App.FilterGroup}">
                            <StackPanel>
                                <TextBlock Text="{Binding GatheringBindings.TranslationTimeRange, FallbackValue=TIME_RANGE}" Theme="{StaticResource App.FilterLabel}" />
                                <ComboBox Width="170" Height="32" ItemsSource="{Binding GatheringBindings.GatheringTimeRanges}" SelectedItem="{Binding GatheringBindings.SelectedGatheringTimeRange, Mode=TwoWay}" DisplayMemberBinding="{ReflectionBinding Name}" />
                            </StackPanel>
                        </Border>
                        <Border Theme="{StaticResource App.FilterGroup}">
                            <StackPanel>
                                <TextBlock Text="{Binding GatheringBindings.TranslationSession, FallbackValue=SESSION}" Theme="{StaticResource App.FilterLabel}" />
                                <ComboBox Width="330" Height="32" HorizontalContentAlignment="Stretch" ItemsSource="{Binding GatheringBindings.GatheringSessionFilters}" SelectedItem="{Binding GatheringBindings.SelectedGatheringSessionFilter, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="gathering:GatheringSessionFilterOption">
                                            <Grid MinWidth="290">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Theme="{StaticResource Dashboard.SessionDeleteButton}" IsVisible="{Binding CanDelete}" ToolTip.Tip="{ReflectionBinding DataContext.GatheringBindings.TranslationDeleteSession, RelativeSource={RelativeSource AncestorType=UserControl}}" Click="DeleteGatheringSession_Click">
                                                    <fa:FontAwesomeImage Width="10" Height="10" Icon="SolidXmark" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Border Theme="{StaticResource App.FilterGroup}">
                            <StackPanel>
                                <TextBlock Text="{Binding GatheringBindings.TranslationResetSession, FallbackValue=RESET_SESSION}" Theme="{StaticResource App.FilterLabel}" />
                                <Button Height="32" MinWidth="160" IsEnabled="{Binding IsTrackingActive, FallbackValue=false}" Click="BtnSessionReset_Click">
                                    <StackPanel Orientation="Horizontal" Margin="8,0">
                                        <fa:FontAwesomeImage Icon="SolidArrowsRotate" Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                                        <TextBlock Text="{Binding GatheringBindings.TranslationResetSession, FallbackValue=RESET_SESSION}" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Border>
                <TabControl Grid.Row="1" Theme="{StaticResource Dashboard.ContentTabControl}" ItemContainerTheme="{StaticResource Dashboard.ContentTabItem}" SelectedIndex="{Binding GatheringBindings.SelectedGatheringTabIndex, Mode=TwoWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <TabItem Header="{Binding GatheringBindings.TranslationGenerally, FallbackValue=GENERALLY}">
                        <ScrollViewer x:Name="GenerallyScrollViewer" Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                            <StackPanel MinWidth="1050" Width="{Binding Viewport.Width, ElementName=GenerallyScrollViewer, Mode=OneWay}">
                            <UniformGrid Rows="1" Columns="5" Margin="0,0,0,8">
                                <Border Theme="{StaticResource Gathering.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Resources/silver.png" Theme="{StaticResource Dashboard.SummaryImage}" Width="30" Height="30" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationResourceValue}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <TextBlock Text="{Binding GatheringBindings.GatheringStats.TotalGainedSilverString, StringFormat='{}{0:N0}'}" Theme="{StaticResource Dashboard.SummaryValue}" />
                                            <TextBlock Foreground="{DynamicResource SolidColorBrush.Accent.Green.2}"><Run Text="{x:Static gathering:GatheringStats.TranslationPerHour}" /><Run Text=": " /><Run Text="{Binding GatheringBindings.GatheringStats.TotalGainedSilverPerHour, StringFormat='{}{0:N0}/h'}" /></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Theme="{StaticResource Gathering.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Assets/pickaxe_box.png" Theme="{StaticResource Dashboard.SummaryImage}" Width="30" Height="30" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalResources}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <TextBlock Text="{Binding GatheringBindings.GatheringStats.TotalResources, StringFormat='{}{0:N0}'}" Theme="{StaticResource Dashboard.SummaryValue}" />
                                            <TextBlock Foreground="{DynamicResource SolidColorBrush.Text.3}"><Run Text="{Binding GatheringBindings.GatheringStats.UniqueResourceTypes}" /><Run Text=" " /><Run Text="{x:Static gathering:GatheringStats.TranslationUniqueResourceTypes}" /></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Theme="{StaticResource Gathering.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Source="avares://StatisticsAnalysisTool/Assets/pickaxe_repeat.png" Theme="{StaticResource Dashboard.SummaryImage}" Width="30" Height="30" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalGatheringProcesses}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <TextBlock Text="{Binding GatheringBindings.GatheringStats.TotalMiningProcesses, StringFormat='{}{0:N0}'}" Theme="{StaticResource Dashboard.SummaryValue}" />
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalGatheringProcesses}" Foreground="{DynamicResource SolidColorBrush.Text.3}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Theme="{StaticResource Gathering.SummaryCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Source="{Binding GatheringBindings.GatheringStats.BestResource?.Item?.Icon}" Theme="{StaticResource Dashboard.SummaryImage}" Width="38" Height="38" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationBestResource}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <TextBlock Text="{Binding GatheringBindings.GatheringStats.BestResource?.Item?.LocalizedName, FallbackValue=-}" FontSize="20"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource SolidColorBrush.Text.1}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{DynamicResource SolidColorBrush.Accent.Green.2}">
                                                <Run Text="{x:Static gathering:GatheringStats.TranslationValue}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding GatheringBindings.GatheringStats.BestResource?.TotalValue, StringFormat='{}{0:N0}'}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Theme="{StaticResource Gathering.SummaryCard}" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Source="{Binding GatheringBindings.GatheringStats.BestGatheringMap?.IconSource, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}" Theme="{StaticResource Dashboard.SummaryImage}" Width="34" Height="34" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationTopMap}" Theme="{StaticResource Dashboard.SummaryTitle}" />
                                            <TextBlock Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap?.Name, FallbackValue=-}" FontSize="20" 
                                                       FontWeight="SemiBold" Foreground="{DynamicResource SolidColorBrush.Text.1}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{DynamicResource SolidColorBrush.Accent.Green.2}"><Run Text="{x:Static gathering:GatheringStats.TranslationValue}" /><Run Text=": " /><Run Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap?.TotalValue, StringFormat='{}{0:N0}'}" /></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Theme="{StaticResource Gathering.DetailCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationOverview}" Theme="{StaticResource Gathering.CardTitle}" />
                                        <Border Theme="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalResourcesGathered}" Theme="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.TotalResources, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Theme="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalGatheringProcesses}" Theme="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.TotalMiningProcesses, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Theme="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationUniqueResourceTypes}" Theme="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.UniqueResourceTypes}" Theme="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Theme="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationAverageResourceValue}" Theme="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.AverageResourceValue, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Theme="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationBestSingleGathering}" Theme="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.BestSingleGatheringValue, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Theme="{StaticResource Gathering.DetailCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationMostGatheredResource}" Theme="{StaticResource Gathering.CardTitle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Image Source="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails?.Item?.Icon}" Width="58" Height="58" Margin="0,0,10,0" />
                                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails?.Item?.TierLevelString}" FontWeight="SemiBold" Foreground="{DynamicResource SolidColorBrush.Text.1}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails?.Item?.LocalizedName, FallbackValue=-}" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" /></StackPanel>
                                        </StackPanel>
                                        <Border Theme="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTimesGathered}" Theme="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails?.TimesGathered, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Theme="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalAmount}" Theme="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails?.TotalAmount, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Theme="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalValue}" Theme="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails?.TotalValue, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Theme="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationAverageValuePerGather}" Theme="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.MostGatheredResourceDetails?.AverageValuePerGather, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Theme="{StaticResource Gathering.DetailCard}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationBestGatheringMap}" Theme="{StaticResource Gathering.CardTitle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Image Source="{Binding GatheringBindings.GatheringStats.BestGatheringMap?.IconSource, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}" Width="48" Height="48" Margin="0,0,10,0" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap?.Name, FallbackValue=-}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SolidColorBrush.Text.1}" /></StackPanel>
                                        <Border Theme="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTimesGathered}" Theme="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap?.TimesGathered, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Theme="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationTotalValue}" Theme="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap?.TotalValue, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Theme="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationUniqueResourceTypes}" Theme="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap?.ResourceTypeCount}" Theme="{StaticResource Gathering.DetailValue}" /></Grid></Border>
                                        <Border Theme="{StaticResource Gathering.DetailRow}"><Grid><TextBlock Text="{x:Static gathering:GatheringStats.TranslationMostGatheredResource}" Theme="{StaticResource Gathering.DetailLabel}" /><TextBlock Text="{Binding GatheringBindings.GatheringStats.BestGatheringMap?.MostGatheredResource?.LocalizedName, FallbackValue=-}" Theme="{StaticResource Gathering.DetailValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GatheringBindings.GatheringStats.BestGatheringMap?.MostGatheredResource?.LocalizedName}" /></Grid></Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Theme="{StaticResource Gathering.ChartCard}" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationResourceValueByType}" Theme="{StaticResource Gathering.CardTitle}" />
                                        <lvc:PieChart Grid.Row="1" Series="{Binding GatheringBindings.GatheringStats.ResourceValueByTypeSeries}" LegendPosition="Right" LegendTextPaint="{Binding GatheringBindings.ChartLegendTextPaint}" LegendTextSize="12" AnimationsSpeed="0:0:0" UpdaterThrottler="0:0:0.1" Background="Transparent" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Theme="{StaticResource Gathering.ChartCard}" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationGatheringActivityOverTime}" Theme="{StaticResource Gathering.CardTitle}" />
                                            <ComboBox Grid.Column="1" Width="155" Height="26" ItemsSource="{Binding GatheringBindings.GatheringStats.ResourceChartValueTypes}" SelectedValue="{Binding GatheringBindings.GatheringStats.SelectedResourceChartValueType, Mode=TwoWay}" SelectedValueBinding="{ReflectionBinding GatheringChartValueType}" DisplayMemberBinding="{ReflectionBinding Name}" />
                                        </Grid>
                                        <ItemsControl Grid.Row="1" Margin="0,4,0,3" ItemsSource="{Binding GatheringBindings.GatheringStats.ResourceChartSeriesFilters}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gathering:GatheringChartSeriesFilter">
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,10,3" Foreground="{Binding Brush, Converter={x:Static conv:CompatBrushConverter.Instance}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <lvc:CartesianChart Grid.Row="2" Series="{Binding GatheringBindings.GatheringStats.ResourceChartSeries}" XAxes="{Binding GatheringBindings.GatheringStats.ResourceChartXAxes}" TooltipPosition="Center" FindingStrategy="ExactMatchTakeClosest" LegendPosition="Hidden" AnimationsSpeed="0:0:0" UpdaterThrottler="0:0:0.1" Background="Transparent" DrawMarginFrame="{x:Null}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Theme="{StaticResource Gathering.ChartCard}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationGatheringActivityByLocation}" Theme="{StaticResource Gathering.CardTitle}" />
                                        <lvc:PieChart Grid.Row="1" Series="{Binding GatheringBindings.GatheringStats.GatheringActivityByLocationSeries}" LegendPosition="Right" LegendTextPaint="{Binding GatheringBindings.ChartLegendTextPaint}" LegendTextSize="12" AnimationsSpeed="0:0:0" UpdaterThrottler="0:0:0.1" Background="Transparent" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.65*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Theme="{StaticResource Gathering.ListCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationResourceTypesGathered}" Theme="{StaticResource Gathering.CardTitle}" Margin="12,0,12,9" />
                                        <Grid Margin="12,0,12,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="65" /><ColumnDefinition Width="80" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationResourceType}" Theme="{StaticResource Gathering.TableHeader}" />
                                            <TextBlock Grid.Column="1" Text="{x:Static gathering:GatheringStats.TranslationAmount}" Theme="{StaticResource Gathering.TableHeader}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{x:Static gathering:GatheringStats.TranslationValue}" Theme="{StaticResource Gathering.TableHeader}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{x:Static gathering:GatheringStats.TranslationPercentOfTotal}" Theme="{StaticResource Gathering.TableHeader}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding GatheringBindings.GatheringStats.ResourceTypeSummaries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gathering:GatheringResourceTypeSummary">
                                                    <Border Theme="{StaticResource Gathering.DetailRow}" Padding="12,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="65" /><ColumnDefinition Width="80" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal"><Border Width="13" Height="13" Margin="0,0,7,0" Background="{Binding Brush, Converter={x:Static conv:CompatBrushConverter.Instance}}" CornerRadius="2" /><TextBlock Text="{Binding Name}" Theme="{StaticResource Gathering.TableText}" /></StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.TableValue}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.TableValue}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding SharePercentage, StringFormat='{}{0:N1}%'}" Theme="{StaticResource Gathering.TableValue}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Theme="{StaticResource Gathering.ListCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationTopGatheredResources}" Theme="{StaticResource Gathering.CardTitle}" Margin="12,0,12,9" />
                                        <ItemsControl ItemsSource="{Binding GatheringBindings.GatheringStats.TopGatheredResources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gathering:GatheringResourceSummary">
                                                    <Border Theme="{StaticResource Gathering.DetailRow}" Padding="8,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="65" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Rank}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
                                                            <Image Grid.Column="1" Source="{Binding Item?.Icon}" Width="32" Height="32" />
                                                            <StackPanel Grid.Column="2" Margin="6,0"><TextBlock Text="{Binding Item?.LocalizedName}" Theme="{StaticResource Gathering.TableText}" FontWeight="SemiBold" /><TextBlock Text="{Binding TopLocation}" FontSize="10" Foreground="{DynamicResource SolidColorBrush.Text.3}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                                            <TextBlock Grid.Column="3" Text="{Binding TotalAmount, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.TableValue}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding TotalValue, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.TableValue}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Theme="{StaticResource Gathering.ListCard}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static gathering:GatheringStats.TranslationRecentGatherings}" Theme="{StaticResource Gathering.CardTitle}" Margin="12,0,12,9" />
                                        <Grid Margin="12,0,12,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="112" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static gathering:GatheringStats.TranslationResource}" Theme="{StaticResource Gathering.TableHeader}" />
                                            <TextBlock Grid.Column="1" Text="{x:Static gathering:GatheringStats.TranslationTier}" Theme="{StaticResource Gathering.TableHeader}" />
                                            <TextBlock Grid.Column="2" Text="{x:Static gathering:GatheringStats.TranslationAmount}" Theme="{StaticResource Gathering.TableHeader}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{x:Static gathering:GatheringStats.TranslationValue}" Theme="{StaticResource Gathering.TableHeader}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{x:Static gathering:GatheringStats.TranslationMap}" Theme="{StaticResource Gathering.TableHeader}" />
                                            <TextBlock Grid.Column="6" Text="{Binding Translation.Time, FallbackValue=TIME}" Theme="{StaticResource Gathering.TableHeader}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding GatheringBindings.GatheringStats.RecentGatherings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gathering:Gathered">
                                                    <Border Theme="{StaticResource Gathering.DetailRow}" Padding="12,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="60" />
                                                                <ColumnDefinition Width="48" />
                                                                <ColumnDefinition Width="60" />
                                                                <ColumnDefinition Width="100" />
                                                                <ColumnDefinition Width="32" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="112" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image Source="{Binding Item?.Icon}" Width="28" Height="28" HorizontalAlignment="Left" ToolTip.Tip="{Binding Item?.LocalizedName}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Item?.TierLevelString}" Theme="{StaticResource Gathering.TableText}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding GainedTotalAmount, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.TableValue}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding TotalMarketValueWithCulture, StringFormat='{}{0:N0}'}" Theme="{StaticResource Gathering.TableValue}" />
                                                            <TextBlock Grid.Column="5" Text="{Binding ClusterUniqueName}" Theme="{StaticResource Gathering.TableText}" />
                                                            <TextBlock Grid.Column="6" Text="{Binding TimestampDateTimeLocal, StringFormat='{}{0:g}'}" Theme="{StaticResource Gathering.TableText}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding GatheringBindings.TranslationWood, FallbackValue=WOOD}"><ContentControl Theme="{StaticResource Gathering.ResourceTabContent}" Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource WoodTemplate}" /></TabItem>
                    <TabItem Header="{Binding GatheringBindings.TranslationFiber, FallbackValue=FIBER}"><ContentControl Theme="{StaticResource Gathering.ResourceTabContent}" Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource FiberTemplate}" /></TabItem>
                    <TabItem Header="{Binding GatheringBindings.TranslationOre, FallbackValue=ORE}"><ContentControl Theme="{StaticResource Gathering.ResourceTabContent}" Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource OreTemplate}" /></TabItem>
                    <TabItem Header="{Binding GatheringBindings.TranslationHide, FallbackValue=HIDE}"><ContentControl Theme="{StaticResource Gathering.ResourceTabContent}" Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource HideTemplate}" /></TabItem>
                    <TabItem Header="{Binding GatheringBindings.TranslationRock, FallbackValue=ROCK}"><ContentControl Theme="{StaticResource Gathering.ResourceTabContent}" Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource RockTemplate}" /></TabItem>
                    <TabItem Header="{Binding GatheringBindings.TranslationFishing, FallbackValue=FISHING}"><ContentControl Theme="{StaticResource Gathering.ResourceTabContent}" Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource FishingTemplate}" /></TabItem>
                </TabControl>
        </Grid>
    </Grid>
</UserControl>
