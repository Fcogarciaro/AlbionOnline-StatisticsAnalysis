<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StatisticsAnalysisTool.Views.LootComparatorSaveNameWindow"
        Title="Loot Comparator"
        Height="220"
        Width="520"
        WindowStartupLocation="CenterOwner"
        Theme="{StaticResource WindowChrome}"
        Background="{DynamicResource SolidColorBrush.Background.1}"
        FontSize="{DynamicResource BaseFontSize}"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False">
  <Grid>
    <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
    <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />

    <Grid x:Name="Hotbar" Height="33" VerticalAlignment="Top" Background="{DynamicResource SolidColorBrush.Background.3}"
          PointerPressed="Hotbar_PointerPressed">
      <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
      <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
      <Label x:Name="TitleLabel" Margin="10,0,61,0" Height="33" FontSize="16"
             Foreground="{DynamicResource SolidColorBrush.Text.1}" FontWeight="Bold" />
      <Button Theme="{StaticResource WindowButtonStyle}" Content="r" Margin="-2,0,0,0" Click="CancelButton_Click" />
    </Grid>

    <StackPanel Margin="20,52,20,62">
      <TextBlock x:Name="PromptTextBlock" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                 FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10" />
      <TextBox x:Name="SaveNameTextBox" Height="30" MaxLength="100"
               VerticalContentAlignment="Center" TextChanged="SaveNameTextBox_TextChanged" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
      <Button x:Name="SaveButton" MinWidth="180" Height="34" Margin="0,0,8,0"
              IsDefault="True" Click="SaveButton_Click" />
      <Button x:Name="CancelButton" MinWidth="180" Height="34" Margin="8,0,0,0"
              IsCancel="True" Click="CancelButton_Click" />
    </StackPanel>
  </Grid>
</Window>
