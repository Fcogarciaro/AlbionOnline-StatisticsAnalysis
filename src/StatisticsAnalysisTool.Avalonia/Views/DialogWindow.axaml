<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
        xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
        xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
        x:Class="StatisticsAnalysisTool.Views.DialogWindow"
        x:DataType="viewModels:DialogWindowViewModel"
        mc:Ignorable="d"
        Title="{Binding Title, FallbackValue=TITLE}" Height="200" Width="500" WindowStartupLocation="CenterScreen"
        Theme="{StaticResource WindowChrome}"
        Background="{DynamicResource SolidColorBrush.Background.1}" FontSize="{DynamicResource BaseFontSize}"
        Topmost="True" ShowInTaskbar="False" CanResize="False">
  <Grid>
    <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
    <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
    <Grid x:Name="Hotbar" ZIndex="1" Height="33" VerticalAlignment="Top" Background="{DynamicResource SolidColorBrush.Background.3}"
          PointerPressed="Hotbar_PointerPressed">
      <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
      <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
      <Grid Margin="10,3,0,0" Width="26" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left"
            IsVisible="{Binding YesNoVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
        <fa:FontAwesomeImage Icon="SolidTriangleExclamation" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
      </Grid>
      <Grid Margin="10,3,0,0" Width="26" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left"
            IsVisible="{Binding InfoTypeVisibility, FallbackValue=False, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
        <fa:FontAwesomeImage Icon="SolidCircleInfo" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
      </Grid>
      <Grid Margin="10,3,0,0" Width="26" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left"
            IsVisible="{Binding ErrorTypeVisibility, FallbackValue=False, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
        <fa:FontAwesomeImage Icon="SolidTriangleExclamation" Foreground="{DynamicResource SolidColorBrush.Accent.Red.3}" />
      </Grid>
      <Label Content="{Binding Title, FallbackValue=TITLE}" Margin="41,0,61,0" VerticalAlignment="Top" Height="33" FontSize="16"
             Foreground="{DynamicResource SolidColorBrush.Text.1}" FontWeight="Bold" />
      <Button x:Name="CloseButton" Theme="{StaticResource WindowButtonStyle}" Content="r" Margin="-2,0,0,0" Click="CloseButton_Click" />
    </Grid>
    <Grid Margin="10,38,10,54">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Message, FallbackValue=MESSAGE}" FontSize="20" TextAlignment="Center" HorizontalAlignment="Center"
                   TextWrapping="Wrap" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
        <!-- WPF Hyperlink: a clickable, underlined text that opens Url (http/https only). -->
        <TextBlock x:Name="UrlTextBlock" Margin="0,8,0,0" FontSize="18" TextAlignment="Center" HorizontalAlignment="Center"
                   TextWrapping="Wrap" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" TextDecorations="Underline" Cursor="Hand"
                   Text="{Binding UrlText}"
                   IsVisible="{Binding UrlVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}"
                   PointerPressed="UrlTextBlock_PointerPressed" />
      </StackPanel>
    </Grid>
    <Grid IsVisible="{Binding YesNoVisibility, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
      <Button Content="{Binding Translation.Yes, FallbackValue=YES}" FontSize="18" FontWeight="Bold" Height="34" Width="200" VerticalAlignment="Bottom"
              Margin="10,0,0,10" HorizontalAlignment="Left" Theme="{StaticResource Style.Button.Attention}" Click="BtnOk_Click" />
      <Button Content="{Binding Translation.No, FallbackValue=NO}" FontSize="18" FontWeight="Bold" Height="34" Width="200" VerticalAlignment="Bottom"
              Margin="0,0,10,10" HorizontalAlignment="Right" Click="BtnCancel_Click" />
    </Grid>
    <Grid IsVisible="{Binding InfoTypeVisibility, FallbackValue=False, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
      <Button Content="{Binding OkButtonText, FallbackValue=Okay}"
              FontSize="18" FontWeight="Bold" Height="34" Width="200" VerticalAlignment="Bottom" Margin="0,0,10,10" HorizontalAlignment="Center" Click="BtnOk_Click" />
    </Grid>
    <Grid IsVisible="{Binding ErrorTypeVisibility, FallbackValue=False, Converter={x:Static conv:VisibilityToBoolConverter.Instance}}">
      <Button Content="{Binding OkButtonText, FallbackValue=OK}" Theme="{StaticResource Style.Button.Attention}"
              FontSize="18" FontWeight="Bold" Height="34" Width="200" VerticalAlignment="Bottom" Margin="0,0,10,10" HorizontalAlignment="Center" Click="BtnOk_Click" />
    </Grid>
  </Grid>
</Window>
