<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
        xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
        x:Class="StatisticsAnalysisTool.Views.UpdateWindow"
        x:DataType="viewModels:UpdateWindowViewModel"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue=Software Update}"
        Width="740"
        Height="620"
        MinWidth="740"
        Theme="{StaticResource WindowChrome}"
        Background="{DynamicResource SolidColorBrush.Background.1}"
        FontSize="{DynamicResource BaseFontSize}"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource SolidColorBrush.Background.1}" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" BorderThickness="1">
    <Grid RowDefinitions="33,*,Auto">

      <Grid x:Name="Hotbar" Grid.Row="0" Background="{DynamicResource SolidColorBrush.Background.3}" PointerPressed="Hotbar_PointerPressed">
        <Grid Margin="10,3,0,0" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top">
          <fa:FontAwesomeImage Icon="SolidDownload" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
        </Grid>
        <Label Margin="41,0,61,0" Height="33" VerticalAlignment="Top" Content="{Binding WindowTitle, FallbackValue=Software Update}"
               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
        <Button x:Name="CloseButton" Margin="-2,0,0,0" Click="CloseButton_Click" Content="r"
                IsEnabled="{Binding AreButtonsEnabled}" Theme="{StaticResource WindowButtonStyle}" />
      </Grid>

      <Grid Grid.Row="1" Margin="16,16,16,10" RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="{Binding Headline, FallbackValue=A new version is available.}"
                   FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource SolidColorBrush.Text.1}" TextWrapping="Wrap" />

        <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{Binding Message, FallbackValue=There is a new version available.}"
                   FontSize="16" Foreground="{DynamicResource SolidColorBrush.Text.2}" TextWrapping="Wrap" />

        <Border Grid.Row="2" Margin="0,18,0,0" Padding="16" Background="{DynamicResource SolidColorBrush.Background.3}"
                BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding ReleaseTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SolidColorBrush.Text.1}"
                         TextWrapping="Wrap" />
              <TextBlock Margin="0,6,0,0" Text="{Binding VersionText}" FontSize="16"
                         Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
            </StackPanel>

            <TextBlock Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top" Text="{Binding ReleaseDateText}" FontSize="15"
                       Foreground="{DynamicResource SolidColorBrush.Text.4}" />
          </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,18,0,0" Padding="0" Background="{DynamicResource SolidColorBrush.Background.3}"
                BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="1"
                IsVisible="{Binding HasPatchNotes}">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource SolidColorBrush.Background.4}">
              <TextBlock Text="Patch Notes" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SolidColorBrush.Text.1}" />
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl Margin="16,14,16,16" ItemsSource="{Binding ReleaseNoteGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="viewModels:UpdateReleaseNoteGroupViewModel">
                    <Border Margin="0,0,0,14" Padding="14" Background="{DynamicResource SolidColorBrush.Background.2}"
                            BorderBrush="{DynamicResource SolidColorBrush.Background.4}" BorderThickness="1">
                      <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SolidColorBrush.Text.1}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding VersionText}" FontSize="15"
                                       Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" />
                          </StackPanel>

                          <TextBlock Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top" Text="{Binding ReleaseDateText}"
                                     FontSize="14" Foreground="{DynamicResource SolidColorBrush.Text.4}"
                                     IsVisible="{Binding HasReleaseDateText}" />
                        </Grid>

                        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Sections}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:UpdateNoteSectionViewModel">
                              <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" Foreground="{Binding TitleBrush, Converter={x:Static conv:CompatBrushConverter.Instance}}"
                                           IsVisible="{Binding HasTitle}" />
                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Items}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                      <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource SolidColorBrush.Text.2}" TextWrapping="Wrap">
                                        <Run Text="- " />
                                        <Run Text="{Binding Path=., Mode=OneWay}" />
                                      </TextBlock>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="2" Margin="16,0,16,16" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="{DynamicResource SolidColorBrush.Text.4}" Text="{Binding StatusText}"
                   IsVisible="{Binding IsStatusVisible}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
          <ProgressBar Grid.Column="0" Height="6" Margin="0,0,20,0" Minimum="0" Maximum="100"
                       IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding DownloadProgressPercentage}"
                       IsVisible="{Binding IsBusy}" />
          <Button Grid.Column="1" Width="150" Height="36" Margin="0,0,10,0" Click="RemindLater_Click"
                  Content="{Binding PostponeButtonText, FallbackValue=REMIND__LATER}" IsEnabled="{Binding AreButtonsEnabled}" />
          <Button Grid.Column="2" Width="170" Height="36" Click="DownloadInstall_Click" Content="{Binding ActionButtonText, FallbackValue=DOWNLOAD__INSTALL}"
                  IsEnabled="{Binding AreButtonsEnabled}" Theme="{StaticResource Style.Button.Attention}" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
