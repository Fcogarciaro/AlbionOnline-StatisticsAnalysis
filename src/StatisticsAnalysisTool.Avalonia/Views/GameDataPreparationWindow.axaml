<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
        xmlns:conv="clr-namespace:StatisticsAnalysisTool.Common.Converters"
        xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
        xmlns:userControls="clr-namespace:StatisticsAnalysisTool.UserControls"
        x:Class="StatisticsAnalysisTool.Views.GameDataPreparationWindow"
        x:DataType="viewModels:GameDataPreparationWindowViewModel"
        mc:Ignorable="d"
        Title="{Binding Title, FallbackValue=TITLE}" Height="580" Width="950" WindowStartupLocation="CenterScreen"
        Theme="{StaticResource WindowChrome}"
        Background="{DynamicResource SolidColorBrush.Background.1}" FontSize="{DynamicResource BaseFontSize}"
        ShowInTaskbar="True" CanResize="False">
  <Grid>
    <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
    <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
    <Grid x:Name="Hotbar" ZIndex="1" Height="33" VerticalAlignment="Top" Background="{DynamicResource SolidColorBrush.Background.3}" PointerPressed="Hotbar_PointerPressed">
      <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
      <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False" />
      <Grid Margin="10,3,0,0" Width="26" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left">
        <fa:FontAwesomeImage Icon="SolidTriangleExclamation" Foreground="{DynamicResource SolidColorBrush.Accent.Blue.3}" />
      </Grid>
      <Label Content="{Binding Title, FallbackValue=TITLE}" Margin="41,0,61,0" VerticalAlignment="Top" Height="33" FontSize="16"
             Foreground="{DynamicResource SolidColorBrush.Text.1}" FontWeight="Bold" />
      <Button x:Name="CloseButton" Theme="{StaticResource WindowButtonStyle}" Content="r" Margin="-2,2,2,0" Click="CloseButton_Click" />
    </Grid>
    <StackPanel Orientation="Vertical" Margin="0,33,0,0" HorizontalAlignment="Center">
      <TextBlock Text="{Binding Message, FallbackValue='MESSAGE'}" FontSize="20" TextAlignment="Center" HorizontalAlignment="Center"
                 TextWrapping="Wrap" Foreground="{DynamicResource SolidColorBrush.Text.1}" Height="60" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <StackPanel Orientation="Vertical" Margin="10">
          <Label Theme="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding TranslationStandaloneLauncher, FallbackValue='STANDALONE__LAUNCHER'}"
                 Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" FontSize="18" Height="24" />
          <Image Source="avares://StatisticsAnalysisTool/Assets/preparation_folder.png" Height="140" Width="331" Margin="0" VerticalAlignment="Top" />
          <TextBlock Text="{Binding TranslationStandaloneLauncherMessage, FallbackValue='STANDALONE__LAUNCHER__MESSAGE'}" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center"
                     TextWrapping="Wrap" Foreground="{DynamicResource SolidColorBrush.Text.1}" Height="60" Width="325" />
        </StackPanel>
        <Border Background="{DynamicResource SolidColorBrush.Accent.Blue.3}" VerticalAlignment="Stretch" Width="2" Margin="10" />
        <StackPanel Orientation="Vertical" Margin="10">
          <Label Theme="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding TranslationSteamLauncher, FallbackValue='STEAM__LAUNCHER'}"
                 Foreground="{DynamicResource SolidColorBrush.Accent.Blue.2}" FontSize="18" Height="24" />
          <Image Source="avares://StatisticsAnalysisTool/Assets/preparation_folder_steam.png" Height="140" Width="381" Margin="0" VerticalAlignment="Top" />
          <TextBlock Text="{Binding TranslationSteamLauncherMessage, FallbackValue='STEAM__LAUNCHER__MESSAGE'}" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center"
                     TextWrapping="Wrap" Foreground="{DynamicResource SolidColorBrush.Text.1}" Height="60" Width="325" />
        </StackPanel>
      </StackPanel>

      <!-- Linux addition: installations found in the usual Steam and Wine locations (GameFolderLocator). Hidden when none. -->
      <StackPanel x:Name="DetectedPanel" IsVisible="False" Margin="0,0,0,6" HorizontalAlignment="Center">
        <TextBlock x:Name="DetectedLabel" FontSize="12" TextAlignment="Center" Foreground="{DynamicResource SolidColorBrush.Text.1}" Margin="0,0,0,4" />
        <ItemsControl x:Name="DetectedFolders" HorizontalAlignment="Center" />
      </StackPanel>

      <TextBlock Text="{Binding ErrorMessage, FallbackValue='ERROR_MESSAGE'}" FontSize="20" TextAlignment="Center" HorizontalAlignment="Center"
                 TextWrapping="Wrap" Foreground="{DynamicResource SolidColorBrush.Accent.Red.2}" Height="60" />
      <Button Content="{Binding TranslationSelectMainGameFolder, FallbackValue='SELECT_ALBION_ONLINE_MAIN_GAME_FOLDER...', StringFormat='{} {0} '}"
              FontSize="18" FontWeight="Bold" Height="34" Width="NaN" VerticalAlignment="Bottom" Margin="0,5,10,10" HorizontalAlignment="Center" Click="BtnSelectMainGameFolder_Click" />
      <Button x:Name="ConfirmButton" Content="{Binding TranslationConfirm, FallbackValue=CONFIRM}" IsEnabled="{Binding IsConfirmButtonEnabled, FallbackValue=false}"
              FontSize="18" FontWeight="Bold" Height="34" Width="200" VerticalAlignment="Bottom" Margin="0,0,10,10" HorizontalAlignment="Center" Click="BtnConfirm_Click" />
    </StackPanel>
  </Grid>
</Window>
